@model JayamaliOptical.Web.Models.ServiceBooking
@{
    ViewData["Title"] = "Booking Confirmation";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-lg border-success">
                <div class="card-body text-center p-5">
                    @* Email Status Message *@
                    @if (TempData["EmailSent"] as string == "true")
                    {
                        <div class="alert alert-success">
                            <i class="bi bi-check-circle me-2"></i>
                            <strong>Email Sent!</strong> A confirmation email has been sent to @Model.Email
                        </div>
                    }
                    else if (TempData["EmailSent"] as string == "false")
                    {
                        <div class="alert alert-danger">
                            <i class="bi bi-exclamation-triangle me-2"></i>
                            <strong>Email Failed:</strong> @TempData["EmailError"]
                        </div>
                    }
                    <div class="mb-4">
                        <i class="bi bi-check-circle-fill text-success" style="font-size: 5rem;"></i>
                    </div>

                    <h2 class="mb-3">Appointment Booked Successfully!</h2>
                    <p class="lead mb-4">Your appointment has been scheduled.</p>

                    <div class="alert alert-light mb-4">
                        <h5 class="mb-3">Booking Details</h5>
                        <div class="row text-start">
                            <div class="col-md-6 mb-2">
                                <strong>Booking Reference:</strong><br />
                                <span class="text-primary fw-bold">@Model.BookingNumber</span>
                            </div>
                            <div class="col-md-6 mb-2">
                                <strong>Booking Date:</strong><br />
                                <span>@Model.BookingDate.ToString("dd MMM yyyy, hh:mm tt")</span>
                            </div>
                            <div class="col-md-6 mb-2">
                                <strong>Service:</strong><br />
                                <span>@Model.Service?.Name</span>
                            </div>
                            <div class="col-md-6 mb-2">
                                <strong>Status:</strong><br />
                                <span class="badge bg-warning">@Model.Status</span>
                            </div>
                            <div class="col-md-6 mb-2">
                                <strong>Appointment Date:</strong><br />
                                <span class="text-success fw-bold">@Model.AppointmentDate.ToString("dd MMM yyyy")</span>
                            </div>
                            <div class="col-md-6 mb-2">
                                <strong>Appointment Time:</strong><br />
                                <span class="text-success fw-bold">@Model.AppointmentTime.ToString("hh\\:mm")</span>
                            </div>
                        </div>
                    </div>

                    <div class="card mb-4">
                        <div class="card-header">
                            <h6 class="mb-0">Customer Information</h6>
                        </div>
                        <div class="card-body text-start">
                            <div class="row">
                                <div class="col-md-6">
                                    <p class="mb-1"><strong>Name:</strong></p>
                                    <p>@Model.FirstName @Model.LastName</p>
                                </div>
                                <div class="col-md-6">
                                    <p class="mb-1"><strong>Email:</strong></p>
                                    <p>@Model.Email</p>
                                </div>
                                <div class="col-md-6">
                                    <p class="mb-1"><strong>Phone:</strong></p>
                                    <p>@Model.PhoneNumber</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="alert alert-warning">
                        <h6><i class="bi bi-exclamation-triangle me-2"></i>Important</h6>
                        <p class="mb-0">Please arrive 15 minutes before your appointment time. If you need to cancel or reschedule, please contact us at least 24 hours in advance.</p>
                    </div>

                    <div class="d-grid gap-2 d-md-flex justify-content-md-center">
                        <a href="/Home/Index#services" class="btn btn-primary btn-lg">
                            <i class="bi bi-calendar-check me-2"></i>Back to Services
                        </a>
                        <a href="/Home/Index" class="btn btn-outline-secondary btn-lg">
                            <i class="bi bi-house-door me-2"></i>Back to Home
                        </a>
                    </div>

                    <p class="text-muted mt-4 mb-0">
                        <small>A confirmation email has been sent to @Model.Email</small>
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>