@model JayamaliOptical.Web.Models.CheckoutViewModel
@{
    ViewData["Title"] = "Checkout";
}

<div class="container py-5">
    <h2 class="mb-4"><i class="bi bi-credit-card me-2"></i>Checkout</h2>

    <form asp-action="Index" method="post">
        <div class="row">
            <!-- Customer Information -->
            <div class="col-lg-8">
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0"><i class="bi bi-person me-2"></i>Customer Information</h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="FirstName" class="form-label">First Name <span class="text-danger">*</span></label>
                                <input asp-for="FirstName" class="form-control" placeholder="Enter first name" />
                                <span asp-validation-for="FirstName" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="LastName" class="form-label">Last Name <span class="text-danger">*</span></label>
                                <input asp-for="LastName" class="form-control" placeholder="Enter last name" />
                                <span asp-validation-for="LastName" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label">Email Address <span class="text-danger">*</span></label>
                            <input asp-for="Email" class="form-control" placeholder="your.email@example.com" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="PhoneNumber" class="form-label">Phone Number <span class="text-danger">*</span></label>
                            <input asp-for="PhoneNumber" class="form-control" placeholder="+94 XX XXX XXXX" />
                            <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <!-- Billing Address -->
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0"><i class="bi bi-geo-alt me-2"></i>Billing Address</h5>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label asp-for="Address" class="form-label">Street Address <span class="text-danger">*</span></label>
                            <textarea asp-for="Address" class="form-control" rows="2" placeholder="House no, Street name"></textarea>
                            <span asp-validation-for="Address" class="text-danger"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="City" class="form-label">City <span class="text-danger">*</span></label>
                                <input asp-for="City" class="form-control" placeholder="Enter city" />
                                <span asp-validation-for="City" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="PostalCode" class="form-label">Postal Code <span class="text-danger">*</span></label>
                                <input asp-for="PostalCode" class="form-control" placeholder="Enter postal code" />
                                <span asp-validation-for="PostalCode" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="OrderNotes" class="form-label">Order Notes (Optional)</label>
                            <textarea asp-for="OrderNotes" class="form-control" rows="3" placeholder="Any special instructions..."></textarea>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Order Summary -->
            <div class="col-lg-4">
                <div class="card shadow-sm sticky-top" style="top: 20px;">
                    <div class="card-header bg-success text-white">
                        <h5 class="mb-0"><i class="bi bi-cart-check me-2"></i>Order Summary</h5>
                    </div>
                    <div class="card-body">
                        <h6 class="card-subtitle mb-3 text-muted">
                            @Model.Cart.TotalItems item(s)
                        </h6>

                        <div class="order-items mb-3" style="max-height: 300px; overflow-y: auto;">
                            @foreach (var item in Model.Cart.Items)
                            {
                                <div class="d-flex justify-content-between align-items-center mb-2 pb-2 border-bottom">
                                    <div>
                                        <small class="fw-bold">@item.ProductName</small><br />
                                        <small class="text-muted">Qty: @item.Quantity</small>
                                    </div>
                                    <small class="fw-bold">Rs. @((item.Price * item.Quantity).ToString("0.00"))</small>
                                </div>
                            }
                        </div>

                        <hr />

                        <div class="d-flex justify-content-between mb-2">
                            <span>Subtotal:</span>
                            <strong>Rs. @Model.Cart.TotalPrice.ToString("0.00")</strong>
                        </div>

                        <div class="d-flex justify-content-between mb-3">
                            <span>Delivery:</span>
                            <strong class="text-success">FREE</strong>
                        </div>

                        <hr />

                        <div class="d-flex justify-content-between mb-4">
                            <h5>Total:</h5>
                            <h5 class="text-primary">Rs. @(Model.TotalAmount.ToString("0.00"))</h5>
                        </div>

                        <button type="submit" class="btn btn-success btn-lg w-100 mb-2">
                            <i class="bi bi-lock me-2"></i>Place Order
                        </button>

                        <a asp-controller="Cart" asp-action="Index" class="btn btn-outline-secondary w-100">
                            <i class="bi bi-arrow-left me-2"></i>Back to Cart
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}