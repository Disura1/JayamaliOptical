@model JayamaliOptical.Web.Models.CheckoutViewModel
@{
    ViewData["Title"] = "Checkout";
}

@* Debug: Check if user is logged in *@
@if (User?.Identity?.IsAuthenticated == true)
{
    <script>
        console.log("User is logged in: @User.Identity.Name");
        // Auto-show form for logged-in users
        document.addEventListener('DOMContentLoaded', function() {
            var checkoutForm = document.getElementById('checkoutForm');
            if (checkoutForm) {
                checkoutForm.style.display = 'flex';
                console.log("Form shown for logged-in user");
            }
        });
    </script>
}

<div class="container py-5">
    <h2 class="mb-4"><i class="bi bi-credit-card me-2"></i>Checkout</h2>

    @* Validation Summary *@
    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger">
            <h5><i class="bi bi-exclamation-triangle me-2"></i>Please fix the following errors:</h5>
            <ul class="mb-0">
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <li>@error.ErrorMessage</li>
                }
            </ul>
        </div>
    }

    @* Checkout Mode Selection - Only show for guests *@
    @if (!User.Identity.IsAuthenticated)
    {
        <div class="row mb-4" id="checkoutModeSelection">
            <div class="col-12">
                <div class="card border-primary">
                    <div class="card-body text-center">
                        <h5 class="card-title"><i class="bi bi-person-check me-2"></i>Choose How to Checkout</h5>
                        <p class="card-text text-muted">You can complete your order as a guest or login for a faster experience.</p>

                        <div class="d-flex flex-wrap justify-content-center gap-3">
                            <!-- Guest Checkout Button -->
                            <button type="button" class="btn btn-outline-primary btn-lg" onclick="showGuestForm()">
                                <i class="bi bi-person me-2"></i>Continue as Guest
                            </button>

                            <!-- Login Button -->
                            <a asp-area="Identity" asp-page="/Account/Login" asp-route-returnUrl="/Checkout" class="btn btn-primary btn-lg">
                                <i class="bi bi-box-arrow-in-right me-2"></i>Login for Faster Checkout
                            </a>
                        </div>

                        <div class="mt-3 text-start" style="max-width: 500px; margin: 0 auto;">
                            <h6 class="text-primary">Benefits of logging in:</h6>
                            <ul class="small text-muted mb-0">
                                <li>✓ Track your order status easily</li>
                                <li>✓ Save prescriptions for future orders</li>
                                <li>✓ Faster checkout next time</li>
                                <li>✓ View order and booking history</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    @* Main Checkout Form - Hidden for guests until they choose *@
    <div class="row" id="checkoutForm" style="@(User?.Identity?.IsAuthenticated == true ? "" : "display: none;")">
        <form asp-action="Index" method="post" enctype="multipart/form-data">
            <!-- Customer Information -->
            <div class="col-lg-8">
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0"><i class="bi bi-person me-2"></i>Customer Information</h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="FirstName" class="form-label">First Name <span class="text-danger">*</span></label>
                                <input asp-for="FirstName" class="form-control" placeholder="Enter first name" />
                                <span asp-validation-for="FirstName" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="LastName" class="form-label">Last Name <span class="text-danger">*</span></label>
                                <input asp-for="LastName" class="form-control" placeholder="Enter last name" />
                                <span asp-validation-for="LastName" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label">Email Address <span class="text-danger">*</span></label>
                            <input asp-for="Email" class="form-control" placeholder="your.email@example.com" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="PhoneNumber" class="form-label">Phone Number <span class="text-danger">*</span></label>
                            <input asp-for="PhoneNumber" class="form-control" placeholder="+94 XX XXX XXXX" />
                            <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                @* Prescription Section - Show only if cart requires prescription *@
                @if (Model.CartRequiresPrescription)
                {
                    <div class="card shadow-sm mb-4 border-warning">
                        <div class="card-header bg-warning text-dark">
                            <h5 class="mb-0"><i class="bi bi-file-earmark-medical me-2"></i>Prescription Required</h5>
                        </div>
                        <div class="card-body">
                            <p class="mb-3">Your order contains products that require a valid prescription. Please select one of the options below:</p>

                            @* Option 1: Select Saved Prescription *@
                            <div class="mb-4">
                                <label class="form-label fw-bold">Option 1: Select Saved Prescription</label>
                                @if (Model.UserPrescriptions != null && Model.UserPrescriptions.Count > 0)
                                {
                                    <select asp-for="SelectedPrescriptionId" class="form-control">
                                        <option value="">-- Select a Prescription --</option>
                                        @foreach (var rx in Model.UserPrescriptions)
                                        {
                                            <option value="@rx.Id" selected="@(rx.IsDefault)">
                                                @rx.Name @(rx.IsDefault ? "(Default)" : "") - @rx.CreatedDate.ToString("dd MMM yyyy")
                                            </option>
                                        }
                                    </select>
                                    <small class="text-muted">
                                        <a asp-controller="Prescriptions" asp-action="Index" target="_blank">Manage your prescriptions</a>
                                    </small>
                                }
                                else if (User.Identity?.IsAuthenticated == true)
                                {
                                    <div class="alert alert-info">
                                        <i class="bi bi-info-circle me-2"></i>
                                        You don't have any saved prescriptions yet.
                                        <a asp-controller="Prescriptions" asp-action="Create" target="_blank">Add one now</a> or use Option 2 below.
                                    </div>
                                }
                                else
                                {
                                    <div class="alert alert-info">
                                        <i class="bi bi-info-circle me-2"></i>
                                        <a asp-area="Identity" asp-page="/Account/Login" asp-route-returnUrl="/Checkout">Login</a> to select saved prescriptions, or use Option 2 below.
                                    </div>
                                }
                            </div>

                            <div class="text-center my-3">
                                <span class="text-muted">— OR —</span>
                            </div>

                            @* Option 2: Upload Prescription *@
                            <div class="mb-3">
                                <label asp-for="UploadPrescriptionFile" class="form-label fw-bold">Option 2: Upload Prescription Now</label>
                                <input asp-for="UploadPrescriptionFile" class="form-control" accept="image/*,.pdf" />
                                <small class="text-muted">Upload a clear photo or PDF of your prescription (JPG, PNG, PDF)</small>
                                <span asp-validation-for="UploadPrescriptionFile" class="text-danger"></span>
                            </div>

                            <div class="alert alert-warning mb-0">
                                <i class="bi bi-exclamation-triangle me-2"></i>
                                <strong>Note:</strong> Orders with prescription products will be processed after we verify your prescription. You'll receive a confirmation email once verified.
                            </div>
                        </div>
                    </div>
                }

                <!-- Billing Address -->
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0"><i class="bi bi-geo-alt me-2"></i>Billing Address</h5>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label asp-for="Address" class="form-label">Street Address <span class="text-danger">*</span></label>
                            <textarea asp-for="Address" class="form-control" rows="2" placeholder="House no, Street name"></textarea>
                            <span asp-validation-for="Address" class="text-danger"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="City" class="form-label">City <span class="text-danger">*</span></label>
                                <input asp-for="City" class="form-control" placeholder="Enter city" />
                                <span asp-validation-for="City" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="PostalCode" class="form-label">Postal Code <span class="text-danger">*</span></label>
                                <input asp-for="PostalCode" class="form-control" placeholder="Enter postal code" />
                                <span asp-validation-for="PostalCode" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="OrderNotes" class="form-label">Order Notes (Optional)</label>
                            <textarea asp-for="OrderNotes" class="form-control" rows="3" placeholder="Any special instructions..."></textarea>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Order Summary -->
            <div class="col-lg-4">
                <div class="card shadow-sm sticky-top" style="top: 20px;">
                    <div class="card-header bg-success text-white">
                        <h5 class="mb-0"><i class="bi bi-cart-check me-2"></i>Order Summary</h5>
                    </div>
                    <div class="card-body">
                        <h6 class="card-subtitle mb-3 text-muted">
                            @Model.Cart.TotalItems item(s)
                        </h6>

                        <div class="order-items mb-3" style="max-height: 300px; overflow-y: auto;">
                            @foreach (var item in Model.Cart.Items)
                            {
                                <div class="d-flex justify-content-between align-items-center mb-2 pb-2 border-bottom">
                                    <div>
                                        <small class="fw-bold">@item.ProductName</small><br />
                                        <small class="text-muted">Qty: @item.Quantity</small>
                                    </div>
                                    <small class="fw-bold">Rs. @((item.Price * item.Quantity).ToString("0.00"))</small>
                                </div>
                            }
                        </div>

                        <hr />

                        <div class="d-flex justify-content-between mb-2">
                            <span>Subtotal:</span>
                            <strong>Rs. @Model.Cart.TotalPrice.ToString("0.00")</strong>
                        </div>

                        <div class="d-flex justify-content-between mb-3">
                            <span>Delivery:</span>
                            <strong class="text-success">FREE</strong>
                        </div>

                        <hr />

                        <div class="d-flex justify-content-between mb-4">
                            <h5>Total:</h5>
                            <h5 class="text-primary">Rs. @(Model.TotalAmount.ToString("0.00"))</h5>
                        </div>

                        <button type="submit" class="btn btn-success btn-lg w-100 mb-2">
                            <i class="bi bi-lock me-2"></i>Place Order
                        </button>

                        <a asp-controller="Cart" asp-action="Index" class="btn btn-outline-secondary w-100">
                            <i class="bi bi-arrow-left me-2"></i>Back to Cart
                        </a>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    @if (User?.Identity?.IsAuthenticated != true)
    {
        <script>
            function showGuestForm() {
                var modeCard = document.getElementById('checkoutModeSelection');
                if (modeCard) modeCard.style.display = 'none';

                var checkoutForm = document.getElementById('checkoutForm');
                if (checkoutForm) checkoutForm.style.display = 'flex';
            }

            // Show form if there are validation errors
            @if (!ViewData.ModelState.IsValid)
            {
                    <text>
                    document.addEventListener('DOMContentLoaded', function() {
                        showGuestForm();
                    });
                    </text>
            }
        </script>
    }
    else
    {
        <script>
            // Auto-show form for logged-in users
            document.addEventListener('DOMContentLoaded', function() {
                var checkoutForm = document.getElementById('checkoutForm');
                if (checkoutForm) {
                    checkoutForm.style.display = 'flex';
                    console.log("Form auto-shown for logged-in user");
                }
            });
        </script>
    }

    @if (Model.CartRequiresPrescription)
    {
        <script>
            document.querySelector('form').addEventListener('submit', function(e) {
                var selectedPrescription = document.querySelector('[name="SelectedPrescriptionId"]').value;
                var uploadedFile = document.querySelector('[name="UploadPrescriptionFile"]').value;

                // Check if either option is selected
                if (!selectedPrescription && !uploadedFile) {
                    e.preventDefault();
                    alert('⚠️ Prescription Required: Please select a saved prescription OR upload a new one before placing your order.');
                    return false;
                }
            });
        </script>
    }
}