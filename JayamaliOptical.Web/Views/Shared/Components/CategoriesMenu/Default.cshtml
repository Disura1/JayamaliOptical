@model IEnumerable<JayamaliOptical.Web.Models.Category>

@if (Model != null && Model.Any())
{
    @foreach (var category in Model)
    {
        <li>
            <a class="dropdown-item category-nav-link"
               asp-controller="Products"
               asp-action="Index"
               asp-route-categoryId="@category.Id">
                <i class="fas fa-@(category.Name == "Spectacle" ? "glasses" : category.Name == "Sunglasses" ? "sunglasses" : category.Name == "Contact Lens" ? "eye" : "lens") me-2 text-primary"></i>
                @category.Name
            </a>
        </li>
    }
    <li><hr class="dropdown-divider"></li>
    <li>
        <a class="dropdown-item" asp-controller="Products" asp-action="Index">
            <i class="fas fa-th-list me-2"></i>All Products
        </a>
    </li>
}
else
{
    <li><span class="dropdown-item text-muted">No categories available</span></li>
}