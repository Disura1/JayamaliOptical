<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Jayamali Optical</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;700&display=swap">
    <style>
        body {
            min-height: 100vh;
            background: linear-gradient(135deg, #e8f0fb 0%, #f0fff4 50%, #eef4ff 100%);
            display: flex;
            flex-direction: column;
        }

        .auth-wrapper {
            flex: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 24px 16px;
            min-height: 100vh;
        }

        .auth-card {
            width: 100%;
            max-width: 440px;
            background: white;
            border-radius: 24px;
            box-shadow: 0 20px 60px rgba(25,120,188,0.12);
            overflow: hidden;
        }

        .auth-header {
            background: linear-gradient(135deg, #1978bc 0%, #26a4e0 100%);
            padding: 32px 40px 28px;
            text-align: center;
            color: white;
            position: relative;
        }

            .auth-header::after {
                content: '';
                position: absolute;
                bottom: -1px;
                left: 0;
                right: 0;
                height: 24px;
                background: white;
                border-radius: 24px 24px 0 0;
            }

        .auth-logo {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            margin-bottom: 16px;
        }

            .auth-logo img {
                height: 44px;
                filter: brightness(0) invert(1);
            }

        .auth-logo-name {
            font-size: 1.2rem;
            font-weight: 800;
            color: white;
            letter-spacing: 0.5px;
        }

        .auth-tagline {
            font-size: 0.82rem;
            opacity: 0.85;
            margin: 0;
        }

        .auth-body {
            padding: 32px 36px 36px;
        }

        .auth-title {
            font-size: 1.4rem;
            font-weight: 800;
            color: #111;
            margin-bottom: 6px;
        }

        .auth-subtitle {
            font-size: 0.85rem;
            color: #888;
            margin-bottom: 28px;
        }

        .auth-body .form-control {
            border-radius: 10px;
            border: 1.5px solid #e2e8f0;
            font-size: 0.93rem;
            transition: border-color 0.2s, box-shadow 0.2s;
        }

            .auth-body .form-control:focus {
                border-color: #1978bc;
                box-shadow: 0 0 0 3px rgba(25,120,188,0.12);
            }

        .auth-body .form-floating label {
            font-size: 0.88rem;
            color: #888;
        }

        .btn-auth {
            background: linear-gradient(135deg, #1978bc, #26a4e0);
            border: none;
            border-radius: 50px;
            color: white;
            font-weight: 700;
            font-size: 1rem;
            padding: 13px;
            transition: opacity 0.2s, transform 0.2s;
        }

            .btn-auth:hover {
                opacity: 0.9;
                transform: translateY(-2px);
                color: white;
            }

        .auth-divider {
            display: flex;
            align-items: center;
            gap: 12px;
            margin: 20px 0;
            color: #bbb;
            font-size: 0.8rem;
        }

            .auth-divider::before,
            .auth-divider::after {
                content: '';
                flex: 1;
                height: 1px;
                background: #e8eef5;
            }

        .auth-footer {
            text-align: center;
            margin-top: 20px;
            font-size: 0.88rem;
            color: #666;
        }

            .auth-footer a {
                color: #1978bc;
                font-weight: 700;
                text-decoration: none;
            }

                .auth-footer a:hover {
                    text-decoration: underline;
                }

        .auth-back {
            text-align: center;
            margin-top: 20px;
        }

            .auth-back a {
                color: #888;
                font-size: 0.82rem;
                text-decoration: none;
                display: inline-flex;
                align-items: center;
                gap: 4px;
                transition: color 0.2s;
            }

                .auth-back a:hover {
                    color: #1978bc;
                }

        /* Trust badges */
        .auth-trust {
            display: flex;
            justify-content: center;
            gap: 20px;
            margin-top: 24px;
            padding-top: 20px;
            border-top: 1px solid #f1f5f9;
        }

        .trust-item {
            display: flex;
            align-items: center;
            gap: 5px;
            font-size: 0.72rem;
            color: #aaa;
        }

            .trust-item i {
                color: #6ea700;
            }
    </style>
</head>
<body>

    <div class="auth-wrapper">
        <div class="auth-card">

            @* Header *@
            <div class="auth-header">
                <div class="auth-logo">
                    <img src="~/images/LogoOnly.png" alt="Logo"
                         onerror="this.style.display='none'" />
                    <span class="auth-logo-name">Jayamali Optical</span>
                </div>
                <p class="auth-tagline">
                    <i class="bi bi-eye me-1"></i>Your Vision, Our Priority
                </p>
            </div>

            @* Body *@
            <div class="auth-body">
                @RenderBody()

                @* Trust badges *@
                <div class="auth-trust">
                    <div class="trust-item">
                        <i class="bi bi-shield-check"></i>
                        <span>Secure Login</span>
                    </div>
                    <div class="trust-item">
                        <i class="bi bi-lock"></i>
                        <span>Data Protected</span>
                    </div>
                    <div class="trust-item">
                        <i class="bi bi-patch-check"></i>
                        <span>Trusted Since 2016</span>
                    </div>
                </div>
            </div>

            @* Back to home *@
            <div class="auth-back pb-4">
                <a href="/">
                    <i class="bi bi-arrow-left"></i> Back to Home
                </a>
            </div>

        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>