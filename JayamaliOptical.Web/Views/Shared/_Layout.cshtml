<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Jayamali Optical</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/JayamaliOptical.Web.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;700&display=swap">
</head>
<body>
    @using JayamaliOptical.Web.Data
    @using JayamaliOptical.Web.Models
    @using Microsoft.EntityFrameworkCore
    @inject ApplicationDbContext _layoutDb
    @{
        var _siteSettings = await _layoutDb.SiteSettings
        .FirstOrDefaultAsync<SiteSettings>()
        ?? new SiteSettings();
    }
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom shadow-lg mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <img src="~/images/LogoOnly.png" alt="Jayamali Optical Logo" style="height:60px;">
                    <img src="~/images/Name.png" alt="Jayamali Optical" style="height:55px;">
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    @{
                        var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
                        var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";

                        bool isHome = currentController == "Home" && currentAction == "Index";
                        bool isProducts = currentController == "Products";
                        bool isServices = currentController == "Home" && currentAction == "Index"; // services on homepage
                        bool isContact = currentController == "Home" && currentAction == "ContactUs";
                        bool isAbout = currentController == "Home" && currentAction == "AboutUs";
                        bool isPrivacy = currentController == "Home" && currentAction == "Privacy";
                    }

                    <ul class="navbar-nav flex-grow-1 justify-content-center">
                        <li class="nav-item">
                            <a class="nav-link @(isHome ? "nav-active" : "")"
                               asp-area="" asp-controller="Home" asp-action="Index">
                                Home
                            </a>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle @(isProducts ? "nav-active" : "")"
                               href="#" id="productsDropdown" role="button"
                               data-bs-toggle="dropdown" aria-expanded="false">
                                Products
                            </a>
                            <ul class="dropdown-menu" aria-labelledby="productsDropdown">
                                @await Component.InvokeAsync("CategoriesMenu")
                            </ul>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle"
                               href="#" id="navbarDropdown" role="button"
                               data-bs-toggle="dropdown" aria-expanded="false">
                                Services
                            </a>
                            <ul class="dropdown-menu" aria-labelledby="navbarDropdown">
                                @await Component.InvokeAsync("ServicesMenu")
                            </ul>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(isContact ? "nav-active" : "")"
                               asp-area="" asp-controller="Home" asp-action="ContactUs">
                                Contact Us
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(isAbout ? "nav-active" : "")"
                               asp-area="" asp-controller="Home" asp-action="AboutUs">
                                About Us
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(isPrivacy ? "nav-active" : "")"
                               asp-area="" asp-controller="Home" asp-action="Privacy">
                                Privacy
                            </a>
                        </li>
                    </ul>
                    <form class="secSearch d-flex" action="/Products/Index" method="get">
                        <input class="form-control me-2" type="search" name="search"
                               placeholder="Search products..." aria-label="Search"
                               value="@(Context.Request.Query["search"].ToString())" />
                        <button class="btn btn-outline-success" type="submit">
                            <i class="bi bi-search"></i>
                        </button>
                    </form>
                    @await Component.InvokeAsync("Cart")

                    <!-- Profile Icon -->
                    @using Microsoft.AspNetCore.Identity
                    @using JayamaliOptical.Web.Services
                    @inject SignInManager<IdentityUser> SignInManager
                    @inject UserManager<IdentityUser> UserManager
                    @inject ICartService CartService

                    @if (SignInManager.IsSignedIn(User))
                    {
                        // Check if user is Admin
                        var isAdmin = User.IsInRole("Admin");

                        <div class="profile-icon-wrapper">
                            <div class="dropdown">
                                <a href="#" class="profile-icon-link dropdown-toggle" id="profileDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="bi bi-person-circle" viewBox="0 0 16 16">
                                        <path d="M11 6a3 3 0 1 1-6 0 3 3 0 0 1 6 0z" />
                                        <path fill-rule="evenodd" d="M0 8a8 8 0 1 1 16 0A8 8 0 0 1 0 8zm8-7a7 7 0 0 0-5.468 11.37C3.242 11.226 4.805 10 8 10s4.757 1.225 5.468 2.37A7 7 0 0 0 8 1z" />
                                    </svg>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="profileDropdown">
                                    <li><h6 class="dropdown-header">Hello, @User.Identity?.Name!</h6></li>
                                    <li><hr class="dropdown-divider"></li>

                                    @* Admin Panel Link (Only for Admins) *@
                                    @if (isAdmin)
                                    {
                                        <li>
                                            <a class="dropdown-item text-danger fw-bold" asp-area="Admin" asp-controller="Home" asp-action="Index">
                                                <i class="bi bi-shield-lock me-2"></i>Admin Panel
                                            </a>
                                        </li>
                                        <li><hr class="dropdown-divider"></li>
                                    }

                                    @* Regular User Links *@
                                    <li>
                                        <a class="dropdown-item" asp-area="Identity" asp-page="/Account/Manage/Index">
                                            <i class="bi bi-gear me-2"></i>My Account
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Dashboard" asp-action="Index">
                                            <i class="bi bi-speedometer2 me-2"></i>Dashboard
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <form class="dropdown-item" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="/" method="post">
                                            <button type="submit" class="btn btn-link w-100 p-0 gap-1 text-white text-decoration-none bg-danger ">
                                                <i class="bi bi-box-arrow-right me-2"></i>Logout
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    }
                    else
                    {
                        @* Not Logged In: Show Login/Register Options *@
                        <div class="profile-icon-wrapper">
                            <div class="dropdown">
                                <a href="#" class="profile-icon-link dropdown-toggle" id="profileDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="bi bi-person-circle" viewBox="0 0 16 16">
                                        <path d="M11 6a3 3 0 1 1-6 0 3 3 0 0 1 6 0z" />
                                        <path fill-rule="evenodd" d="M0 8a8 8 0 1 1 16 0A8 8 0 0 1 0 8zm8-7a7 7 0 0 0-5.468 11.37C3.242 11.226 4.805 10 8 10s4.757 1.225 5.468 2.37A7 7 0 0 0 8 1z" />
                                    </svg>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="profileDropdown">
                                    <li><h6 class="dropdown-header">Welcome!</h6></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <a class="dropdown-item" href="/Identity/Account/Login">
                                            <i class="bi bi-box-arrow-in-right me-2"></i>Login
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" href="/Identity/Account/Register">
                                            <i class="bi bi-person-plus me-2"></i>Register
                                        </a>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </nav>
    </header>
    
    <div class="container-fluid">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted position-relative">
        <div class="mainFooter text-light d-flex">
            <div class="ftDivOne w-75">
                <div class=" d-flex justify-content-around h-25 border-bottom shadow-lg">
                    <ul class="list-unstyled">
                        <li><a class="text-light text-decoration-none" asp-controller="Home" asp-action="Privacy">PRIVACY POLICY</a></li>
                    </ul>
                    <div class="d-flex gap-4">
                        <p class="fw-bolder text-light fs-5">Get In TOUCH</p>
                        <a class="ftLink fs-4" href="@_siteSettings.FacebookUrl" target="_blank"><i class="bi bi-facebook"></i></a>
                        <a class="ftLink fs-4" href="@_siteSettings.WhatsAppUrl" target="_blank"><i class="bi bi-whatsapp"></i></a>
                        <a class="ftLink fs-4" href="@_siteSettings.TikTokUrl" target="_blank"><i class="bi bi-tiktok"></i></a>
                        <a class="ftLink fs-4" href="@_siteSettings.InstagramUrl" target="_blank"><i class="bi bi-instagram"></i></a>
                    </div>
                </div>
                <div class="d-flex justify-content-around h-75 mt-3">
                    <div class="d-flex flex-column align-items-center pt-3">
                        <h5>ADDRESS</h5>
                        <div class="lh-1">
                            <p>@_siteSettings.Address</p>
                        </div>
                    </div>
                    <div class="d-flex flex-column align-items-center pt-3">
                        <h5>TELEPHONE</h5>
                        <a class="ftLink lh-1 text-decoration-none" href="tel:@_siteSettings.Phone1.Replace(" ", "")">@_siteSettings.Phone1</a>
                        @if (!string.IsNullOrEmpty(_siteSettings.Phone2))
                        {
                            <a class="ftLink lh-1 text-decoration-none my-2" href="tel:@_siteSettings.Phone2.Replace(" ", "")">@_siteSettings.Phone2</a>
                        }
                        @if (!string.IsNullOrEmpty(_siteSettings.Phone3))
                        {
                            <a class="ftLink lh-1 text-decoration-none" href="tel:@_siteSettings.Phone3.Replace(" ", "")">@_siteSettings.Phone3</a>
                        }
                    </div>
                    <div class="d-flex flex-column align-items-center lh-1 pt-3">
                        <h5>EMAIL</h5>
                        <a class="ftLink text-decoration-none" href="mailto:@_siteSettings.Email">@_siteSettings.Email</a>
                    </div>
                </div>
            </div>
            <div class="w-25">
                <div class="d-flex flex-column align-items-center">
                    <div class="ratio ratio-16x9">
                        <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3950.7281669882877!2d79.83554597436441!3d8.026939291999712!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3afd160d002fb4fb%3A0x1b0eeb335a99a11!2sJayamali%20Optical!5e0!3m2!1sen!2slk!4v1773153008953!5m2!1sen!2slk" width="600" height="450" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
                    </div>
                </div>
            </div>
        </div>
        <div class="bg-dark d-flex justify-content-around align-items-center text-white lh-sm" style="height: 30px; font-size: 0.8rem;">
            <span>All copyrights reserved by Jayamali Optical - © 2026</span>
            <span>Website Designed & Developed by <a href="https://www.linkedin.com/in/disura-sandaruwan-649a422b8/" target="_blank" class="text-white fw-bold text-decoration-none">Disura Sandaruwan</a></span>
        </div>
    </footer>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Handle category navigation links
            const categoryNavLinks = document.querySelectorAll('.category-nav-link');

            categoryNavLinks.forEach(function(link) {
                link.addEventListener('click', function(e) {
                    // Let the link work normally (navigate to filtered products page)
                    // No need to preventDefault - just let it navigate
                    console.log('Category clicked:', this.textContent);

                    // Close dropdown after click
                    const dropdown = this.closest('.dropdown');
                    if (dropdown) {
                        const bsDropdown = new bootstrap.Dropdown(dropdown.querySelector('.dropdown-toggle'));
                        bsDropdown.hide();
                    }
                });
            });

            // Handle "All Products" link - ensure it clears any category filter
            const allProductsLink = document.querySelector('.dropdown-item[href*="/Products/Index"]');
            if (allProductsLink) {
                allProductsLink.addEventListener('click', function() {
                    console.log('All Products clicked');
                    // Close dropdown
                    const dropdown = this.closest('.dropdown');
                    if (dropdown) {
                        const bsDropdown = new bootstrap.Dropdown(dropdown.querySelector('.dropdown-toggle'));
                        bsDropdown.hide();
                    }
                });
            }


            // Handle service navigation links
            const serviceNavLinks = document.querySelectorAll('.service-nav-link');

            serviceNavLinks.forEach(function(link) {
                link.addEventListener('click', function(e) {
                    e.preventDefault();

                    const serviceId = this.getAttribute('data-service-id');
                    const serviceName = this.getAttribute('data-service-name');

                    console.log('Navigation service clicked:', serviceId, serviceName);

                    // Check if we're already on the homepage
                    if (window.location.pathname === '/' || window.location.pathname === '/Home' || window.location.pathname === '/Home/Index') {
                        // We're on homepage - scroll to services section and trigger button
                        const servicesSection = document.getElementById('services');
                        if (servicesSection) {
                            servicesSection.scrollIntoView({ behavior: 'smooth' });

                            // Wait for scroll then click the service button
                            setTimeout(function() {
                                const serviceButton = document.querySelector(`.service-btn[data-service-id="${serviceId}"]`);
                                if (serviceButton) {
                                    serviceButton.click();
                                }
                            }, 500);
                        } else {
                            // Services section not found - redirect to homepage with hash
                            window.location.href = '/Home/Index#services';
                        }
                    } else {
                        // We're on a different page - redirect to homepage with service ID
                        window.location.href = '/Home/Index#services';

                        // Store service ID in sessionStorage to trigger after page load
                        sessionStorage.setItem('scrollToService', serviceId);
                    }

                    // Close dropdown
                    const dropdown = this.closest('.dropdown');
                    if (dropdown) {
                        const bsDropdown = new bootstrap.Dropdown(dropdown.querySelector('.dropdown-toggle'));
                        bsDropdown.hide();
                    }
                });
            });

            // Check if we need to auto-trigger a service on page load
            const storedServiceId = sessionStorage.getItem('scrollToService');
            if (storedServiceId) {
                sessionStorage.removeItem('scrollToService');

                // Wait for page to fully load
                setTimeout(function() {
                    const servicesSection = document.getElementById('services');
                    if (servicesSection) {
                        servicesSection.scrollIntoView({ behavior: 'smooth' });

                        setTimeout(function() {
                            const serviceButton = document.querySelector(`.service-btn[data-service-id="${storedServiceId}"]`);
                            if (serviceButton) {
                                serviceButton.click();
                            }
                        }, 500);
                    }
                }, 1000);
            }
        });

        // Fix relative URLs in Identity pages
        document.addEventListener('click', function(e) {
            var link = e.target.closest('a[href]');
            if (link && link.href.startsWith(window.location.origin + '/Identity/')) {
                // Check if it's a navigation link (not an Identity link)
                if (link.href.includes('/Cart') || link.href.includes('/Dashboard') ||
                    link.href.includes('/Products') || link.href.includes('/Services') ||
                    link.href.includes('/Home')) {
                    // Remove /Identity prefix
                    var newHref = link.href.replace('/Identity', '');
                    if (e.ctrlKey || e.metaKey) {
                        window.open(newHref, '_blank');
                    } else {
                        window.location.href = newHref;
                    }
                    e.preventDefault();
                }
            }
        });
    </script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

    <!-- Shared Product Modal -->
    <div class="modal fade" id="sharedProductModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg" style="border-radius:16px;overflow:hidden;">
                <div class="modal-header border-0 pb-0 px-4 pt-4">
                    <h5 class="modal-title fw-bold">Product Details</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-0" id="sharedModalContent">
                    <div class="text-center py-5">
                        <div class="spinner-border text-primary"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        function openProductModal(productId) {
            var modal = new bootstrap.Modal(document.getElementById('sharedProductModal'));
            var content = document.getElementById('sharedModalContent');
            content.innerHTML = '<div class="text-center py-5"><div class="spinner-border text-primary"></div></div>';
            modal.show();

            fetch('/Products/GetProductDetails?id=' + productId)
                .then(function(r) { return r.json(); })
                .then(function(p) {
                    var priceHtml = p.price
                        ? '<h3 class="fw-bold mb-3" style="color:#1978bc;">Rs. ' + parseFloat(p.price).toFixed(2) + '</h3>'
                        : '<p class="text-muted fst-italic mb-3">Price on request</p>';

                    var typeBadge = p.productType
                        ? '<span class="badge ' + (p.productType==='Mens'?'bg-primary':p.productType==='Ladies'?'bg-danger':'bg-info') + ' mb-2">' + p.productType + '</span><br/>'
                        : '';

                    var rxBadge = p.requiresPrescription
                        ? '<div class="alert alert-warning d-flex align-items-center mb-3 mx-0"><i class="bi bi-file-earmark-medical me-2 fs-5"></i><div><strong>Prescription Required</strong><br/><small>A valid prescription is needed for purchase.</small></div></div>'
                        : '';

                    var specs = '';
                    if (p.frameType) specs += '<p class="mb-1"><strong>Frame Type:</strong> ' + p.frameType + '</p>';
                    if (p.lensPower)  specs += '<p class="mb-1"><strong>Lens Power:</strong> ' + p.lensPower + '</p>';
                    if (p.iolType)    specs += '<p class="mb-1"><strong>IOL Type:</strong> ' + p.iolType + '</p>';

                    // Build image carousel
                    var images = [];
                    if (p.imageUrl1) images.push(p.imageUrl1);
                    if (p.imageUrl2) images.push(p.imageUrl2);

                    var imageHtml = '';
                    if (images.length === 0) {
                        imageHtml = '<div class="d-flex align-items-center justify-content-center bg-light" style="height:320px;"><i class="bi bi-eyeglasses" style="font-size:4rem;color:#ccc;"></i></div>';
                    } else if (images.length === 1) {
                        imageHtml = '<img src="' + images[0] + '" class="img-fluid w-100" style="height:320px;object-fit:contain;background:#f8f9fa;padding:16px;" alt="' + p.name + '" />';
                    } else {
                        // Two images — Bootstrap carousel
                        imageHtml =
                            '<div id="productImgCarousel" class="carousel slide" data-bs-ride="false">' +
                                '<div class="carousel-inner">' +
                                    '<div class="carousel-item active">' +
                                        '<img src="' + images[0] + '" class="d-block w-100" style="height:320px;object-fit:contain;background:#f8f9fa;padding:16px;" alt="Image 1"/>' +
                                    '</div>' +
                                    '<div class="carousel-item">' +
                                        '<img src="' + images[1] + '" class="d-block w-100" style="height:320px;object-fit:contain;background:#f8f9fa;padding:16px;" alt="Image 2"/>' +
                                    '</div>' +
                                '</div>' +
                                '<button class="carousel-control-prev" type="button" data-bs-target="#productImgCarousel" data-bs-slide="prev" style="width:36px;">' +
                                    '<span class="carousel-control-prev-icon" style="filter:invert(1) brightness(0.3);"></span>' +
                                '</button>' +
                                '<button class="carousel-control-next" type="button" data-bs-target="#productImgCarousel" data-bs-slide="next" style="width:36px;">' +
                                    '<span class="carousel-control-next-icon" style="filter:invert(1) brightness(0.3);"></span>' +
                                '</button>' +
                                '<div class="carousel-indicators" style="bottom:-28px;">' +
                                    '<button type="button" data-bs-target="#productImgCarousel" data-bs-slide-to="0" class="active" style="background:#1978bc;width:8px;height:8px;border-radius:50%;border:none;"></button>' +
                                    '<button type="button" data-bs-target="#productImgCarousel" data-bs-slide-to="1" style="background:#ccc;width:8px;height:8px;border-radius:50%;border:none;"></button>' +
                                '</div>' +
                            '</div>';
                    }

                    var stockHtml = p.stockQuantity !== null
                        ? '<p class="mb-2"><strong>Stock:</strong> ' + (p.stockQuantity > 0 ? p.stockQuantity + ' available' : '<span class="text-danger">Out of stock</span>') + '</p>'
                        : '';

                    content.innerHTML =
                        '<div class="row g-0">' +
                            '<div class="col-md-5" style="background:#f8f9fa; min-height:320px;">' +
                                imageHtml +
                            '</div>' +
                            '<div class="col-md-7 p-4" style="overflow-y:auto; max-height:480px;">' +
                                typeBadge +
                                '<h4 class="fw-bold mb-1">' + p.name + '</h4>' +
                                '<p class="text-muted mb-2" style="font-size:0.85rem;">' + (p.category || '') + '</p>' +
                                priceHtml +
                                rxBadge +
                                '<p class="mb-3 text-secondary" style="font-size:0.93rem;">' + (p.description || '') + '</p>' +
                                (p.brand ? '<p class="mb-1"><strong>Brand:</strong> ' + p.brand + '</p>' : '') +
                                stockHtml +
                                (specs ? '<hr/><h6 class="fw-bold mb-2">Specifications</h6>' + specs : '') +
                                '<div class="mt-3">' +
                                    '<form action="/Cart/AddToCart" method="post">' +
                                        '<input type="hidden" name="productId" value="' + p.id + '" />' +
                                        '<input type="hidden" name="quantity" value="1" />' +
                                        '<button type="submit" class="btn btn-primary w-100 rounded-pill">' +
                                            '<i class="bi bi-cart-plus me-2"></i>Add to Cart' +
                                        '</button>' +
                                    '</form>' +
                                '</div>' +
                            '</div>' +
                        '</div>';
                })
                .catch(function() {
                    content.innerHTML = '<div class="alert alert-danger m-3">Error loading product. Please try again.</div>';
                });
        }
    </script>

    <!-- Scroll to Top Button -->
    <button id="scrollTopBtn" onclick="scrollToTop()" title="Back to top">
        <i class="bi bi-arrow-up"></i>
    </button>

    <script>
        // Scroll to top button
        var scrollTopBtn = document.getElementById('scrollTopBtn');

        window.addEventListener('scroll', function () {
            if (window.scrollY > 300) {
                scrollTopBtn.classList.add('visible');
            } else {
                scrollTopBtn.classList.remove('visible');
            }
        });

        function scrollToTop() {
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }
    </script>
</body>
</html>
