<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Jayamali Optical</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/JayamaliOptical.Web.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom shadow-lg mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <img src="~/images/LogoOnly.png" alt="Jayamali Optical Logo" style="height:60px;">
                    <img src="~/images/Name.png" alt="Jayamali Optical" style="height:55px;">
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1 justify-content-center">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" id="navbarDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Products
                            </a>
                            <ul class="dropdown-menu" aria-labelledby="navbarDropdown">
                                <li><a class="dropdown-item" href="#">Spectacles</a></li>
                                <li><a class="dropdown-item" href="#">Sunglasses</a></li>
                                <li><a class="dropdown-item" href="#">Contact Lenses</a></li>
                                <li><a class="dropdown-item" href="#">Intraocular Lenses (IOL)</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item" asp-area="" asp-controller="Products" asp-action="Index">All Products</a></li>
                            </ul>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" id="navbarDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Services
                            </a>
                            <ul class="dropdown-menu" aria-labelledby="navbarDropdown">
                                <li><a class="dropdown-item" href="#">Eye Channeling</a></li>
                                <li><a class="dropdown-item" href="#">HVF Testing</a></li>
                                <li><a class="dropdown-item" href="#">OCT Testing</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item" asp-area="" asp-controller="Services" asp-action="Index">All Services</a></li>
                            </ul>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="ContactUs">Contact Us</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="AboutUs">About Us</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                        </li>
                    </ul>
                    <form class="secSearch d-flex">
                        <input class="form-control me-2" type="search" placeholder="Search" aria-label="Search">
                        <button class="btn btn-outline-success" type="submit">Search</button>
                    </form>
                    <a class="profile-icon text-dark px-4" asp-controller="Shop" asp-action="Index">
                        <i class="bi bi-person-circle fs-3"></i>
                    </a>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="mainFooter text-light d-flex">
            <div class="ftDivOne w-75">
                <div class=" d-flex justify-content-around h-25 border-bottom shadow-lg">
                    <ul class="list-unstyled">
                        <li><a class="text-light text-decoration-none" asp-controller="Home" asp-action="Privacy">PRIVACY POLICY</a></li>
                    </ul>
                    <div class="d-flex gap-4">
                        <p class="fw-bolder text-light fs-5">Get In TOUCH</p>
                        <a class="ftLink fs-4" href="https://www.facebook.com/share/14X82QupZAM/?mibextid=wwXIfr" target="_blank"><i class="bi bi-facebook"></i></a>
                        <a class="ftLink fs-4" href="https://wa.me/94776537611" target="_blank"><i class="bi bi-whatsapp"></i></a>
                        <a class="ftLink fs-4" href="#" target="_blank"><i class="bi bi-tiktok"></i></a>
                        <a class="ftLink fs-4" href="#" target="_blank"><i class="bi bi-instagram"></i></a>
                    </div>
                </div>
                <div class="d-flex justify-content-around h-75 mt-3">
                    <div class="d-flex flex-column align-items-center pt-3">
                        <h5>ADDRESS</h5>
                        <div class="lh-1">
                            <p>No: 116, Kurunagala Road, Puttalam, Sri Lanka</p>
                        </div>
                    </div>
                    <div class="d-flex flex-column align-items-center pt-3">
                        <h5>TELEPHONE</h5>
                        <a class="ftLink lh-1 text-decoration-none" href="tel:+94776537611">077 653 7611</a>
                        <a class="ftLink lh-1 text-decoration-none my-2" href="tel:+94767303410">076 7303410</a>
                        <a class="ftLink lh-1 text-decoration-none" href="tel:+94322266965">032 226 6965</a>
                    </div>
                    <div class="d-flex flex-column align-items-center lh-1 pt-3">
                        <h5>EMAIL</h5>
                        <a class="ftLink text-decoration-none" href="mailto:jayamalioptical@gmail.com?subject=Inquiry from Website">jayamalioptical@gmail.com</a>
                    </div>
                </div>
            </div>
            <div class="w-25">
                <div class="d-flex flex-column align-items-center">
                    <div class="ratio ratio-16x9">
                        <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3950.7281669882877!2d79.83554597436441!3d8.026939291999712!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3afd160d002fb4fb%3A0x1b0eeb335a99a11!2sJayamali%20Optical!5e0!3m2!1sen!2slk!4v1773153008953!5m2!1sen!2slk" width="600" height="450" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
                    </div>
                </div>
            </div>
        </div>
        <div class="bg-dark d-flex justify-content-around align-items-center text-white lh-sm" style="height: 30px; font-size: 0.8rem;">
            <span>All copyrights reserved by Jayamali Optical - © 2026</span>
            <span>Website Designed & Developed by <a href="https://www.linkedin.com/in/disura-sandaruwan-649a422b8/" target="_blank" class="text-white fw-bold text-decoration-none">Disura Sandaruwan</a></span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
