@model JayamaliOptical.Web.Models.ServiceBooking
@using JayamaliOptical.Web.Services
@{
    ViewData["Title"] = "Booking Details";
}

<div class="container py-5">
    <div class="row">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-header bg-success text-white d-flex justify-content-between align-items-center">
                    <h4 class="mb-0"><i class="bi bi-calendar-check me-2"></i>Booking Details</h4>
                    <a asp-action="Index" class="btn btn-light btn-sm">
                        <i class="bi bi-arrow-left me-1"></i>Back to Dashboard
                    </a>
                </div>
                <div class="card-body">
                    <!-- Booking Information -->
                    <div class="row mb-4">
                        <div class="col-md-6">
                            <h5 class="text-primary mb-3">Booking Information</h5>
                            <table class="table table-sm table-borderless">
                                <tr>
                                    <td width="150"><strong>Booking Reference:</strong></td>
                                    <td>@Model.BookingNumber</td>
                                </tr>
                                <tr>
                                    <td><strong>Booking Date:</strong></td>
                                    <td>@Model.BookingDate.ToString("dd MMM yyyy, hh:mm tt")</td>
                                </tr>
                                <tr>
                                    <td><strong>Status:</strong></td>
                                    <td>
                                        @{
                                            var badgeClass = Model.Status switch
                                            {
                                                        "Pending" => "bg-warning",
                                                        "Confirmed" => "bg-info",
                                                        "Completed" => "bg-success",
                                                        "Cancelled" => "bg-danger",
                                                _ => "bg-secondary"
                                            };
                                        }
                                        <span class="badge @badgeClass">@Model.Status</span>
                                    </td>
                                </tr>
                            </table>
                        </div>

                        <!-- Customer Information -->
                        <div class="col-md-6">
                            <h5 class="text-primary mb-3">Customer Information</h5>
                            <table class="table table-sm table-borderless">
                                <tr>
                                    <td width="150"><strong>Name:</strong></td>
                                    <td>@Model.FirstName @Model.LastName</td>
                                </tr>
                                <tr>
                                    <td><strong>Email:</strong></td>
                                    <td>@Model.Email</td>
                                </tr>
                                <tr>
                                    <td><strong>Phone:</strong></td>
                                    <td>@Model.PhoneNumber</td>
                                </tr>
                            </table>
                        </div>
                    </div>

                    <hr />

                    <!-- Appointment Details -->
                    <h5 class="text-primary mb-3">Appointment Details</h5>
                    <div class="row">
                        <div class="col-md-4">
                            <div class="card bg-light">
                                <div class="card-body text-center">
                                    <i class="bi bi-calendar-event text-primary" style="font-size: 3rem;"></i>
                                    <h6 class="mt-2 mb-1">Date</h6>
                                    <p class="mb-0 fw-bold">@Model.AppointmentDate.ToString("dd MMMM yyyy")</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="card bg-light">
                                <div class="card-body text-center">
                                    <i class="bi bi-clock text-info" style="font-size: 3rem;"></i>
                                    <h6 class="mt-2 mb-1">Time</h6>
                                    @{
                                        var timeSpan = new TimeSpan(Model.AppointmentTime.Hours, Model.AppointmentTime.Minutes, 0);
                                        var dateTime = TimeHelper.Today.Add(timeSpan);
                                        var formattedTime = dateTime.ToString("hh:mm tt");
                                    }
                                    <p class="mb-0 fw-bold">@formattedTime</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="card bg-light">
                                <div class="card-body text-center">
                                    <i class="bi bi-eye text-success" style="font-size: 3rem;"></i>
                                    <h6 class="mt-2 mb-1">Service</h6>
                                    <p class="mb-0 fw-bold">@Model.Service?.Name</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.Notes))
                    {
                        <div class="alert alert-info mt-4">
                            <strong>Your Notes:</strong>
                            <p class="mb-0">@Model.Notes</p>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(Model.AdminNotes))
                    {
                        <div class="alert alert-warning mt-3">
                            <strong>Admin Notes:</strong>
                            <p class="mb-0">@Model.AdminNotes</p>
                        </div>
                    }

                    <!-- Important Information -->
                    <div class="alert alert-info mt-4">
                        <h6><i class="bi bi-exclamation-circle me-2"></i>Important Information</h6>
                        <ul class="mb-0">
                            <li>Please arrive 15 minutes before your appointment time</li>
                            <li>Bring your prescription and any relevant medical records</li>
                            <li>Contact us if you need to reschedule (at least 24 hours notice)</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>