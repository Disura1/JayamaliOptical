@model JayamaliOptical.Web.Models.Prescription
@{
    ViewData["Title"] = "Prescription Details";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                    <h4 class="mb-0"><i class="bi bi-file-earmark-medical me-2"></i>@Model.Name</h4>
                    <a asp-action="Index" class="btn btn-light btn-sm">
                        <i class="bi bi-arrow-left me-1"></i>Back
                    </a>
                </div>
                <div class="card-body">
                    @if (Model.IsDefault)
                    {
                        <span class="badge bg-warning mb-3"><i class="bi bi-star-fill me-1"></i>Default Prescription</span>
                    }

                    @if (!string.IsNullOrEmpty(Model.Description))
                    {
                        <p class="text-muted">@Model.Description</p>
                    }

                    <div class="row">
                        <div class="col-md-6">
                            <h5 class="text-primary mb-3"><i class="bi bi-eye me-2"></i>Right Eye (OD)</h5>
                            <table class="table table-sm table-bordered">
                                <tr><td>Sphere (SPH)</td><td>@Model.RightEyeSphere</td></tr>
                                <tr><td>Cylinder (CYL)</td><td>@Model.RightEyeCylinder</td></tr>
                                <tr><td>Axis</td><td>@Model.RightEyeAxis</td></tr>
                                <tr><td>Add</td><td>@Model.RightEyeAdd</td></tr>
                            </table>
                        </div>
                        <div class="col-md-6">
                            <h5 class="text-primary mb-3"><i class="bi bi-eye me-2"></i>Left Eye (OS)</h5>
                            <table class="table table-sm table-bordered">
                                <tr><td>Sphere (SPH)</td><td>@Model.LeftEyeSphere</td></tr>
                                <tr><td>Cylinder (CYL)</td><td>@Model.LeftEyeCylinder</td></tr>
                                <tr><td>Axis</td><td>@Model.LeftEyeAxis</td></tr>
                                <tr><td>Add</td><td>@Model.LeftEyeAdd</td></tr>
                            </table>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.PupillaryDistance))
                    {
                        <div class="alert alert-info">
                            <strong><i class="bi bi-rulers me-2"></i>Pupillary Distance (PD):</strong> @Model.PupillaryDistance
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(Model.FilePath))
                    {
                        <div class="mt-4">
                            <h5 class="mb-3">Prescription Image</h5>
                            <img src="@Model.FilePath" alt="Prescription" class="img-fluid border rounded" style="max-height: 400px;" />
                        </div>
                    }

                    <div class="mt-4 d-flex gap-2">
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
                            <i class="bi bi-pencil me-2"></i>Edit
                        </a>
                        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">
                            <i class="bi bi-trash me-2"></i>Delete
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>