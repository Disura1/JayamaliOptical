@using JayamaliOptical.Web.Models
@{
    var products = ViewBag.FeaturedProducts as List<Product> ?? new List<Product>();
    if (!products.Any()) return;

    // Split into rows of 4 for the 2-row slider
    // Each "slide" = 1 row of up to 4 products
    int perRow = 4;
    var rows = new List<List<Product>>();
    for (int i = 0; i < products.Count; i += perRow)
        rows.Add(products.Skip(i).Take(perRow).ToList());

    // Group rows into slides of 2 rows each
    int rowsPerSlide = 2;
    var slides = new List<List<List<Product>>>();
    for (int i = 0; i < rows.Count; i += rowsPerSlide)
        slides.Add(rows.Skip(i).Take(rowsPerSlide).ToList());
}

<section class="featured-section" id="featured-products">
    <div class="container">

        <div class="featured-header">
            <p class="featured-eyebrow">Handpicked For You</p>
            <h2 class="featured-title">Featured Products</h2>
            <div class="featured-divider"></div>
            <p class="text-muted">Our most popular optical products, selected by our experts</p>
        </div>

        @* Slider *@
        <div id="featuredSlider" class="carousel slide" data-bs-ride="false">

            <div class="carousel-inner">
                @for (int s = 0; s < slides.Count; s++)
                {
                    <div class="carousel-item @(s == 0 ? "active" : "")">
                        @foreach (var row in slides[s])
                        {
                            <div class="featured-grid mb-4">
                                @foreach (var p in row)
                                {
                                    <div class="fp-card" onclick="openProductModal(@p.Id)" title="View @p.Name">

                                        <div class="fp-star-badge">
                                            <i class="bi bi-star-fill"></i> Featured
                                        </div>
                                        @if (p.RequiresPrescription)
                                        {
                                            <div class="fp-rx-badge">
                                                <i class="bi bi-file-earmark-medical me-1"></i>Rx
                                            </div>
                                        }

                                        <div class="fp-img-wrap">
                                            @if (!string.IsNullOrEmpty(p.ImageUrl1))
                                            {
                                                <img src="@p.ImageUrl1" alt="@p.Name" loading="lazy" />
                                            }
                                            else
                                            {
                                                <div class="fp-no-img">
                                                    <i class="bi bi-eyeglasses"></i>
                                                </div>
                                            }
                                            <div class="fp-overlay">
                                                <button class="fp-overlay-btn">
                                                    <i class="bi bi-eye me-1"></i>Quick View
                                                </button>
                                            </div>
                                        </div>

                                        <div class="fp-body">
                                            @if (p.Category != null)
                                            {
                                                <div class="fp-category">@p.Category.Name</div>
                                            }
                                            <div class="fp-name">@p.Name</div>
                                            @if (!string.IsNullOrEmpty(p.Brand))
                                            {
                                                <div class="fp-brand"><i class="bi bi-tag me-1"></i>@p.Brand</div>
                                            }
                                            <div class="fp-desc">@p.Description</div>
                                            <div class="fp-footer">
                                                @if (p.Price.HasValue)
                                                {
                                                    <span class="fp-price">Rs. @p.Price.Value.ToString("0.00")</span>
                                                }
                                                else
                                                {
                                                    <span class="fp-price-na">Price on request</span>
                                                }
                                                <form action="/Cart/AddToCart" method="post"
                                                      onclick="event.stopPropagation()">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="productId" value="@p.Id" />
                                                    <input type="hidden" name="quantity" value="1" />
                                                    <button type="submit" class="fp-cart-btn">
                                                        <i class="bi bi-cart-plus"></i>Add
                                                    </button>
                                                </form>
                                            </div>
                                        </div>

                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
            </div>

            @* Only show controls if more than 1 slide *@
            @if (slides.Count > 1)
            {
                @* Prev / Next arrows *@
                <button class="carousel-control-prev featured-nav-btn" type="button"
                        data-bs-target="#featuredSlider" data-bs-slide="prev">
                    <span class="featured-nav-icon"><i class="bi bi-chevron-left"></i></span>
                </button>
                <button class="carousel-control-next featured-nav-btn" type="button"
                        data-bs-target="#featuredSlider" data-bs-slide="next">
                    <span class="featured-nav-icon"><i class="bi bi-chevron-right"></i></span>
                </button>

                @* Dot indicators *@
                <div class="featured-dots">
                    @for (int d = 0; d < slides.Count; d++)
                    {
                        <button type="button"
                                data-bs-target="#featuredSlider"
                                data-bs-slide-to="@d"
                                class="featured-dot @(d == 0 ? "active" : "")"
                                aria-label="Slide @(d + 1)"></button>
                    }
                </div>
            }

        </div>

        <div class="featured-cta">
            <a href="/Products/Index" class="btn btn-outline-primary btn-lg rounded-pill px-5">
                <i class="bi bi-grid me-2"></i>View All Products
            </a>
        </div>

    </div>
</section>

@* Shared Product Modal — used by both Featured and Products page *@
<div class="modal fade" id="sharedProductModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius:16px; overflow:hidden;">
            <div class="modal-header border-0 pb-0 px-4 pt-4">
                <h5 class="modal-title fw-bold" id="sharedModalTitle">Product Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-0" id="sharedModalContent">
                <div class="text-center py-5">
                    <div class="spinner-border text-primary"></div>
                </div>
            </div>
        </div>
    </div>
</div>