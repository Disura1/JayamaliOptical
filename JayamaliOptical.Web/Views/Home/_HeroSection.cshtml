@using JayamaliOptical.Web.Models
@{
    var slides = ViewBag.OfferSlides as List<OfferSlide> ?? new List<OfferSlide>();
    // Fallback to static images if no DB slides exist yet
    bool useStatic = !slides.Any();
}

<section class="hero-section">

    @* ── Left: Welcome ── *@
    <div class="hero-left">
        <div class="hero-animation mb-2">
            <img src="~/images/Specs-Animation.png" class="floating-specs" alt="Floating Specs" />
        </div>
        <h1 class="lh-1 text-capitalize hero-welcome-text mb-1">Welcome to</h1>
        <h1 class="lh-1 hero-welcome-text mb-2">Jayamali Optical</h1>
        <h5 class="text-muted fw-normal mb-4">Your trusted destination for eye care!</h5>
        <div class="d-flex gap-3 flex-wrap justify-content-center">
            <a asp-controller="Products" asp-action="Index" class="btn btn-primary hero-btns btn-lg px-4 rounded-pill">
                <i class="bi bi-bag me-2"></i>Shop Now
            </a>
            <a asp-controller="Bookings" asp-action="Create" class="btn btn-outline-primary hero-btns btn-lg px-4 rounded-pill">
                <i class="bi bi-calendar-check me-2"></i>Book Appointment
            </a>
        </div>
    </div>

    @* ── Right: Offer Carousel ── *@
    <div class="offer-carousel-wrapper">

        <span class="offer-badge"><i class="bi bi-stars me-1"></i>Special Offers</span>

        <div id="offerCarousel" class="offer-carousel carousel slide" data-bs-ride="carousel" data-bs-interval="4000">

            <div class="carousel-inner">
                @if (useStatic)
                {
                    @* Fallback static slides *@
                    <div class="carousel-item active">
                        <img src="~/images/Offers/Offer01.jpg" alt="Offer 1" />
                    </div>
                    <div class="carousel-item">
                        <img src="~/images/Offers/Offer02.jpg" alt="Offer 2" />
                    </div>
                    <div class="carousel-item">
                        <img src="~/images/Offers/Offer03.jpg" alt="Offer 3" />
                    </div>
                }
                else
                {
                    @for (int i = 0; i < slides.Count; i++)
                    {
                        var slide = slides[i];
                        <div class="carousel-item @(i == 0 ? "active" : "")">
                            @if (!string.IsNullOrEmpty(slide.LinkUrl))
                            {
                                <a href="@slide.LinkUrl">
                                    <img src="@slide.ImagePath" alt="@(slide.Caption ?? "Offer")" />
                                </a>
                            }
                            else
                            {
                                <img src="@slide.ImagePath" alt="@(slide.Caption ?? "Offer")" />
                            }
                            @if (!string.IsNullOrEmpty(slide.Caption))
                            {
                                <div class="slide-caption">@slide.Caption</div>
                            }
                        </div>
                    }
                }
            </div>

            @* Custom nav buttons *@
            <button class="offer-nav offer-nav-prev" type="button"
                    data-bs-target="#offerCarousel" data-bs-slide="prev">
                <i class="bi bi-chevron-left"></i>
            </button>
            <button class="offer-nav offer-nav-next" type="button"
                    data-bs-target="#offerCarousel" data-bs-slide="next">
                <i class="bi bi-chevron-right"></i>
            </button>

            @* Custom dot indicators *@
            <div class="offer-indicators">
                @{
                    int count = useStatic ? 3 : slides.Count;
                }
                @for (int i = 0; i < count; i++)
                {
                    <button type="button"
                            data-bs-target="#offerCarousel"
                            data-bs-slide-to="@i"
                            class="@(i == 0 ? "active" : "")"
                            aria-label="Slide @(i + 1)"></button>
                }
            </div>

            @* Slide counter *@
            <div class="slide-counter" id="slideCounter">1 / @count</div>
        </div>
    </div>
</section>

<script>
    // Update counter and dots on slide change
    document.addEventListener('DOMContentLoaded', function () {
        var carousel = document.getElementById('offerCarousel');
        if (!carousel) return;

        var total = carousel.querySelectorAll('.carousel-item').length;
        var counter = document.getElementById('slideCounter');
        var dots = carousel.querySelectorAll('.offer-indicators button');

        carousel.addEventListener('slid.bs.carousel', function (e) {
            var idx = e.to + 1;
            if (counter) counter.textContent = idx + ' / ' + total;
            dots.forEach(function (d, i) {
                d.classList.toggle('active', i === e.to);
            });
        });
    });
</script>