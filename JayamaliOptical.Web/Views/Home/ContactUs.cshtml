@using JayamaliOptical.Web.Models
@{
    ViewData["Title"] = "Contact Us";
    var s = ViewBag.Settings as SiteSettings ?? new SiteSettings();
}

<style>
    :root {
        --jm-blue: #1978bc;
        --jm-lblue: #26a4e0;
        --jm-green: #6ea700;
    }

    /* ── Hero ── */
    .contact-hero {
        background: linear-gradient(135deg, var(--jm-blue) 0%, #0d4f8a 100%);
        padding: 70px 0 90px;
        position: relative;
        overflow: hidden;
    }

        .contact-hero::after {
            content: '';
            position: absolute;
            bottom: -1px;
            left: 0;
            right: 0;
            height: 60px;
            background: #f4f7fb;
            clip-path: ellipse(55% 100% at 50% 100%);
        }

    .hero-eye-icon {
        font-size: 5rem;
        opacity: 0.12;
        position: absolute;
        right: 8%;
        top: 50%;
        transform: translateY(-50%);
    }

    /* ── Info Cards ── */
    .info-card {
        border: none;
        border-radius: 16px;
        padding: 30px 24px;
        text-align: center;
        transition: transform 0.25s, box-shadow 0.25s;
        height: 100%;
    }

        .info-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 16px 40px rgba(25,120,188,0.15) !important;
        }

    .info-icon-circle {
        width: 64px;
        height: 64px;
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.6rem;
        margin-bottom: 16px;
    }

    .info-card h6 {
        font-weight: 700;
        color: #222;
        font-size: 1rem;
        margin-bottom: 10px;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    .info-card a, .info-card p {
        color: #555;
        font-size: 0.95rem;
        text-decoration: none;
        line-height: 1.8;
        display: block;
    }

        .info-card a:hover {
            color: var(--jm-blue);
        }

    /* ── Social Strip ── */
    .social-btn {
        width: 48px;
        height: 48px;
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.3rem;
        transition: transform 0.2s, box-shadow 0.2s;
        text-decoration: none;
        border: 2px solid transparent;
    }

        .social-btn:hover {
            transform: scale(1.15);
            box-shadow: 0 6px 18px rgba(0,0,0,0.15);
        }

    /* ── Hours Table ── */
    .hours-row {
        display: flex;
        justify-content: space-between;
        padding: 8px 0;
        font-size: 0.95rem;
    }

        .hours-row + .hours-row {
            border-top: 1px dashed #e0e7f0;
        }

    .hours-day {
        font-weight: 600;
        color: #333;
    }

    .hours-time {
        color: #555;
    }

    .hours-closed {
        color: #dc3545;
        font-weight: 600;
    }

    .hours-open-now {
        background: #e8f5e9;
        border-radius: 50px;
        padding: 2px 12px;
        font-size: 0.78rem;
        font-weight: 700;
        color: #2e7d32;
    }

    /* ── Map Card ── */
    .map-wrapper {
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 8px 32px rgba(0,0,0,0.12);
    }

    /* ── Quick Contact Form ── */
    .contact-form-card {
        border-radius: 20px;
        background: white;
        box-shadow: 0 8px 40px rgba(25,120,188,0.10);
        padding: 40px;
    }

    .form-control:focus, .form-select:focus {
        border-color: var(--jm-blue);
        box-shadow: 0 0 0 0.2rem rgba(25,120,188,0.15);
    }

    .btn-contact {
        background: linear-gradient(135deg, var(--jm-blue), var(--jm-lblue));
        border: none;
        color: white;
        font-weight: 600;
        border-radius: 50px;
        padding: 12px 40px;
        transition: opacity 0.2s, transform 0.2s;
    }

        .btn-contact:hover {
            opacity: 0.9;
            transform: translateY(-2px);
            color: white;
        }

    /* ── Section label ── */
    .section-eyebrow {
        font-size: 0.8rem;
        font-weight: 700;
        letter-spacing: 2px;
        text-transform: uppercase;
        color: var(--jm-blue);
        margin-bottom: 8px;
    }

    .section-divider-line {
        width: 50px;
        height: 3px;
        background: linear-gradient(to right, var(--jm-blue), var(--jm-lblue));
        border-radius: 2px;
        margin: 12px auto 0;
    }

    /* Success toast */
    #successToast {
        position: fixed;
        bottom: 30px;
        right: 30px;
        z-index: 9999;
        min-width: 300px;
    }
</style>

@* ── Hero ── *@
<div class="contact-hero text-white text-center">
    <i class="bi bi-eye hero-eye-icon"></i>
    <div class="container position-relative" style="z-index:1;">
        <p class="section-eyebrow text-white opacity-75 mb-1">We'd love to hear from you</p>
        <h1 class="display-4 fw-bold mb-3">Get In Touch</h1>
        <p class="lead mb-4" style="opacity:0.88; max-width:520px; margin:0 auto;">
            Visit us, call us, or send a message — we're always here to help you see the world more clearly.
        </p>
        <div class="d-flex justify-content-center gap-3 flex-wrap mt-4">
            @if (!string.IsNullOrEmpty(s.Phone1))
            {
                <a href="tel:@s.Phone1.Replace(" ", "")" class="btn btn-light btn-lg px-4 rounded-pill fw-semibold">
                    <i class="bi bi-telephone-fill me-2 text-primary"></i>@s.Phone1
                </a>
            }
            @if (!string.IsNullOrEmpty(s.WhatsAppUrl))
            {
                <a href="@s.WhatsAppUrl" target="_blank" class="btn btn-success btn-lg px-4 rounded-pill fw-semibold">
                    <i class="bi bi-whatsapp me-2"></i>WhatsApp Us
                </a>
            }
        </div>
    </div>
</div>

@* ── Info Cards Row ── *@
<div style="background:#f4f7fb;" class="pb-5 pt-2">
    <div class="container" style="margin-top:-30px; position:relative; z-index:2;">
        <div class="row g-4">

            @* Address *@
            <div class="col-md-3 col-sm-6">
                <div class="info-card shadow-sm bg-white">
                    <div class="info-icon-circle" style="background:#e8f0fc;">
                        <i class="bi bi-geo-alt-fill text-primary"></i>
                    </div>
                    <h6>Find Us</h6>
                    <p>@(string.IsNullOrEmpty(s.Address) ? "No: 116, Kurunagala Road, Puttalam, Sri Lanka" : s.Address)</p>
                    <a href="https://maps.google.com/?q=Jayamali+Optical+Puttalam" target="_blank"
                       class="btn btn-outline-primary btn-sm rounded-pill mt-2">
                        <i class="bi bi-map me-1"></i>Get Directions
                    </a>
                </div>
            </div>

            @* Phone *@
            <div class="col-md-3 col-sm-6">
                <div class="info-card shadow-sm bg-white">
                    <div class="info-icon-circle" style="background:#e8f5e9;">
                        <i class="bi bi-telephone-fill text-success"></i>
                    </div>
                    <h6>Call Us</h6>
                    @if (!string.IsNullOrEmpty(s.Phone1))
                    {
                        <a href="tel:@s.Phone1.Replace(" ", "")">@s.Phone1</a>
                    }
                    @if (!string.IsNullOrEmpty(s.Phone2))
                    {
                        <a href="tel:@s.Phone2.Replace(" ", "")">@s.Phone2</a>
                    }
                    @if (!string.IsNullOrEmpty(s.Phone3))
                    {
                        <a href="tel:@s.Phone3.Replace(" ", "")">@s.Phone3</a>
                    }
                    @if (string.IsNullOrEmpty(s.Phone1) && string.IsNullOrEmpty(s.Phone2) && string.IsNullOrEmpty(s.Phone3))
                    {
                        <p>077 653 7611</p>
                        <p>076 730 3410</p>

                        <p>032 226 6965</p>
                    }
                </div>
            </div>

            @* Email *@
            <div class="col-md-3 col-sm-6">
                <div class="info-card shadow-sm bg-white">
                    <div class="info-icon-circle" style="background:#fff3e0;">
                        <i class="bi bi-envelope-fill" style="color:#e65100;"></i>
                    </div>
                    <h6>Email Us</h6>
                    @{
                        var email = string.IsNullOrEmpty(s.Email) ? "jayamalioptical@gmail.com" : s.Email;
                    }
                    <a href="mailto:@email">@email</a>
                    <p class="mt-2" style="font-size:0.82rem; color:#888;">We reply within 24 hours</p>
                </div>
            </div>

            @* Hours Info Card *@
            <div class="col-md-3 col-sm-6">
                <div class="info-card shadow-sm bg-white">
                    <div class="info-icon-circle" style="background:#f3e5f5;">
                        <i class="bi bi-clock-fill" style="color:#7b1fa2;"></i>
                    </div>
                    <h6>Opening Hours</h6>
                    @{
                        // Show today's hours
                        var todayOpen = "";
                        var todayClose = "";
                        bool todayClosed = false;
                        switch (DateTime.Now.DayOfWeek)
                        {
                            case DayOfWeek.Monday: todayOpen = s.MonOpen; todayClose = s.MonClose; todayClosed = s.MonClosed; break;
                            case DayOfWeek.Tuesday: todayOpen = s.TueOpen; todayClose = s.TueClose; todayClosed = s.TueClosed; break;
                            case DayOfWeek.Wednesday: todayOpen = s.WedOpen; todayClose = s.WedClose; todayClosed = s.WedClosed; break;
                            case DayOfWeek.Thursday: todayOpen = s.ThuOpen; todayClose = s.ThuClose; todayClosed = s.ThuClosed; break;
                            case DayOfWeek.Friday: todayOpen = s.FriOpen; todayClose = s.FriClose; todayClosed = s.FriClosed; break;
                            case DayOfWeek.Saturday: todayOpen = s.SatOpen; todayClose = s.SatClose; todayClosed = s.SatClosed; break;
                            case DayOfWeek.Sunday: todayOpen = s.SunOpen; todayClose = s.SunClose; todayClosed = s.SunClosed; break;
                        }
                    }
                    <p style="font-size:0.88rem;">
                        <strong>Today:</strong>
                        @if (todayClosed)
                        {
                            <span class="text-danger fw-bold">Closed</span>
                        }
                        else
                        {
                            @($"{todayOpen} – {todayClose}")
                        }
                    </p>
                    <p style="font-size:0.82rem; color:#888;">See full hours below ↓</p>
                    <span class="@(s.IsOpenNow() ? "hours-open-now" : "badge bg-danger bg-opacity-10 text-danger rounded-pill px-3")"
                          style="font-size:0.78rem; font-weight:700;">
                        <i class="bi @(s.IsOpenNow() ? "bi-circle-fill" : "bi-circle") me-1" style="font-size:0.5rem;"></i>
                        @(s.IsOpenNow() ? "Open Now" : "Closed Now")
                    </span>
                </div>
            </div>

        </div>
    </div>
</div>

@* ── Main Section: Form + Map ── *@
<div class="container py-5">
    <div class="row g-5 align-items-start">

        @* Left: Quick Contact Form *@
        <div class="col-lg-5">
            <div class="contact-form-card">
                <p class="section-eyebrow">Drop Us a Line</p>
                <h3 class="fw-bold mb-1">Send a Message</h3>
                <div class="section-divider-line mb-4" style="margin-left:0;"></div>
                <p class="text-muted mb-4" style="font-size:0.93rem;">
                    Have a question about eye care, products, or appointments? Fill in the form and we'll get back to you shortly.
                </p>

                @* Show success/error from server *@
                @if (TempData["ContactSuccess"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show mx-3 mt-3" role="alert">
                        <i class="bi bi-check-circle-fill me-2"></i>@TempData["ContactSuccess"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                @if (TempData["ContactError"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show mx-3 mt-3" role="alert">
                        <i class="bi bi-exclamation-circle-fill me-2"></i>@TempData["ContactError"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }

                <form action="/Home/SendMessage" method="post" id="contactForm" novalidate>
                    @Html.AntiForgeryToken()
                    <div class="row g-3">
                        <div class="col-sm-6">
                            <div class="form-floating">
                                <input type="text" name="name" class="form-control" id="cfName"
                                       placeholder="Your Name" required />
                                <label for="cfName"><i class="bi bi-person me-1"></i>Full Name *</label>
                                <div class="invalid-feedback">Please enter your name.</div>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="form-floating">
                                <input type="tel" name="phone" class="form-control" id="cfPhone" placeholder="Phone" />
                                <label for="cfPhone"><i class="bi bi-telephone me-1"></i>Phone</label>
                            </div>
                        </div>
                        <div class="col-12">
                            <div class="form-floating">
                                <input type="email" name="email" class="form-control" id="cfEmail"
                                       placeholder="Email" required />
                                <label for="cfEmail"><i class="bi bi-envelope me-1"></i>Email Address *</label>
                                <div class="invalid-feedback">Please enter a valid email.</div>
                            </div>
                        </div>
                        <div class="col-12">
                            <div class="form-floating">
                                <select name="subject" class="form-select" id="cfSubject">
                                    <option value="" selected disabled>Choose a topic...</option>
                                    <option>Appointment Inquiry</option>
                                    <option>Product Information</option>
                                    <option>Prescription Query</option>
                                    <option>Eye Examination</option>
                                    <option>Other</option>
                                </select>
                                <label for="cfSubject"><i class="bi bi-tag me-1"></i>Subject</label>
                            </div>
                        </div>
                        <div class="col-12">
                            <div class="form-floating">
                                <textarea name="message" class="form-control" id="cfMessage"
                                          placeholder="Message" style="height:120px;" required></textarea>
                                <label for="cfMessage"><i class="bi bi-chat-text me-1"></i>Your Message *</label>
                                <div class="invalid-feedback">Please write your message.</div>
                            </div>
                        </div>
                        <div class="col-12 d-grid">
                            <button type="submit" class="btn btn-contact btn-lg">
                                <i class="bi bi-send-fill me-2"></i>Send Message
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        @* Right: Map + Social + Hours detail *@
        <div class="col-lg-7">

            @* Map *@
            <div class="mb-4">
                <p class="section-eyebrow">Where to Find Us</p>
                <h3 class="fw-bold mb-3">Our Location</h3>
                <div class="section-divider-line mb-4" style="margin-left:0;"></div>
                <div class="map-wrapper">
                    <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3950.7281669882877!2d79.83554597436441!3d8.026939291999712!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3afd160d002fb4fb%3A0x1b0eeb335a99a11!2sJayamali%20Optical!5e0!3m2!1sen!2slk!4v1773153008953!5m2!1sen!2slk"
                            width="100%" height="300" style="border:0; display:block;"
                            allowfullscreen loading="lazy"
                            referrerpolicy="no-referrer-when-downgrade"></iframe>
                </div>
            </div>

            @* Detailed Hours *@
            <div class="bg-white rounded-4 shadow-sm p-4 mb-4">
                <h5 class="fw-bold mb-3"><i class="bi bi-clock text-primary me-2"></i>Clinic Hours</h5>
                @{
                    var hourRows = new[]
                    {
                                ("Monday",          s.MonOpen, s.MonClose, s.MonClosed),
                                ("Tuesday",         s.TueOpen, s.TueClose, s.TueClosed),
                                ("Wednesday",       s.WedOpen, s.WedClose, s.WedClosed),
                                ("Thursday",        s.ThuOpen, s.ThuClose, s.ThuClosed),
                                ("Friday",          s.FriOpen, s.FriClose, s.FriClosed),
                                ("Saturday",        s.SatOpen, s.SatClose, s.SatClosed),
                                ("Sunday",          s.SunOpen, s.SunClose, s.SunClosed),
                                ("Public Holidays", s.HolOpen, s.HolClose, s.HolClosed),
                                };
                    var todayName = DateTime.Now.DayOfWeek.ToString();
                }
                @foreach (var (day, open, close, isClosed) in hourRows)
                {
                    <div class="hours-row @(day == todayName ? "fw-bold" : "")">
                        <span class="hours-day">
                            @day
                            @if (day == todayName)
                            {
                                <span class="badge bg-primary ms-1" style="font-size:0.6rem;">Today</span>
                            }
                        </span>
                        @if (isClosed)
                        {
                            <span class="hours-closed">Closed</span>
                        }
                        else
                        {
                            <span class="hours-time">@open – @close</span>
                        }
                    </div>
                }
                <div class="mt-3 p-3 rounded-3" style="background:#f0f7ff; font-size:0.88rem; color:#1978bc;">
                    <i class="bi bi-info-circle me-2"></i>
                    Walk-ins welcome. For eye examinations, we recommend booking in advance.
                    <a href="/Bookings" class="fw-semibold ms-1">Book Now →</a>
                </div>
            </div>

            @* Social Media *@
            <div class="bg-white rounded-4 shadow-sm p-4">
                <h5 class="fw-bold mb-3"><i class="bi bi-share text-primary me-2"></i>Follow & Connect</h5>
                <div class="d-flex flex-wrap gap-3 align-items-center">
                    @{
                        var fbUrl = string.IsNullOrEmpty(s.FacebookUrl) ? "#" : s.FacebookUrl;
                        var waUrl = string.IsNullOrEmpty(s.WhatsAppUrl) ? "#" : s.WhatsAppUrl;
                        var ttUrl = string.IsNullOrEmpty(s.TikTokUrl) ? "#" : s.TikTokUrl;
                        var igUrl = string.IsNullOrEmpty(s.InstagramUrl) ? "#" : s.InstagramUrl;
                    }
                    <a href="@fbUrl" target="_blank" class="social-btn"
                       style="background:#1877F2; color:white;" title="Facebook">
                        <i class="bi bi-facebook"></i>
                    </a>
                    <a href="@waUrl" target="_blank" class="social-btn"
                       style="background:#25D366; color:white;" title="WhatsApp">
                        <i class="bi bi-whatsapp"></i>
                    </a>
                    <a href="@ttUrl" target="_blank" class="social-btn"
                       style="background:#010101; color:white;" title="TikTok">
                        <i class="bi bi-tiktok"></i>
                    </a>
                    <a href="@igUrl" target="_blank" class="social-btn"
                       style="background:radial-gradient(circle at 30% 107%, #fdf497 0%, #fdf497 5%, #fd5949 45%, #d6249f 60%, #285AEB 90%); color:white;"
                       title="Instagram">
                        <i class="bi bi-instagram"></i>
                    </a>
                    <div class="ms-2">
                        <div class="fw-semibold" style="font-size:0.9rem;">Stay Connected</div>
                        <div class="text-muted" style="font-size:0.8rem;">Follow us for eye care tips &amp; offers</div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

@* ── Bottom CTA Strip ── *@
<div style="background: linear-gradient(135deg, var(--jm-blue), var(--jm-lblue));" class="py-5 text-white text-center">
    <div class="container">
        <h3 class="fw-bold mb-2">Ready for your eye check-up?</h3>
        <p class="mb-4" style="opacity:0.88;">Our expert team is ready to give you the clearest vision possible.</p>
        <a href="/Bookings" class="btn btn-light btn-lg rounded-pill px-5 fw-semibold me-3">
            <i class="bi bi-calendar-check me-2 text-primary"></i>Book Appointment
        </a>
        <a href="/Products" class="btn btn-outline-light btn-lg rounded-pill px-5 fw-semibold">
            <i class="bi bi-eyeglasses me-2"></i>Browse Products
        </a>
    </div>
</div>

@* Success Toast *@
<div id="successToast" class="toast align-items-center text-white bg-success border-0 shadow-lg" role="alert">
    <div class="d-flex">
        <div class="toast-body fs-6">
            <i class="bi bi-check-circle-fill me-2"></i>
            Thank you! Your message has been sent. We'll be in touch shortly.
        </div>
        <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
    </div>
</div>

@section Scripts {
    <script>
        // Client-side validation only — submission goes to server
        document.getElementById('contactForm').addEventListener('submit', function(e) {
            if (!this.checkValidity()) {
                e.preventDefault();
                this.classList.add('was-validated');
            }
        });

        // Auto-scroll to success/error alert if present
        document.addEventListener('DOMContentLoaded', function() {
            var alert = document.querySelector('.alert-success, .alert-danger');
            if (alert) alert.scrollIntoView({ behavior: 'smooth', block: 'center' });
        });
    </script>
}