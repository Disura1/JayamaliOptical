@{
    ViewData["Title"] = "About Us";
    var settings = ViewBag.Settings as JayamaliOptical.Web.Models.SiteSettings ?? new JayamaliOptical.Web.Models.SiteSettings();
}

<style>
    .about-hero {
        background: linear-gradient(135deg, #0d6efd 0%, #0a58ca 60%, #084298 100%);
        color: white;
        padding: 80px 0 60px;
        margin-bottom: 0;
    }

    .section-divider {
        width: 60px;
        height: 4px;
        background: #0d6efd;
        border-radius: 2px;
        margin: 0 auto 20px;
    }

    .timeline-item {
        position: relative;
        padding-left: 40px;
        margin-bottom: 30px;
    }

        .timeline-item::before {
            content: '';
            position: absolute;
            left: 12px;
            top: 0;
            bottom: -30px;
            width: 2px;
            background: #dee2e6;
        }

        .timeline-item:last-child::before {
            display: none;
        }

    .timeline-dot {
        position: absolute;
        left: 0;
        top: 6px;
        width: 26px;
        height: 26px;
        border-radius: 50%;
        background: #0d6efd;
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.7rem;
        font-weight: bold;
    }

    .mission-item {
        border-left: 4px solid #0d6efd;
        padding: 10px 16px;
        background: #f8f9ff;
        border-radius: 0 8px 8px 0;
        margin-bottom: 12px;
    }

    .vision-card {
        background: linear-gradient(135deg, #0d6efd, #084298);
        color: white;
        border-radius: 16px;
        padding: 40px;
        position: relative;
        overflow: hidden;
    }

        .vision-card::before {
            content: '\201C';
            position: absolute;
            top: -20px;
            left: 20px;
            font-size: 150px;
            opacity: 0.1;
            font-family: Georgia, serif;
            line-height: 1;
        }

    .tab-pill .nav-link {
        border-radius: 50px !important;
        padding: 8px 24px;
        color: #0d6efd;
        border: 2px solid #0d6efd !important;
        margin: 0 4px;
        transition: all 0.2s;
    }

        .tab-pill .nav-link.active {
            background: #0d6efd !important;
            color: white !important;
        }

    .est-badge {
        display: inline-block;
        background: rgba(255,255,255,0.2);
        border: 2px solid rgba(255,255,255,0.5);
        border-radius: 50px;
        padding: 6px 20px;
        font-size: 0.9rem;
        letter-spacing: 2px;
        margin-bottom: 20px;
    }
</style>

@* Hero *@
<div class="about-hero text-center">
    <div class="container">
        <span class="est-badge">EST. 2016</span>
        <h1 class="display-4 fw-bold mb-3">Jayamali Optical & Eye Care</h1>
        <p class="lead mb-4" style="opacity:0.9;">Your Vision, Our Priority — Serving Puttalam since 2016</p>
        <div class="d-flex justify-content-center gap-3 flex-wrap">
            <a href="#history" class="btn btn-light btn-lg px-4">
                <i class="bi bi-clock-history me-2"></i>Our History
            </a>
            <a href="#vision" class="btn btn-outline-light btn-lg px-4">
                <i class="bi bi-eye me-2"></i>Vision & Mission
            </a>
            <a href="/Home/Privacy" class="btn btn-outline-light btn-lg px-4">
                <i class="bi bi-shield-check me-2"></i>Privacy Policy
            </a>
        </div>
    </div>
</div>

@* Stat Strip *@
<div class="bg-dark text-white py-4 mb-5">
    <div class="container">
        <div class="row text-center g-3">
            <div class="col-6 col-md-3">
                <div class="fs-2 fw-bold text-info">2016</div>
                <div class="small">Year Founded</div>
            </div>
            <div class="col-6 col-md-3">
                <div class="fs-2 fw-bold text-info">9+</div>
                <div class="small">Years of Service</div>
            </div>
            <div class="col-6 col-md-3">
                <div class="fs-2 fw-bold text-info">10+</div>
                <div class="small">Services Offered</div>
            </div>
            <div class="col-6 col-md-3">
                <div class="fs-2 fw-bold text-info">★ #1</div>
                <div class="small">In Puttalam Region</div>
            </div>
        </div>
    </div>
</div>

@* History Section *@
<section id="history" class="py-5">
    <div class="container">
        <div class="text-center mb-5">
            <div class="section-divider"></div>
            <h2 class="fw-bold">Our History</h2>
            <p class="text-muted">A journey of vision, care and community trust</p>
        </div>
        <div class="row align-items-start">
            <div class="col-md-5 mb-4 mb-md-0">
                <div class="bg-primary bg-opacity-10 rounded-4 p-4 h-100 d-flex flex-column justify-content-center">
                    <i class="bi bi-building text-primary" style="font-size:3rem;"></i>
                    <h3 class="fw-bold mt-3">From Humble Beginnings<br />to Regional Leader</h3>
                    <p class="text-muted mt-2 mb-0">Puttalam's most trusted eye care clinic, built on expertise, technology, and compassion.</p>
                    <div class="mt-4 d-flex gap-2 flex-wrap">
                        <span class="badge bg-primary px-3 py-2">HVF Testing</span>
                        <span class="badge bg-primary px-3 py-2">OCT Scans</span>
                        <span class="badge bg-primary px-3 py-2">Contact Lenses</span>
                        <span class="badge bg-primary px-3 py-2">Laser Treatment</span>
                        <span class="badge bg-primary px-3 py-2">Cataract Support</span>
                        <span class="badge bg-primary px-3 py-2">Orthoptic Care</span>
                    </div>
                </div>
            </div>
            <div class="col-md-7">
                @if (!string.IsNullOrEmpty(settings.History))
                {
                    @foreach (var para in settings.History.Split('\n', StringSplitOptions.RemoveEmptyEntries))
                    {
                        <div class="timeline-item">
                            <div class="timeline-dot"><i class="bi bi-check-lg" style="font-size:0.6rem;"></i></div>
                            <p class="mb-0 text-secondary" style="font-size:1.02rem; line-height:1.7;">@para.Trim()</p>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</section>

<div class="container"><hr class="my-2" /></div>

@* Vision & Mission Section *@
<section id="vision" class="py-5">
    <div class="container">
        <div class="text-center mb-5">
            <div class="section-divider"></div>
            <h2 class="fw-bold">Vision & Mission</h2>
            <p class="text-muted">What drives us every day</p>
        </div>

        @* Tab Toggle *@
        <ul class="nav tab-pill justify-content-center mb-5" id="vmTab" role="tablist">
            <li class="nav-item"><a class="nav-link active" id="vision-tab" data-bs-toggle="tab" href="#visionPane" role="tab"><i class="bi bi-eye me-2"></i>Our Vision</a></li>
            <li class="nav-item"><a class="nav-link" id="mission-tab" data-bs-toggle="tab" href="#missionPane" role="tab"><i class="bi bi-bullseye me-2"></i>Our Mission</a></li>
        </ul>

        <div class="tab-content" id="vmTabContent">
            @* Vision *@
            <div class="tab-pane fade show active" id="visionPane" role="tabpanel">
                <div class="row justify-content-center">
                    <div class="col-md-8">
                        <div class="vision-card text-center">
                            <i class="bi bi-eye-fill" style="font-size:3rem; opacity:0.8;"></i>
                            <h4 class="fw-bold mt-3 mb-4">Our Vision</h4>
                            <p class="lead mb-0" style="line-height:1.8; position:relative; z-index:1;">
                                @settings.Vision
                            </p>
                        </div>
                    </div>
                </div>
            </div>

            @* Mission *@
            <div class="tab-pane fade" id="missionPane" role="tabpanel">
                <div class="row justify-content-center">
                    <div class="col-md-9">
                        <div class="text-center mb-4">
                            <i class="bi bi-bullseye text-primary" style="font-size:3rem;"></i>
                            <p class="text-secondary mt-3" style="font-size:1.05rem;">@settings.Mission.Split('\n')[0]</p>
                        </div>
                        <p class="text-muted fw-semibold mb-3">We are committed to:</p>
                        @{
                            var missionLines = settings.Mission.Split('\n', StringSplitOptions.RemoveEmptyEntries).Skip(1).ToArray();
                        }
                        @foreach (var line in missionLines)
                        {
                            <div class="mission-item">
                                <i class="bi bi-check-circle-fill text-primary me-2"></i>@line.Trim().TrimStart('-').Trim()
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@* CTA *@
<section class="py-5 bg-light text-center">
    <div class="container">
        <h3 class="fw-bold mb-2">Ready to experience the difference?</h3>
        <p class="text-muted mb-4">Book an appointment or explore our services today.</p>
        <div class="d-flex justify-content-center gap-3 flex-wrap">
            <a href="/Bookings/Create" class="btn btn-primary btn-lg px-4">
                <i class="bi bi-calendar-check me-2"></i>Book Appointment
            </a>
            <a href="/Home/ContactUs" class="btn btn-outline-primary btn-lg px-4"><i class="bi bi-telephone me-2"></i>Contact Us</a>
        </div>
    </div>
</section>