@using JayamaliOptical.Web.Models
@{
    var reviews = ViewBag.Reviews as List<Review> ?? new List<Review>();
    var reviewCount = (int)(ViewBag.ReviewCount ?? 0);
    var avgRating = (double)(ViewBag.AverageRating ?? 0.0);
}

<style>
    /* ── Section wrapper ── */
    .reviews-section {
        background: linear-gradient(160deg, #f0f6ff 0%, #fafbff 60%, #f0fff4 100%);
        padding: 70px 0 60px;
        position: relative;
        overflow: hidden;
    }

        .reviews-section::before {
            content: '\201C';
            position: absolute;
            top: -30px;
            left: 30px;
            font-size: 280px;
            color: rgba(25,120,188,0.05);
            font-family: Georgia, serif;
            line-height: 1;
            pointer-events: none;
        }

    /* ── Header ── */
    .reviews-header {
        text-align: center;
        margin-bottom: 50px;
    }

    .reviews-eyebrow {
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 3px;
        text-transform: uppercase;
        color: #1978bc;
        margin-bottom: 8px;
    }

    .reviews-title {
        font-size: 2rem;
        font-weight: 800;
        color: #111;
    }

    .reviews-sub {
        color: #666;
        font-size: 1rem;
    }

    .divider-bar {
        width: 50px;
        height: 4px;
        background: linear-gradient(to right, #1978bc, #26a4e0);
        border-radius: 2px;
        margin: 14px auto;
    }

    /* ── Stats strip ── */
    .reviews-stats {
        display: flex;
        justify-content: center;
        gap: 40px;
        margin-bottom: 44px;
        flex-wrap: wrap;
    }

    .stat-pill {
        background: white;
        border-radius: 50px;
        padding: 10px 28px;
        display: flex;
        align-items: center;
        gap: 10px;
        box-shadow: 0 4px 20px rgba(25,120,188,0.10);
        font-weight: 600;
        color: #333;
        font-size: 0.95rem;
    }

        .stat-pill .stat-num {
            font-size: 1.4rem;
            font-weight: 800;
            color: #1978bc;
        }

    /* ── Review Cards ── */

    /* ── Review Slider ── */
    .reviews-slider-wrapper {
        position: relative;
        overflow: hidden;
        margin-bottom: 50px;
        mask-image: linear-gradient(to right, transparent 0%, black 6%, black 94%, transparent 100%);
        -webkit-mask-image: linear-gradient(to right, transparent 0%, black 6%, black 94%, transparent 100%);
    }

    .reviews-track {
        display: flex;
        gap: 24px;
        width: max-content;
        animation: reviewsScroll 40s linear infinite;
    }

    @@keyframes reviewsScroll {
        0% {
            transform: translateX(0);
        }

        100% {
            transform: translateX(-50%);
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        .reviews-track {
            animation-play-state: paused;
        }
    }

    /* Fixed card width — same card, just in a row now */
    .review-card {
        background: white;
        border-radius: 16px;
        padding: 26px;
        box-shadow: 0 4px 24px rgba(0,0,0,0.06);
        position: relative;
        border-top: 3px solid transparent;
        width: 320px;
        min-width: 320px;
        flex-shrink: 0;
        display: flex;
        flex-direction: column;
    }

        .review-card:hover {
            box-shadow: 0 12px 40px rgba(25,120,188,0.13);
        }

        .review-card.featured {
            border-top: 3px solid #1978bc;
        }

            .review-card.featured::after {
                content: 'Featured';
                position: absolute;
                top: -1px;
                right: 18px;
                background: linear-gradient(135deg, #1978bc, #26a4e0);
                color: white;
                font-size: 0.65rem;
                font-weight: 700;
                letter-spacing: 1px;
                text-transform: uppercase;
                padding: 3px 10px;
                border-radius: 0 0 6px 6px;
            }

    .review-card {
        background: white;
        border-radius: 16px;
        padding: 26px;
        box-shadow: 0 4px 24px rgba(0,0,0,0.06);
        position: relative;
        transition: transform 0.25s, box-shadow 0.25s;
        border-top: 3px solid transparent;
    }

        .review-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 12px 40px rgba(25,120,188,0.13);
        }

        .review-card.featured {
            border-top: 3px solid #1978bc;
        }

            .review-card.featured::after {
                content: 'Featured';
                position: absolute;
                top: -1px;
                right: 18px;
                background: linear-gradient(135deg, #1978bc, #26a4e0);
                color: white;
                font-size: 0.65rem;
                font-weight: 700;
                letter-spacing: 1px;
                text-transform: uppercase;
                padding: 3px 10px;
                border-radius: 0 0 6px 6px;
            }

    /* Quote icon */
    .review-quote {
        font-size: 2.5rem;
        line-height: 0.8;
        color: #e8f0fb;
        font-family: Georgia, serif;
        margin-bottom: 4px;
    }

    /* Stars */
    .review-stars {
        color: #f59e0b;
        font-size: 1rem;
        letter-spacing: 2px;
        margin-bottom: 12px;
    }

        .review-stars .star-empty {
            color: #e2e8f0;
        }

    /* Comment */
    .review-comment {
        font-size: 0.95rem;
        color: #444;
        line-height: 1.7;
        margin-bottom: 18px;
        flex-grow: 1;
    }

    /* Footer */
    .review-footer {
        display: flex;
        align-items: center;
        gap: 12px;
        border-top: 1px solid #f1f5f9;
        padding-top: 14px;
    }

    .review-avatar {
        width: 42px;
        height: 42px;
        border-radius: 50%;
        background: linear-gradient(135deg, #1978bc, #26a4e0);
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 1rem;
        flex-shrink: 0;
    }

    .review-name {
        font-weight: 700;
        color: #222;
        font-size: 0.9rem;
    }

    .review-meta {
        font-size: 0.78rem;
        color: #888;
    }

    .review-service-badge {
        margin-left: auto;
        background: #f0f6ff;
        color: #1978bc;
        font-size: 0.7rem;
        font-weight: 600;
        padding: 3px 10px;
        border-radius: 50px;
        white-space: nowrap;
    }

    /* ── Form ── */
    .review-form-card {
        background: white;
        border-radius: 20px;
        padding: 40px;
        box-shadow: 0 8px 40px rgba(25,120,188,0.10);
        max-width: 680px;
        margin: 0 auto;
    }

    .review-form-title {
        font-size: 1.3rem;
        font-weight: 800;
        margin-bottom: 4px;
        color: #111;
    }

    /* Star rating input */
    .star-rating-input {
        display: flex;
        flex-direction: row-reverse;
        gap: 4px;
        margin-bottom: 4px;
    }

        .star-rating-input input {
            display: none;
        }

        .star-rating-input label {
            font-size: 1.8rem;
            color: #e2e8f0;
            cursor: pointer;
            transition: color 0.15s, transform 0.15s;
        }

            .star-rating-input label:hover,
            .star-rating-input label:hover ~ label,
            .star-rating-input input:checked ~ label {
                color: #f59e0b;
            }

            .star-rating-input label:hover {
                transform: scale(1.2);
            }

    .btn-submit-review {
        background: linear-gradient(135deg, #1978bc, #26a4e0);
        border: none;
        color: white;
        font-weight: 700;
        border-radius: 50px;
        padding: 13px 40px;
        transition: opacity 0.2s, transform 0.2s;
        font-size: 1rem;
    }

        .btn-submit-review:hover {
            opacity: 0.9;
            transform: translateY(-2px);
            color: white;
        }

    @@media (max-width: 768px) {
        .review-form-card {
            padding: 24px;
        }
    }
</style>

<section class="reviews-section" id="reviews">
    <div class="container">

        @* ── Header ── *@
        <div class="reviews-header">
            <p class="reviews-eyebrow">What Our Customers Say</p>
            <h2 class="reviews-title">Customer Reviews</h2>
            <div class="divider-bar"></div>
            <p class="reviews-sub">Real experiences from our valued customers & patients</p>
        </div>

        @* ── Stats ── *@
        @if (reviewCount > 0)
        {
            <div class="reviews-stats">
                <div class="stat-pill">
                    <span class="stat-num">@avgRating</span>
                    <div>
                        <div style="color:#f59e0b; font-size:0.9rem;">
                            @for (int i = 1; i <= 5; i++)
                            {
                                <text>@(i <= Math.Round(avgRating) ? "★" : "☆")</text>
                            }
                        </div>
                        <div style="font-size:0.75rem; color:#888;">Average Rating</div>
                    </div>
                </div>
                <div class="stat-pill">
                    <span class="stat-num">@reviewCount</span>
                    <div>
                        <div style="font-size:0.85rem;">Happy Customers</div>
                        <div style="font-size:0.75rem; color:#888;">Verified Reviews</div>
                    </div>
                </div>
                <div class="stat-pill">
                    <span class="stat-num" style="color:#6ea700;">100%</span>
                    <div>
                        <div style="font-size:0.85rem;">Trusted Quality</div>
                        <div style="font-size:0.75rem; color:#888;">Since 2016</div>
                    </div>
                </div>
            </div>
        }

        @* ── Alerts ── *@
        @if (TempData["ReviewSuccess"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i>@TempData["ReviewSuccess"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["ReviewError"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
                <i class="bi bi-exclamation-circle-fill me-2"></i>@TempData["ReviewError"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @* ── Review Cards Slider ── *@
        @if (reviews.Any())
        {
            @* Duplicate reviews for seamless infinite loop *@
            var doubled = reviews.Concat(reviews).ToList();

            <div class="reviews-slider-wrapper">
                <div class="reviews-track">
                    @foreach (var r in doubled)
                    {
                        <div class="review-card @(r.IsFeatured ? "featured" : "")">
                            <div class="review-quote">"</div>
                            <div class="review-stars">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    <span class="@(i <= r.Rating ? "" : "star-empty")">★</span>
                                }
                            </div>
                            <p class="review-comment">@r.Comment</p>
                            <div class="review-footer">
                                <div class="review-avatar">
                                    @r.Name.Substring(0, 1).ToUpper()
                                </div>
                                <div>
                                    <div class="review-name">@r.Name</div>
                                    <div class="review-meta">
                                        @if (!string.IsNullOrEmpty(r.Location))
                                        {
                                            <i class="bi bi-geo-alt me-1"></i>
                                            @r.Location
                                            <span class="mx-1">·</span>
                                        }
                                        @r.SubmittedAt.ToString("MMM yyyy")
                                    </div>
                                </div>
                                @if (!string.IsNullOrEmpty(r.ServiceType))
                                {
                                    <span class="review-service-badge">@r.ServiceType</span>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
        else
        {
            <div class="text-center py-4 mb-5">
                <i class="bi bi-chat-heart" style="font-size:3.5rem; color:#ccd6e8;"></i>
                <p class="text-muted mt-3">No reviews yet — be the first to share your experience!</p>
            </div>
        }

        @* ── Review Form ── *@
        <div class="review-form-card">
            <div class="text-center mb-4">
                <i class="bi bi-pencil-square text-primary" style="font-size:2rem;"></i>
                <h4 class="review-form-title mt-2">Share Your Experience</h4>
                <p class="text-muted" style="font-size:0.9rem;">
                    Your feedback helps us serve you better and helps others discover the right products and eye care.
                </p>
            </div>

            <form action="/Home/SubmitReview" method="post" id="reviewForm" novalidate>
                @Html.AntiForgeryToken()

                <div class="row g-3 mb-3">
                    <div class="col-sm-6">
                        <label class="form-label fw-semibold">Your Name <span class="text-danger">*</span></label>
                        <input type="text" name="name" class="form-control"
                               placeholder="e.g. Amara Silva" maxlength="100" required />
                    </div>
                    <div class="col-sm-6">
                        <label class="form-label fw-semibold">Location <small class="text-muted">(optional)</small></label>
                        <input type="text" name="location" class="form-control"
                               placeholder="e.g. Puttalam" maxlength="100" />
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Service Used <small class="text-muted">(optional)</small></label>
                    <select name="serviceType" class="form-select">
                        <option value="">Select a service...</option>
                        <option>Eye Examination</option>
                        <option>Spectacles / Glasses</option>
                        <option>Contact Lenses</option>
                        <option>Sunglasses</option>
                        <option>OCT Scan</option>
                        <option>HVF Testing</option>
                        <option>Cataract Surgery Support</option>
                        <option>Laser Treatment</option>
                        <option>Orthoptic Assessment</option>
                        <option>General Visit</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold d-block">
                        Rating <span class="text-danger">*</span>
                    </label>
                    <div class="star-rating-input">
                        <input type="radio" name="rating" id="star5" value="5" />
                        <label for="star5" title="5 stars">★</label>

                        <input type="radio" name="rating" id="star4" value="4" />
                        <label for="star4" title="4 stars">★</label>

                        <input type="radio" name="rating" id="star3" value="3" />
                        <label for="star3" title="3 stars">★</label>

                        <input type="radio" name="rating" id="star2" value="2" />
                        <label for="star2" title="2 stars">★</label>

                        <input type="radio" name="rating" id="star1" value="1" checked />
                        <label for="star1" title="1 star">★</label>
                    </div>
                    <small class="text-muted" id="ratingLabel">Select your rating</small>
                </div>

                <div class="mb-4">
                    <label class="form-label fw-semibold">Your Review <span class="text-danger">*</span></label>
                    <textarea name="comment" class="form-control" rows="4"
                              maxlength="1000" required
                              placeholder="Tell us about your experience — eye care, spectacles, products, or anything else!"></textarea>
                    <small class="text-muted">Max 1000 characters</small>
                </div>

                <div class="d-grid">
                    <button type="submit" class="btn btn-submit-review">
                        <i class="bi bi-send-fill me-2"></i>Submit Review
                    </button>
                </div>

                <p class="text-center text-muted mt-3" style="font-size:0.8rem;">
                    <i class="bi bi-shield-check me-1 text-success"></i>
                    Reviews are moderated and may appear publicly after approval.
                </p>
            </form>
        </div>

    </div>
</section>

<script>
    // Update rating label on change
    document.querySelectorAll('.star-rating-input input[type="radio"]').forEach(function(radio) {
        radio.addEventListener('change', function() {
            var labels = { '1':'Poor', '2':'Fair', '3':'Good', '4':'Very Good', '5':'Excellent' };
            document.getElementById('ratingLabel').textContent =
                this.value + ' star' + (this.value > 1 ? 's' : '') + ' — ' + labels[this.value];
        });
    });

    // Set default label on page load to match whichever is checked
    (function() {
        var checked = document.querySelector('.star-rating-input input[type="radio"]:checked');
        if (checked) {
            var labels = { '1':'Poor', '2':'Fair', '3':'Good', '4':'Very Good', '5':'Excellent' };
            document.getElementById('ratingLabel').textContent =
                checked.value + ' star' + (checked.value > 1 ? 's' : '') + ' — ' + labels[checked.value];
        }
    })();
</script>