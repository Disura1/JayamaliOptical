@model IEnumerable<JayamaliOptical.Web.Models.Product>
@{
    ViewData["Title"] = "Our Products";
    var categories = ViewBag.Categories as List<JayamaliOptical.Web.Models.Category>;
    var selectedCategoryId = ViewBag.SelectedCategoryId as int?;
    var searchTerm = ViewBag.SearchTerm as string;
}

<section id="products" class="ProductsSec py-5">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="fw-bold">Our Products</h2>
            <p class="text-muted">Discover our wide range of optical products</p>
        </div>

        <!-- Category Filter -->
        <div class="row mb-4">
            <div class="col-12">
                <div class="btn-group flex-wrap justify-content-center" role="group">
                    <a href="@Url.Action("Index")"
                       class="btn @(selectedCategoryId == null ? "btn-primary" : "btn-outline-primary") m-1">
                        All Products
                    </a>
                    @foreach (var category in (categories ?? new List<JayamaliOptical.Web.Models.Category>()))
                    {
                        <a href="@Url.Action("Index", new { categoryId = category.Id })"
                           class="btn @(selectedCategoryId == category.Id ? "btn-primary" : "btn-outline-primary") m-1">
                            @category.Name
                        </a>
                    }
                </div>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(searchTerm))
        {
            <div class="d-flex align-items-center justify-content-between mb-3 px-1">
                <div>
                    <i class="bi bi-search me-2 text-primary"></i>
                    Showing results for <strong>"@searchTerm"</strong> — @Model.Count() product(s) found
                </div>
                <a href="/Products/Index" class="btn btn-sm btn-outline-secondary rounded-pill">
                    <i class="bi bi-x me-1"></i>Clear Search
                </a>
            </div>
        }

        @if (!Model.Any())
        {
            <div class="text-center py-5">
                <i class="bi bi-search text-muted mb-3" style="font-size:4rem;"></i>
                <h4>
                    @if (!string.IsNullOrEmpty(searchTerm))
                    {
                        <text>No results for "@searchTerm"</text>
                    }
                    else
                    {

                        <text>No products found</text>
                    }
                </h4>
                <p class="text-muted">
                    @if (!string.IsNullOrEmpty(searchTerm))
                    {
                        <text>Try a different search term or browse by category.</text>
                    }
                    else
                    {

                        <text>Check back soon for new arrivals!</text>
                    }
                </p>
                @if (!string.IsNullOrEmpty(searchTerm))
                {
                    <a href="/Products/Index" class="btn btn-primary rounded-pill px-4">
                        <i class="bi bi-arrow-left me-2"></i>View All Products
                    </a>
                }
            </div>
        }
        else
        {
            @if (!string.IsNullOrEmpty(searchTerm))
            {
                <div class="featured-grid">
                    @foreach (var product in Model)
                    {
                        <div class="fp-card product-item"
                             data-product-id="@product.Id"
                             onclick="openProductModal(@product.Id)">
                            @Html.Partial("_ProductCard", product)
                        </div>
                    }
                </div>
            }
            else
            {
                @foreach (var category in (categories ?? new List<JayamaliOptical.Web.Models.Category>())
                        .Where(c => Model.Any(p => p.CategoryId == c.Id)))
                {
                    var categoryProducts = Model.Where(p => p.CategoryId == category.Id).ToList();
                    <div class="category-section mb-5">
                        <h3 class="category-title mb-4 pb-2 border-bottom">
                            <i class="fas fa-@(category.Name == "Spectacle" ? "glasses" :
                                                                              category.Name == "Sunglasses" ? "sunglasses" :
                                                                              category.Name == "Contact Lens" ? "eye" : "box") me-2"></i>
                            @category.Name
                        </h3>
                        <div class="featured-grid">
                            @foreach (var product in categoryProducts)
                            {
                                <div class="fp-card product-item"
                                     data-product-id="@product.Id"
                                     onclick="openProductModal(@product.Id)">

                                    @* Rx badge *@
                                    @if (product.RequiresPrescription)
                                    {
                                        <div class="fp-rx-badge">
                                            <i class="bi bi-file-earmark-medical me-1"></i>Rx
                                        </div>
                                    }

                                    <div class="fp-img-wrap">
                                        @if (!string.IsNullOrEmpty(product.ImageUrl1))
                                        {
                                            <img src="@product.ImageUrl1" alt="@product.Name" loading="lazy" />
                                        }
                                        else
                                        {
                                            <div class="fp-no-img">
                                                <i class="bi bi-eyeglasses"></i>
                                            </div>
                                        }
                                        <div class="fp-overlay">
                                            <button class="fp-overlay-btn">
                                                <i class="bi bi-eye me-1"></i>Quick View
                                            </button>
                                        </div>
                                    </div>

                                    <div class="fp-body">
                                        <div class="fp-category">@product.Category?.Name</div>
                                        <div class="fp-name">@product.Name</div>
                                        @if (!string.IsNullOrEmpty(product.Brand))
                                        {
                                            <div class="fp-brand"><i class="bi bi-tag me-1"></i>@product.Brand</div>
                                        }
                                        <div class="fp-desc">@product.Description</div>
                                        <div class="fp-footer">
                                            @if (product.Price.HasValue)
                                            {
                                                <span class="fp-price">Rs. @product.Price.Value.ToString("0.00")</span>
                                            }
                                            else
                                            {
                                                <span class="fp-price-na">Price on request</span>
                                            }
                                            <form action="/Cart/AddToCart" method="post"
                                                  onclick="event.stopPropagation()">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="productId" value="@product.Id" />
                                                <input type="hidden" name="quantity" value="1" />
                                                <button type="submit" class="fp-cart-btn">
                                                    <i class="bi bi-cart-plus"></i>Add
                                                </button>
                                            </form>
                                        </div>
                                    </div>

                                </div>
                            }
                        </div>
                    </div>
                }
            }
        }
    </div>
</section>