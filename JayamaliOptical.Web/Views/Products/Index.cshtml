@model IEnumerable<JayamaliOptical.Web.Models.Product>
@{
    ViewData["Title"] = "Our Products";
    var categories = ViewBag.Categories as List<JayamaliOptical.Web.Models.Category>;
    var selectedCategoryId = ViewBag.SelectedCategoryId as int?;
}

<section id="products" class="ProductsSec py-5">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="fw-bold">Our Products</h2>
            <p class="text-muted">Discover our wide range of optical products</p>
        </div>

        <!-- Category Filter -->
        <div class="row mb-4">
            <div class="col-12">
                <div class="btn-group flex-wrap justify-content-center" role="group">
                    <a href="@Url.Action("Index")"
                       class="btn @(selectedCategoryId == null ? "btn-primary" : "btn-outline-primary") m-1">
                        All Products
                    </a>
                    @foreach (var category in (categories ?? new List<JayamaliOptical.Web.Models.Category>()))
                    {
                        <a href="@Url.Action("Index", new { categoryId = category.Id })"
                           class="btn @(selectedCategoryId == category.Id ? "btn-primary" : "btn-outline-primary") m-1">
                            @category.Name
                        </a>
                    }
                </div>
            </div>
        </div>

        <!-- Products Grid -->
        @if (!Model.Any())
        {
            <div class="text-center py-5">
                <i class="fas fa-box-open fa-4x text-muted mb-3"></i>
                <h4>No products found</h4>
                <p class="text-muted">Check back soon for new arrivals!</p>
            </div>
        }
        else
        {
            <!-- Group products by category -->
            @foreach (var category in (categories ?? new List<JayamaliOptical.Web.Models.Category>()).Where(c => Model.Any(p => p.CategoryId == c.Id)))
            {
                var categoryProducts = Model.Where(p => p.CategoryId == category.Id).ToList();

                <div class="category-section mb-5">
                    <h3 class="category-title mb-4 pb-2 border-bottom">
                        <i class="fas fa-@(category.Name == "Spectacle" ? "glasses" : category.Name == "Sunglasses" ? "sunglasses" : category.Name == "Contact Lens" ? "eye" : "lens") me-2"></i>
                        @category.Name
                    </h3>

                    <div class="row">
                        @foreach (var product in categoryProducts)
                        {
                            <div class="col-md-6 col-lg-4 col-xl-3 mb-4">
                                <div class="product-card card h-100 shadow-sm product-item"
                                     data-product-id="@product.Id"
                                     style="cursor: pointer;">

                                    <!-- Product Image -->
                                    @if (!string.IsNullOrEmpty(product.ImageUrl1))
                                    {
                                        <img src="@product.ImageUrl1"
                                             class="card-img-top product-img"
                                             alt="@product.Name"
                                             style="height: 250px; object-fit: cover;">
                                    }
                                    else
                                    {
                                        <div class="card-img-top bg-secondary d-flex align-items-center justify-content-center"
                                             style="height: 250px;">
                                            <i class="fas fa-@(category.Name == "Spectacle" ? "glasses" : category.Name == "Sunglasses" ? "sunglasses" : category.Name == "Contact Lens" ? "eye" : "lens") fa-4x text-white"></i>
                                        </div>
                                    }

                                    <!-- Product Info -->
                                    <div class="card-body d-flex flex-column">
                                        <h5 class="card-title fw-bold">@product.Name</h5>

                                        @if (!string.IsNullOrEmpty(product.Brand))
                                        {
                                            <p class="text-muted mb-2">
                                                <i class="fas fa-tag me-1"></i>@product.Brand
                                            </p>
                                        }

                                        <p class="card-text text-muted small flex-grow-1">
                                            @(product.Description?.Length > 80 ? product.Description.Substring(0, 80) + "..." : product.Description)
                                        </p>

                                        <div class="product-footer mt-3">
                                            @if (product.Price.HasValue)
                                            {
                                                <h6 class="text-primary fw-bold mb-2">
                                                    Rs. @product.Price.Value.ToString("0.00")
                                                </h6>
                                            }

                                            <button class="btn btn-primary w-100 view-product-btn"
                                                    data-product-id="@product.Id">
                                                <i class="fas fa-eye me-2"></i>View Details
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        }
    </div>
</section>

<!-- Product Details Modal -->
<div class="modal fade" id="productDetailsModal" tabindex="-1" aria-labelledby="productDetailsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold" id="productDetailsModalLabel">Product Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="modalContent">
                <!-- Content will be loaded dynamically -->
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .product-card {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        border: none;
        border-radius: 10px;
        overflow: hidden;
    }

        .product-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 30px rgba(0,0,0,0.15) !important;
        }

    .product-img {
        object-fit: cover;
        transition: transform 0.3s ease;
    }

    .product-card:hover .product-img {
        transform: scale(1.05);
    }

    .category-title {
        color: #0d6efd;
        font-weight: 600;
    }

    .view-product-btn {
        transition: all 0.3s ease;
    }

        .view-product-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(13, 110, 253, 0.4);
        }

    .product-item {
        animation: fadeIn 0.5s ease-in;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(20px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Handle product card click
        const productCards = document.querySelectorAll('.product-item');
        productCards.forEach(function(card) {
            card.addEventListener('click', function(e) {
                // Don't trigger if clicking the button (it will trigger separately)
                if (e.target.closest('.view-product-btn')) {
                    return;
                }

                const productId = this.getAttribute('data-product-id');
                openProductModal(productId);
            });
        });

        // Handle view product button click
        const viewButtons = document.querySelectorAll('.view-product-btn');
        viewButtons.forEach(function(btn) {
            btn.addEventListener('click', function(e) {
                e.stopPropagation(); // Prevent card click
                const productId = this.getAttribute('data-product-id');
                openProductModal(productId);
            });
        });

        function openProductModal(productId) {
            const modal = new bootstrap.Modal(document.getElementById('productDetailsModal'));
            const modalContent = document.getElementById('modalContent');

            // Show loading
            modalContent.innerHTML = `
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                </div>
            `;

            modal.show();

            // Fetch product details
            fetch('/Products/GetProductDetails?id=' + productId)
                .then(response => response.json())
                .then(data => {
                    displayProductDetails(data);
                })
                .catch(error => {
                    console.error('Error:', error);
                    modalContent.innerHTML = `
                        <div class="alert alert-danger">
                            <i class="fas fa-exclamation-triangle me-2"></i>
                            Error loading product details. Please try again.
                        </div>
                    `;
                });
        }

        function displayProductDetails(product) {
        const modalContent = document.getElementById('modalContent');

        let productTypeBadge = '';
        if (product.productType) {
            const typeClass = product.productType === 'Mens' ? 'bg-primary' :
                             product.productType === 'Ladies' ? 'bg-danger' : 'bg-info';
            productTypeBadge = `<span class="badge ${typeClass} mb-2">${product.productType}</span>`;
        }

        // ✅ ADD THIS: Prescription Required Badge
        let prescriptionBadge = '';
        if (product.requiresPrescription) {
            prescriptionBadge = `
                <div class="alert alert-warning d-flex align-items-center mb-3" role="alert">
                    <i class="bi bi-file-earmark-medical me-2 fs-5"></i>
                    <div>
                        <strong>Prescription Required</strong><br/>
                        <small class="text-muted">This product requires a valid prescription for purchase.</small>
                    </div>
                </div>
            `;
        }

        let imagesHtml = '';
        if (product.imageUrl1) {
            imagesHtml += `<img src="${product.imageUrl1}" class="img-fluid rounded mb-3" alt="${product.name}" />`;
        }
        if (product.imageUrl2) {
            imagesHtml += `<img src="${product.imageUrl2}" class="img-fluid rounded mb-3" alt="${product.name}" />`;
        }

        let specsHtml = '';
        if (product.frameType) {
            specsHtml += `<div class="mb-2"><strong>Frame Type:</strong> ${product.frameType}</div>`;
        }
        if (product.lensPower) {
            specsHtml += `<div class="mb-2"><strong>Lens Power:</strong> ${product.lensPower}</div>`;
        }
        if (product.iolType) {
            specsHtml += `<div class="mb-2"><strong>IOL Type:</strong> ${product.iolType}</div>`;
        }

        // FIX: Handle null price safely
        const priceDisplay = product.price ? parseFloat(product.price).toFixed(2) : '0.00';

        modalContent.innerHTML = `
            <div class="row">
                <div class="col-md-6">
                    ${imagesHtml}
                </div>
                <div class="col-md-6">
                    <h4 class="fw-bold mb-2">${product.name}</h4>
                    ${productTypeBadge}
                    <p class="text-muted mb-3">${product.category || ''}</p>

                    <h3 class="text-primary fw-bold mb-3">Rs. ${priceDisplay}</h3>

                    ${prescriptionBadge}  @* ← ADD THIS LINE *@

                    <p class="mb-3">${product.description || ''}</p>

                    ${product.brand ? `<p class="mb-2"><strong>Brand:</strong> ${product.brand}</p>` : ''}
                    ${product.stockQuantity !== null ? `<p class="mb-2"><strong>Stock:</strong> ${product.stockQuantity > 0 ? product.stockQuantity + ' available' : '<span class="text-danger">Out of stock</span>'}</p>` : ''}

                    ${specsHtml ? `<hr /><h6 class="fw-bold mb-2">Specifications</h6>${specsHtml}` : ''}

                    <div class="mt-4">
                        <form action="/Cart/AddToCart" method="post" class="d-inline mb-2">
                            <input type="hidden" name="productId" value="${product.id}" />
                            <input type="hidden" name="quantity" value="1" />
                            <button type="submit" class="btn btn-primary btn-lg w-100">
                                <i class="fas fa-cart-plus me-2"></i>Add to Cart
                            </button>
                        </form>
                        <a href="/Contact" class="btn btn-success btn-lg w-100">
                            <i class="fas fa-phone me-2"></i>Inquire Now
                        </a>
                    </div>
                </div>
            </div>
        `;
    }
    });
</script>