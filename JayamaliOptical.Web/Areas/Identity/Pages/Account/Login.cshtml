@page
@model LoginModel
@{
    ViewData["Title"] = "Log In";
    Layout = "/Views/Shared/_AuthLayout.cshtml";
}

<h4 class="auth-title">Welcome Back!</h4>
<p class="auth-subtitle">Sign in to your Jayamali Optical account</p>

<partial name="_StatusMessage" for="@TempData["StatusMessage"]" />

<form id="account" method="post">
    <div asp-validation-summary="ModelOnly"
         class="alert alert-danger rounded-3 py-2 small" role="alert"></div>

    <div class="form-floating mb-3">
        <input asp-for="Input.Email" class="form-control"
               placeholder="name@example.com"
               autocomplete="email" />
        <label asp-for="Input.Email">
            <i class="bi bi-envelope me-1"></i>Email Address
        </label>
        <span asp-validation-for="Input.Email" class="text-danger small"></span>
    </div>

    <div class="form-floating mb-3 position-relative">
        <input asp-for="Input.Password" class="form-control"
               placeholder="Password" id="loginPassword"
               autocomplete="current-password" />
        <label asp-for="Input.Password">
            <i class="bi bi-lock me-1"></i>Password
        </label>
        <button type="button"
                class="btn btn-sm position-absolute top-50 end-0 translate-middle-y me-2 border-0 bg-transparent text-muted"
                onclick="togglePassword('loginPassword', this)"
                tabindex="-1">
            <i class="bi bi-eye"></i>
        </button>
        <span asp-validation-for="Input.Password" class="text-danger small"></span>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div class="form-check">
            <input class="form-check-input" asp-for="Input.RememberMe" />
            <label class="form-check-label small" asp-for="Input.RememberMe">
                Remember me
            </label>
        </div>
        <a asp-page="./ForgotPassword"
           class="small text-primary text-decoration-none">
            Forgot password?
        </a>
    </div>

    <div class="d-grid mb-2">
        <button type="submit" class="btn btn-auth btn-lg">
            <i class="bi bi-box-arrow-in-right me-2"></i>Sign In
        </button>
    </div>
</form>

<div class="auth-divider">or</div>

<div class="auth-footer">
    Don't have an account?
    <a asp-page="./Register">Create one free</a>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function togglePassword(inputId, btn) {
            var input = document.getElementById(inputId);
            var icon  = btn.querySelector('i');
            if (input.type === 'password') {
                input.type = 'text';
                icon.className = 'bi bi-eye-slash';
            } else {
                input.type = 'password';
                icon.className = 'bi bi-eye';
            }
        }
    </script>
}