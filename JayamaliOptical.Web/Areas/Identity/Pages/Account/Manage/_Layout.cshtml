@{
    Layout = "/Areas/Identity/Pages/_Layout.cshtml";
}

<style>
    .manage-nav .nav-link {
        color: #444;
        border-radius: 10px;
        padding: 10px 14px;
        font-size: 0.9rem;
        font-weight: 500;
        transition: all 0.2s;
        margin-bottom: 2px;
    }

        .manage-nav .nav-link:hover {
            background: #f0f6ff;
            color: #1978bc;
        }

        .manage-nav .nav-link.active {
            background: linear-gradient(135deg, #1978bc, #26a4e0);
            color: white !important;
            box-shadow: 0 4px 14px rgba(25,120,188,0.25);
        }

            .manage-nav .nav-link.active i {
                color: white !important;
            }

    .account-sidebar {
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 4px 24px rgba(0,0,0,0.07);
    }

    .sidebar-avatar {
        width: 64px;
        height: 64px;
        border-radius: 50%;
        background: linear-gradient(135deg, #1978bc, #26a4e0);
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.8rem;
        font-weight: 700;
        margin: 0 auto 10px;
    }

    .quick-link-btn {
        border-radius: 8px;
        font-size: 0.82rem;
        font-weight: 600;
        padding: 8px 12px;
        transition: all 0.2s;
    }

        .quick-link-btn:hover {
            transform: translateX(3px);
        }
</style>

<div class="container py-5" style="min-height: 70vh;">
    <div class="row g-4">

        @* ── Left Panel ── *@
        <div class="col-md-3">
            <div class="account-sidebar bg-white">

                @* User Avatar Header *@
                <div class="text-center py-4 px-3"
                     style="background: linear-gradient(135deg, #f0f6ff, #e8f5e9);">
                    <div class="sidebar-avatar">
                        @(User.Identity?.Name?.Substring(0, 1).ToUpper() ?? "U")
                    </div>
                    <div class="fw-bold" style="font-size:0.9rem;">@User.Identity?.Name</div>
                    <div class="text-muted" style="font-size:0.75rem;">My Account</div>
                </div>

                @* Nav Links *@
                <div class="px-3 py-3">
                    <p class="text-muted fw-semibold mb-2"
                       style="font-size:0.7rem; letter-spacing:1.5px; text-transform:uppercase;">
                        Settings
                    </p>
                    <nav class="manage-nav nav flex-column">
                        <a class="nav-link @ManageNavPages.IndexNavClass(ViewContext)"
                           asp-page="./Index">
                            <i class="bi bi-person me-2"></i>Profile
                        </a>
                        <a class="nav-link @ManageNavPages.EmailNavClass(ViewContext)"
                           asp-page="./Email">
                            <i class="bi bi-envelope me-2"></i>Email
                        </a>
                        <a class="nav-link @ManageNavPages.ChangePasswordNavClass(ViewContext)"
                           asp-page="./ChangePassword">
                            <i class="bi bi-key me-2"></i>Password
                        </a>
                        <a class="nav-link @ManageNavPages.TwoFactorAuthenticationNavClass(ViewContext)"
                           asp-page="./TwoFactorAuthentication">
                            <i class="bi bi-shield-lock me-2"></i>2-Factor Auth
                        </a>
                        <a class="nav-link @ManageNavPages.PersonalDataNavClass(ViewContext)"
                           asp-page="./PersonalData">
                            <i class="bi bi-database me-2"></i>Personal Data
                        </a>
                    </nav>
                </div>

                @* Quick Links *@
                <div class="px-3 pb-4 border-top pt-3">
                    <p class="text-muted fw-semibold mb-2"
                       style="font-size:0.7rem; letter-spacing:1.5px; text-transform:uppercase;">
                        Quick Links
                    </p>
                    <div class="d-flex flex-column gap-2">
                        <a href="/Dashboard"
                           class="btn btn-outline-primary quick-link-btn text-start">
                            <i class="bi bi-speedometer2 me-2"></i>My Dashboard
                        </a>
                        <a href="/Cart"
                           class="btn btn-outline-success quick-link-btn text-start">
                            <i class="bi bi-cart me-2"></i>My Cart
                        </a>
                        <a href="/"
                           class="btn btn-outline-secondary quick-link-btn text-start">
                            <i class="bi bi-house-door me-2"></i>Back to Home
                        </a>
                    </div>
                </div>

            </div>
        </div>

        @* ── Right Content ── *@
        <div class="col-md-9">
            @RenderBody()
        </div>

    </div>
</div>

@section Scripts {
    @await RenderSectionAsync("Scripts", required: false)
}