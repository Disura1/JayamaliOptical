@{
    Layout = "/Areas/Identity/Pages/_Layout.cshtml";
}

<div class="container py-5">
    <div class="row">
        <div class="col-md-3 mb-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h6 class="card-title mb-3">Account Settings</h6>
                    <nav class="nav nav-pills flex-column">
                        <a class="nav-link @ManageNavPages.IndexNavClass(ViewContext)" asp-page="./Index">
                            <i class="bi bi-person me-2"></i>Profile
                        </a>
                        <a class="nav-link @ManageNavPages.EmailNavClass(ViewContext)" asp-page="./Email">
                            <i class="bi bi-envelope me-2"></i>Email
                        </a>
                        <a class="nav-link @ManageNavPages.ChangePasswordNavClass(ViewContext)" asp-page="./ChangePassword">
                            <i class="bi bi-key me-2"></i>Password
                        </a>
                        <a class="nav-link @ManageNavPages.PersonalDataNavClass(ViewContext)" asp-page="./PersonalData">
                            <i class="bi bi-database me-2"></i>Personal Data
                        </a>
                    </nav>

                    <!-- Quick Links -->
                    <hr />
                    <h6 class="card-title mb-3">Quick Links</h6>
                    <a href="/Dashboard" class="btn btn-outline-primary btn-sm w-100 mb-2">
                        <i class="bi bi-speedometer2 me-1"></i>Dashboard
                    </a>
                    <a href="/Cart" class="btn btn-outline-success btn-sm w-100">
                        <i class="bi bi-shopping-cart me-1"></i>Cart
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-9">
            @RenderBody()
        </div>
    </div>
</div>

@section Scripts {
    @await RenderSectionAsync("Scripts", required: false)
}