@page
@model DeletePersonalDataModel
@{
    ViewData["Title"] = "Delete Account";
}

<div class="card border-0 shadow-sm rounded-4">
    <div class="card-header bg-danger bg-opacity-10 border-bottom px-4 pt-4 pb-3">
        <h5 class="fw-bold mb-0 text-danger">
            <i class="bi bi-exclamation-triangle me-2"></i>Delete Account
        </h5>
        <p class="text-muted small mb-0 mt-1">This action is permanent and cannot be undone</p>
    </div>
    <div class="card-body px-4 py-4">

        <div class="alert alert-danger d-flex gap-3 align-items-start mb-4">
            <i class="bi bi-exclamation-triangle-fill fs-5 mt-1 flex-shrink-0"></i>
            <div>
                <strong>Are you absolutely sure?</strong><br />
                Deleting your account will permanently remove all your personal data,
                order history, and bookings from our system. This cannot be reversed.
            </div>
        </div>

        <form id="delete-user" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            @if (Model.RequirePassword)
            {
                <div class="mb-4">
                    <label asp-for="Input.Password" class="form-label fw-semibold">
                        Confirm with your password
                    </label>
                    <div class="input-group" style="max-width:380px;">
                        <span class="input-group-text bg-white">
                            <i class="bi bi-lock text-muted"></i>
                        </span>
                        <input asp-for="Input.Password" class="form-control"
                               placeholder="Enter your current password" />
                    </div>
                    <span asp-validation-for="Input.Password" class="text-danger small"></span>
                </div>
            }

            <div class="d-flex gap-3">
                <button class="btn btn-danger rounded-pill px-4" type="submit">
                    <i class="bi bi-trash me-2"></i>Yes, Delete My Account
                </button>
                <a asp-page="./PersonalData" class="btn btn-outline-secondary rounded-pill px-4">
                    <i class="bi bi-arrow-left me-2"></i>Cancel
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}