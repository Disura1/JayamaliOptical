@page
@model EmailModel
@{
    ViewData["Title"] = "Manage Email";
}

<partial name="_StatusMessage" for="StatusMessage" />

<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-header bg-transparent border-bottom px-4 pt-4 pb-3">
        <h5 class="fw-bold mb-0">
            <i class="bi bi-envelope me-2 text-primary"></i>Email Address
        </h5>
        <p class="text-muted small mb-0 mt-1">Manage your email address and verification</p>
    </div>
    <div class="card-body px-4 py-4">
        <form id="email-form" method="post" asp-page-handler="SendVerificationEmail">
            <div class="mb-4">
                <label class="form-label fw-semibold text-muted small text-uppercase">Current Email</label>
                <div class="input-group">
                    <span class="input-group-text bg-light">
                        <i class="bi bi-envelope text-muted"></i>
                    </span>
                    <input asp-for="Email" class="form-control bg-light" disabled />
                </div>
                @if (Model.IsEmailConfirmed)
                {
                    <div class="mt-2">
                        <span class="badge bg-success">
                            <i class="bi bi-check-circle me-1"></i>Verified
                        </span>
                    </div>
                }
                else
                {
                    <div class="mt-2 d-flex align-items-center gap-2">
                        <span class="badge bg-warning text-dark">
                            <i class="bi bi-exclamation-circle me-1"></i>Not Verified
                        </span>
                        <button type="submit" class="btn btn-sm btn-outline-primary rounded-pill">
                            <i class="bi bi-send me-1"></i>Send Verification Email
                        </button>
                    </div>
                }
            </div>
        </form>

        <hr />

        <h6 class="fw-bold mb-3">Change Email Address</h6>
        <form id="change-email-form" method="post" asp-page-handler="ChangeEmail">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
            <div class="mb-3">
                <label asp-for="Input.NewEmail" class="form-label fw-semibold text-muted small text-uppercase"></label>
                <div class="input-group">
                    <span class="input-group-text bg-white">
                        <i class="bi bi-envelope-at text-muted"></i>
                    </span>
                    <input asp-for="Input.NewEmail" class="form-control"
                           placeholder="Enter new email address" autocomplete="email" />
                </div>
                <span asp-validation-for="Input.NewEmail" class="text-danger small"></span>
            </div>
            <button id="change-email-button" type="submit" class="btn btn-primary rounded-pill px-4">
                <i class="bi bi-arrow-repeat me-2"></i>Change Email
            </button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}