@page
@model ChangePasswordModel
@{
    ViewData["Title"] = "Change Password";
}

<partial name="_StatusMessage" for="StatusMessage" />

<div class="card border-0 shadow-sm rounded-4">
    <div class="card-header bg-transparent border-bottom px-4 pt-4 pb-3">
        <h5 class="fw-bold mb-0">
            <i class="bi bi-key me-2 text-primary"></i>Change Password
        </h5>
        <p class="text-muted small mb-0 mt-1">Update your account password</p>
    </div>
    <div class="card-body px-4 py-4">
        <form id="change-password-form" method="post" style="max-width:480px;">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <div class="mb-3">
                <label asp-for="Input.OldPassword" class="form-label fw-semibold text-muted small text-uppercase"></label>
                <div class="input-group">
                    <span class="input-group-text bg-white">
                        <i class="bi bi-lock text-muted"></i>
                    </span>
                    <input asp-for="Input.OldPassword" class="form-control"
                           placeholder="Current password" autocomplete="current-password" />
                </div>
                <span asp-validation-for="Input.OldPassword" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.NewPassword" class="form-label fw-semibold text-muted small text-uppercase"></label>
                <div class="input-group">
                    <span class="input-group-text bg-white">
                        <i class="bi bi-lock-fill text-muted"></i>
                    </span>
                    <input asp-for="Input.NewPassword" class="form-control"
                           placeholder="New password" autocomplete="new-password" />
                </div>
                <span asp-validation-for="Input.NewPassword" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Input.ConfirmPassword" class="form-label fw-semibold text-muted small text-uppercase"></label>
                <div class="input-group">
                    <span class="input-group-text bg-white">
                        <i class="bi bi-lock-fill text-muted"></i>
                    </span>
                    <input asp-for="Input.ConfirmPassword" class="form-control"
                           placeholder="Confirm new password" autocomplete="new-password" />
                </div>
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
            </div>

            <button id="update-password-button" type="submit"
                    class="btn btn-primary rounded-pill px-4">
                <i class="bi bi-check-lg me-2"></i>Update Password
            </button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}