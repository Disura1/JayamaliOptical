@model JayamaliOptical.Web.Models.Order
@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Invoice - @Model.OrderNumber</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <style>
        @@media print {
            .no-print {
                display: none !important;
            }

            body {
                -webkit-print-color-adjust: exact;
            }
        }

        body {
            font-family: 'Segoe UI', sans-serif;
        }

        .invoice-header {
            border-bottom: 3px solid #0d6efd;
            padding-bottom: 20px;
            margin-bottom: 30px;
        }

        .invoice-title {
            color: #0d6efd;
            font-weight: bold;
        }

        .footer-note {
            border-top: 1px solid #dee2e6;
            padding-top: 20px;
            margin-top: 30px;
        }
    </style>
</head>
<body>
    <div class="container py-4">

        <!-- Action Buttons -->
        <div class="no-print mb-3 d-flex gap-2">
            <button onclick="window.print()" class="btn btn-primary">
                <i class="fas fa-print me-2"></i>Print Invoice
            </button>
            <button onclick="window.print()" class="btn btn-success">
                <i class="fas fa-download me-2"></i>Download as PDF
            </button>
            <a href="/Admin/Orders/Details/@Model.Id" class="btn btn-secondary">
                <i class="fas fa-arrow-left me-2"></i>Back
            </a>
        </div>

        <!-- Header -->
        <div class="invoice-header">
            <div class="row align-items-center">
                <div class="col-md-6">
                    <h1 class="invoice-title">Jayamali Optical</h1>
                    <p class="mb-0 text-muted">Your Vision, Our Priority</p>
                </div>
                <div class="col-md-6 text-end">
                    <h2 class="text-dark">INVOICE</h2>
                    <p class="mb-0"><strong>Invoice #:</strong> @Model.OrderNumber</p>
                    <p class="mb-0"><strong>Date:</strong> @Model.OrderDate.ToString("dd MMM yyyy")</p>
                    <p class="mb-0">
                        <strong>Status:</strong>
                        <span class="badge @(Model.Status == "Delivered" || Model.Status == "Shipped" ? "bg-success" : Model.Status == "Cancelled" ? "bg-danger" : "bg-warning text-dark")">
                            @Model.Status
                        </span>
                    </p>
                </div>
            </div>
        </div>

        <!-- Bill To -->
        <div class="row mb-4">
            <div class="col-md-6">
                <h5 class="text-muted text-uppercase" style="font-size:0.8rem; letter-spacing:1px;">Bill To</h5>
                <p class="mb-1 fw-bold fs-5">@Model.FirstName @Model.LastName</p>
                <p class="mb-1">@Model.Address</p>
                <p class="mb-1">@Model.City, @Model.PostalCode</p>
                <p class="mb-1"><i class="fas fa-envelope me-1 text-muted"></i> @Model.Email</p>
                <p class="mb-0"><i class="fas fa-phone me-1 text-muted"></i> @Model.PhoneNumber</p>
            </div>
            <div class="col-md-6 text-end">
                <h5 class="text-muted text-uppercase" style="font-size:0.8rem; letter-spacing:1px;">Payment Info</h5>
                <p class="mb-1"><strong>Method:</strong> Cash on Delivery</p>
                @if (Model.ShippedDate.HasValue)
                {
                    <p class="mb-1"><strong>Shipped:</strong> @Model.ShippedDate.Value.ToString("dd MMM yyyy")</p>
                }
                @if (Model.DeliveredDate.HasValue)
                {
                    <p class="mb-0"><strong>Delivered:</strong> @Model.DeliveredDate.Value.ToString("dd MMM yyyy")</p>
                }
            </div>
        </div>

        <!-- Order Items -->
        <table class="table table-bordered">
            <thead style="background-color:#0d6efd; color:white;">
                <tr>
                    <th>#</th>
                    <th>Description</th>
                    <th class="text-end">Unit Price</th>
                    <th class="text-center">Qty</th>
                    <th class="text-end">Amount</th>
                </tr>
            </thead>
            <tbody>
                @{
                    int i = 1;
                }
                @foreach (var item in Model.OrderItems)
                {
                    <tr>
                        <td>@(i++)</td>
                        <td>@item.ProductName</td>
                        <td class="text-end">Rs. @item.Price.ToString("0.00")</td>
                        <td class="text-center">@item.Quantity</td>
                        <td class="text-end fw-bold">Rs. @item.Total.ToString("0.00")</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <td colspan="3"></td>
                    <td class="text-end fw-bold">Subtotal:</td>
                    <td class="text-end">Rs. @Model.TotalAmount.ToString("0.00")</td>
                </tr>
                <tr>
                    <td colspan="3"></td>
                    <td class="text-end fw-bold">Delivery:</td>
                    <td class="text-end text-success fw-bold">FREE</td>
                </tr>
                <tr style="background-color:#f8f9fa;">
                    <td colspan="3"></td>
                    <td class="text-end fw-bold fs-5">Total:</td>
                    <td class="text-end fw-bold fs-5 text-primary">Rs. @Model.TotalAmount.ToString("0.00")</td>
                </tr>
            </tfoot>
        </table>

        @if (!string.IsNullOrEmpty(Model.OrderNotes))
        {
            <div class="alert alert-light border mt-3">
                <strong>Order Notes:</strong> @Model.OrderNotes
            </div>
        }

        <!-- Footer -->
        <div class="footer-note row">
            <div class="col-md-7">
                <p class="text-muted small mb-1">Thank you for shopping with Jayamali Optical!</p>
                <p class="text-muted small mb-0">For any queries, contact us at <strong>disurasandaruwan0@gmail.com</strong></p>
            </div>
            <div class="col-md-5 text-end">
                <p class="mb-4 mt-3">________________________</p>
                <p class="mb-0 fw-bold">Authorized Signature</p>
                <p class="text-muted small">Jayamali Optical</p>
            </div>
        </div>

    </div>
</body>
</html>