@model JayamaliOptical.Web.Models.Order
@{
    ViewData["Title"] = "Order Details";
    bool hasSavedRx = Model.Prescription != null;
    bool hasUploadedRx = !string.IsNullOrEmpty(Model.PrescriptionImagePath);
}

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Order Details - @Model.OrderNumber</h3>
                <div class="card-tools">
                    <a href="/Admin/Orders/CustomerInvoice/@Model.Id" target="_blank" class="btn btn-info btn-sm">
                        <i class="fas fa-file-invoice me-1"></i>Customer Invoice
                    </a>
                    <a href="/Admin/Orders/PrintInvoice/@Model.Id" target="_blank" class="btn btn-success btn-sm">
                        <i class="fas fa-print me-1"></i>Shop Invoice
                    </a>
                    <a href="/Admin/Orders/UpdateStatus/@Model.Id" class="btn btn-primary btn-sm">
                        <i class="fas fa-edit me-1"></i>Update Status
                    </a>
                    <a href="/Admin/Orders" class="btn btn-default btn-sm">
                        <i class="fas fa-arrow-left me-1"></i>Back
                    </a>
                </div>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6">
                        <h5 class="text-primary mb-3">Order Information</h5>
                        <table class="table table-sm table-borderless">
                            <tr><td width="150"><strong>Order Number:</strong></td><td>@Model.OrderNumber</td></tr>
                            <tr><td><strong>Order Date:</strong></td><td>@Model.OrderDate.ToString("dd MMM yyyy, hh:mm tt")</td></tr>
                            <tr>
                                <td><strong>Status:</strong></td>
                                <td>
                                    @{
                                        var badgeClass = Model.Status switch
                                        {
                                                    "Pending" => "bg-warning",
                                                    "Confirmed" => "bg-info",
                                                    "Processing" => "bg-primary",
                                                    "Shipped" => "bg-success",
                                                    "Delivered" => "bg-success",
                                                    "Cancelled" => "bg-danger",
                                            _ => "bg-secondary"
                                        };
                                    }
                                    <span class="badge @badgeClass">@Model.Status</span>
                                </td>
                            </tr>
                            <tr><td><strong>Shipped Date:</strong></td><td>@(Model.ShippedDate?.ToString("dd MMM yyyy") ?? "-")</td></tr>
                            <tr><td><strong>Delivered Date:</strong></td><td>@(Model.DeliveredDate?.ToString("dd MMM yyyy") ?? "-")</td></tr>
                        </table>
                    </div>

                    <div class="col-md-6">
                        <h5 class="text-primary mb-3">Customer Information</h5>
                        <table class="table table-sm table-borderless">
                            <tr><td width="150"><strong>Name:</strong></td><td>@Model.FirstName @Model.LastName</td></tr>
                            <tr><td><strong>Email:</strong></td><td>@Model.Email</td></tr>
                            <tr><td><strong>Phone:</strong></td><td>@Model.PhoneNumber</td></tr>
                            <tr><td><strong>Address:</strong></td><td>@Model.Address, @Model.City, @Model.PostalCode</td></tr>
                        </table>
                    </div>
                </div>

                <hr />

                <h5 class="text-primary mb-3">Order Items</h5>
                <table class="table table-bordered">
                    <thead class="table-light">
                        <tr><th>Product</th><th>Price</th><th>Quantity</th><th>Total</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.OrderItems)
                        {
                            <tr>
                                <td>@item.ProductName</td>
                                <td>Rs. @item.Price.ToString("0.00")</td>
                                <td>@item.Quantity</td>
                                <td class="fw-bold">Rs. @item.Total.ToString("0.00")</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <th colspan="3" class="text-end">Total Amount:</th>
                            <th class="text-primary">Rs. @Model.TotalAmount.ToString("0.00")</th>
                        </tr>
                    </tfoot>
                </table>

                @* ── Prescription Section ── *@
                @if (hasSavedRx || hasUploadedRx)
                {
                    <hr />
                    <h5 class="text-primary mb-3"><i class="fas fa-file-medical me-2"></i>Prescription Details</h5>
                    <div class="card border-warning mb-3">
                        <div class="card-body">

                            @if (hasSavedRx)
                            {
                                <h6 class="fw-bold text-warning mb-3">Saved Prescription: @Model.Prescription!.Name</h6>
                                <table class="table table-sm table-borderless">
                                    @if (!string.IsNullOrEmpty(Model.Prescription.Description))
                                    {
                                        <tr><td width="180"><strong>Notes:</strong></td><td>@Model.Prescription.Description</td></tr>
                                    }
                                    @if (!string.IsNullOrEmpty(Model.Prescription.RightEyeSphere))
                                    {
                                        <tr>
                                            <td><strong>Right Eye (OD):</strong></td>
                                            <td>
                                                SPH: @Model.Prescription.RightEyeSphere
                                                @if (!string.IsNullOrEmpty(Model.Prescription.RightEyeCylinder))
                                                {
                                                    <text> | CYL: @Model.Prescription.RightEyeCylinder</text>
                                                }
                                                @if (!string.IsNullOrEmpty(Model.Prescription.RightEyeAxis))
                                                {
                                                    <text> | Axis: @Model.Prescription.RightEyeAxis</text>
                                                }
                                                @if (!string.IsNullOrEmpty(Model.Prescription.RightEyeAdd))
                                                {
                                                    <text> | Add: @Model.Prescription.RightEyeAdd</text>
                                                }
                                            </td>
                                        </tr>
                                    }
                                    @if (!string.IsNullOrEmpty(Model.Prescription.LeftEyeSphere))
                                    {
                                        <tr>
                                            <td><strong>Left Eye (OS):</strong></td>
                                            <td>
                                                SPH: @Model.Prescription.LeftEyeSphere
                                                @if (!string.IsNullOrEmpty(Model.Prescription.LeftEyeCylinder))
                                                {
                                                    <text> | CYL: @Model.Prescription.LeftEyeCylinder</text>
                                                }
                                                @if (!string.IsNullOrEmpty(Model.Prescription.LeftEyeAxis))
                                                {
                                                    <text> | Axis: @Model.Prescription.LeftEyeAxis</text>
                                                }
                                                @if (!string.IsNullOrEmpty(Model.Prescription.LeftEyeAdd))
                                                {
                                                    <text> | Add: @Model.Prescription.LeftEyeAdd</text>
                                                }
                                            </td>
                                        </tr>
                                    }
                                    @if (!string.IsNullOrEmpty(Model.Prescription.PupillaryDistance))
                                    {
                                        <tr><td><strong>PD:</strong></td><td>@Model.Prescription.PupillaryDistance</td></tr>
                                    }
                                    @if (!string.IsNullOrEmpty(Model.Prescription.FilePath))
                                    {
                                        <tr>
                                            <td><strong>Attached File:</strong></td>
                                            <td>
                                                <a href="@Model.Prescription.FilePath" target="_blank" class="btn btn-sm btn-outline-primary">
                                                    <i class="fas fa-eye me-1"></i>View File
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </table>
                            }

                            @if (hasUploadedRx)
                            {
                                <h6 class="fw-bold text-warning mb-2">Uploaded Prescription: @Model.PrescriptionFileName</h6>
                                @if (Model.PrescriptionImagePath!.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase))
                                {
                                    <a href="@Model.PrescriptionImagePath" target="_blank" class="btn btn-sm btn-outline-primary">
                                        <i class="fas fa-file-pdf me-1"></i>View PDF
                                    </a>
                                }
                                else
                                {
                                    <img src="@Model.PrescriptionImagePath" alt="Prescription" class="img-fluid rounded border" style="max-height:400px;" />
                                }
                            }

                        </div>
                    </div>
                }
                else if (Model.OrderItems.Any(oi => oi.Product != null && oi.Product.RequiresPrescription))
                {
                    <div class="alert alert-danger mt-3">
                        <i class="fas fa-exclamation-triangle me-2"></i>
                        <strong>Warning:</strong> This order has prescription products but no prescription was attached.
                    </div>
                }

                @if (!string.IsNullOrEmpty(Model.OrderNotes))
                {
                    <div class="alert alert-info">
                        <strong>Order Notes:</strong>
                        <p class="mb-0">@Model.OrderNotes</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>