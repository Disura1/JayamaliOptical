@model JayamaliOptical.Web.Models.Order
@{
    ViewData["Title"] = "Order Details";
}

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Order Details - @Model.OrderNumber</h3>
                <div class="card-tools">
                    <a href="/Admin/Orders/PrintInvoice/@Model.Id" target="_blank" class="btn btn-success btn-sm">
                        <i class="fas fa-print me-1"></i>Print Invoice
                    </a>
                    <a href="/Admin/Orders/UpdateStatus/@Model.Id" class="btn btn-primary btn-sm">
                        <i class="fas fa-edit me-1"></i>Update Status
                    </a>
                    <a href="/Admin/Orders" class="btn btn-default btn-sm">
                        <i class="fas fa-arrow-left me-1"></i>Back
                    </a>
                </div>
            </div>
            <div class="card-body">
                <div class="row">
                    <!-- Order Information -->
                    <div class="col-md-6">
                        <h5 class="text-primary mb-3">Order Information</h5>
                        <table class="table table-sm table-borderless">
                            <tr>
                                <td width="150"><strong>Order Number:</strong></td>
                                <td>@Model.OrderNumber</td>
                            </tr>
                            <tr>
                                <td><strong>Order Date:</strong></td>
                                <td>@Model.OrderDate.ToString("dd MMM yyyy, hh:mm tt")</td>
                            </tr>
                            <tr>
                                <td><strong>Status:</strong></td>
                                <td>
                                    @{
                                        var badgeClass = Model.Status switch
                                        {
                                                    "Pending" => "bg-warning",
                                                    "Confirmed" => "bg-info",
                                                    "Processing" => "bg-primary",
                                                    "Shipped" => "bg-success",
                                                    "Delivered" => "bg-success",
                                                    "Cancelled" => "bg-danger",
                                            _ => "bg-secondary"
                                        };
                                    }
                                    <span class="badge @badgeClass">@Model.Status</span>
                                </td>
                            </tr>
                            <tr>
                                <td><strong>Shipped Date:</strong></td>
                                <td>@(Model.ShippedDate?.ToString("dd MMM yyyy") ?? "-")</td>
                            </tr>
                            <tr>
                                <td><strong>Delivered Date:</strong></td>
                                <td>@(Model.DeliveredDate?.ToString("dd MMM yyyy") ?? "-")</td>
                            </tr>
                        </table>
                    </div>

                    <!-- Customer Information -->
                    <div class="col-md-6">
                        <h5 class="text-primary mb-3">Customer Information</h5>
                        <table class="table table-sm table-borderless">
                            <tr>
                                <td width="150"><strong>Name:</strong></td>
                                <td>@Model.FirstName @Model.LastName</td>
                            </tr>
                            <tr>
                                <td><strong>Email:</strong></td>
                                <td>@Model.Email</td>
                            </tr>
                            <tr>
                                <td><strong>Phone:</strong></td>
                                <td>@Model.PhoneNumber</td>
                            </tr>
                            <tr>
                                <td><strong>Address:</strong></td>
                                <td>@Model.Address, @Model.City, @Model.PostalCode</td>
                            </tr>
                        </table>
                    </div>
                </div>

                <hr />

                <!-- Order Items -->
                <h5 class="text-primary mb-3">Order Items</h5>
                <table class="table table-bordered">
                    <thead class="table-light">
                        <tr>
                            <th>Product</th>
                            <th>Price</th>
                            <th>Quantity</th>
                            <th>Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.OrderItems)
                        {
                            <tr>
                                <td>@item.ProductName</td>
                                <td>Rs. @item.Price.ToString("0.00")</td>
                                <td>@item.Quantity</td>
                                <td class="fw-bold">Rs. @item.Total.ToString("0.00")</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <th colspan="3" class="text-end">Total Amount:</th>
                            <th class="text-primary">Rs. @Model.TotalAmount.ToString("0.00")</th>
                        </tr>
                    </tfoot>
                </table>

                @if (!string.IsNullOrEmpty(Model.OrderNotes))
                {
                    <div class="alert alert-info">
                        <strong>Order Notes:</strong>
                        <p class="mb-0">@Model.OrderNotes</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>