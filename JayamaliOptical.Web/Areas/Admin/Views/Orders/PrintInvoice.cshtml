@model JayamaliOptical.Web.Models.Order
@using JayamaliOptical.Web.Services
@{
    Layout = null;
    bool hasSavedRx = Model.Prescription != null;
    bool hasUploadedRx = !string.IsNullOrEmpty(Model.PrescriptionImagePath);
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Shop Invoice - @Model.OrderNumber</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <style>
        @@media print {
            .no-print { display: none !important; }
            body { -webkit-print-color-adjust: exact; }
        }
        .invoice-header { border-bottom: 3px solid #0d6efd; padding-bottom: 20px; margin-bottom: 30px; }
        .invoice-title { color: #0d6efd; font-weight: bold; }
        .rx-box { border: 2px solid #ffc107; border-radius: 8px; padding: 16px; background: #fffbf0; }
        .rx-image { max-height: 350px; border: 1px solid #dee2e6; border-radius: 6px; }
        .shop-badge { background: #dc3545; color: #fff; padding: 4px 10px; border-radius: 4px; font-size: 0.75rem; font-weight: bold; letter-spacing: 1px; }
    </style>
</head>
<body>
<div class="container py-4">

        <div class="no-print mb-3 d-flex gap-2">
            <button onclick="window.print()" class="btn btn-primary">
                <i class="fas fa-print me-2"></i>Print Invoice
            </button>
            <button onclick="window.print()" class="btn btn-success">
                <i class="fas fa-download me-2"></i>Download as PDF
            </button>
            <a href="/Admin/Orders/CustomerInvoice/@Model.Id" target="_blank" class="btn btn-info">
                <i class="fas fa-file-invoice me-2"></i>Customer Invoice
            </a>
            <a href="/Admin/Orders/Details/@Model.Id" class="btn btn-secondary">
                <i class="fas fa-arrow-left me-2"></i>Back
            </a>
        </div>

    <div class="invoice-header">
        <div class="row align-items-center">
            <div class="col-md-6">
                <h1 class="invoice-title">Jayamali Optical</h1>
                <p class="mb-0 text-muted">Your Vision, Our Priority</p>
            </div>
            <div class="col-md-6 text-end">
                <span class="shop-badge">SHOP COPY</span>
                <h3 class="mt-2">WORK ORDER</h3>
                <p class="mb-0"><strong>Order #:</strong> @Model.OrderNumber</p>
                <p class="mb-0"><strong>Date:</strong> @Model.OrderDate.ToString("dd MMM yyyy, hh:mm tt")</p>
                <p class="mb-0">
                    <strong>Status:</strong>
                    <span class="badge @(Model.Status == "Delivered" || Model.Status == "Shipped" ? "bg-success" : Model.Status == "Cancelled" ? "bg-danger" : "bg-warning text-dark")">
                        @Model.Status
                    </span>
                </p>
            </div>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-md-6">
            <h5>Customer:</h5>
            <p class="mb-1"><strong>@Model.FirstName @Model.LastName</strong></p>
            <p class="mb-1">@Model.Address, @Model.City, @Model.PostalCode</p>
            <p class="mb-1"><i class="fas fa-envelope me-1"></i> @Model.Email</p>
            <p class="mb-0"><i class="fas fa-phone me-1"></i> @Model.PhoneNumber</p>
        </div>
    </div>

    <h5 class="text-primary mb-2">Order Items</h5>
    <table class="table table-bordered mb-4">
        <thead class="table-light">
            <tr><th>#</th><th>Product</th><th>Price</th><th>Qty</th><th>Total</th><th>Rx?</th></tr>
        </thead>
        <tbody>
            @{ int rowNum = 1; }
            @foreach (var item in Model.OrderItems)
            {
                <tr>
                    <td>@(rowNum++)</td>
                    <td>@item.ProductName</td>
                    <td>Rs. @item.Price.ToString("0.00")</td>
                    <td>@item.Quantity</td>
                    <td class="fw-bold">Rs. @item.Total.ToString("0.00")</td>
                    <td>
                        @if (item.Product != null && item.Product.RequiresPrescription)
                        {
                            <span class="badge bg-warning text-dark">Rx</span>
                        }
                        else
                        {
                            <text>-</text>
                        }
                    </td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr class="table-light">
                <th colspan="4" class="text-end">Total Amount:</th>
                <th class="text-primary" colspan="2">Rs. @Model.TotalAmount.ToString("0.00")</th>
            </tr>
        </tfoot>
    </table>

    @if (hasSavedRx || hasUploadedRx)
    {
        <h5 class="text-primary mb-2"><i class="fas fa-file-medical me-2"></i>Prescription</h5>
        <div class="rx-box mb-4">

            @if (hasSavedRx)
            {
                <h6 class="fw-bold mb-3">Saved Prescription: @Model.Prescription!.Name</h6>
                <div class="row">
                    <div class="col-md-6">
                        <table class="table table-sm table-bordered">
                            <thead class="table-warning">
                                <tr><th>Eye</th><th>SPH</th><th>CYL</th><th>Axis</th><th>Add</th></tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td><strong>OD (R)</strong></td>
                                    <td>@(Model.Prescription.RightEyeSphere ?? "-")</td>
                                    <td>@(Model.Prescription.RightEyeCylinder ?? "-")</td>
                                    <td>@(Model.Prescription.RightEyeAxis ?? "-")</td>
                                    <td>@(Model.Prescription.RightEyeAdd ?? "-")</td>
                                </tr>
                                <tr>
                                    <td><strong>OS (L)</strong></td>
                                    <td>@(Model.Prescription.LeftEyeSphere ?? "-")</td>
                                    <td>@(Model.Prescription.LeftEyeCylinder ?? "-")</td>
                                    <td>@(Model.Prescription.LeftEyeAxis ?? "-")</td>
                                    <td>@(Model.Prescription.LeftEyeAdd ?? "-")</td>
                                </tr>
                            </tbody>
                        </table>
                        @if (!string.IsNullOrEmpty(Model.Prescription.PupillaryDistance))
                        {
                            <p class="mb-1"><strong>PD:</strong> @Model.Prescription.PupillaryDistance</p>
                        }
                        @if (!string.IsNullOrEmpty(Model.Prescription.Description))
                        {
                            <p class="mb-0"><strong>Notes:</strong> @Model.Prescription.Description</p>
                        }
                    </div>
                    @if (!string.IsNullOrEmpty(Model.Prescription.FilePath))
                    {
                        <div class="col-md-6 text-center">
                            @if (Model.Prescription.FilePath.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase))
                            {
                                <a href="@Model.Prescription.FilePath" target="_blank" class="btn btn-outline-primary">
                                    <i class="fas fa-file-pdf me-1"></i>View Attached PDF
                                </a>
                            }
                            else
                            {
                                <img src="@Model.Prescription.FilePath" alt="Prescription" class="rx-image img-fluid" />
                            }
                        </div>
                    }
                </div>
            }

            @if (hasUploadedRx)
            {
                <h6 class="fw-bold mb-2 @(hasSavedRx ? "mt-3" : "")">Uploaded Prescription: @Model.PrescriptionFileName</h6>
                @if (Model.PrescriptionImagePath!.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase))
                {
                    <a href="@Model.PrescriptionImagePath" target="_blank" class="btn btn-outline-primary">
                        <i class="fas fa-file-pdf me-1"></i>Open PDF
                    </a>
                }
                else
                {
                    <div class="text-center">
                        <img src="@Model.PrescriptionImagePath" alt="Uploaded Prescription" class="rx-image img-fluid" />
                    </div>
                }
            }

        </div>
    }

    @if (!string.IsNullOrEmpty(Model.OrderNotes))
    {
        <div class="alert alert-info">
            <strong>Order Notes:</strong> @Model.OrderNotes
        </div>
    }

    <div class="row mt-4 pt-3 border-top">
        <div class="col-6">
            <p class="text-muted small mb-0">Printed: @TimeHelper.Now.ToString("dd MMM yyyy, hh:mm tt")</p>
        </div>
        <div class="col-6 text-end">
            <p class="mb-0 fw-bold">Jayamali Optical — Shop Copy</p>
        </div>
    </div>
</div>
</body>
</html>