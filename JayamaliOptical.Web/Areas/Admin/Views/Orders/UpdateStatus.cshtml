@model JayamaliOptical.Web.Models.Order
@{
    ViewData["Title"] = "Update Order Status";
    var statuses = ViewBag.Statuses as string[];
}

<div class="row">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Update Order Status - @Model.OrderNumber</h3>
            </div>
            <form action="/Admin/Orders/UpdateStatus/@Model.Id" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label">Current Status</label>
                        <input type="text" class="form-control" value="@Model.Status" readonly />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">New Status <span class="text-danger">*</span></label>
                        <select name="status" class="form-control" required>
                            @foreach (var status in statuses)
                            {
                                <option value="@status" selected="@(status == Model.Status)">@status</option>
                            }
                        </select>
                    </div>

                    <div class="alert alert-info">
                        <h6><i class="fas fa-info-circle me-2"></i>Status Flow:</h6>
                        <ol class="mb-0">
                            <li><strong>Pending</strong> - Order placed, awaiting confirmation</li>
                            <li><strong>Confirmed</strong> - Order confirmed by admin</li>
                            <li><strong>Processing</strong> - Preparing order for shipment</li>
                            <li><strong>Shipped</strong> - Order dispatched to customer</li>
                            <li><strong>Delivered</strong> - Order received by customer</li>
                            <li><strong>Cancelled</strong> - Order cancelled</li>
                        </ol>
                    </div>
                </div>
                <div class="card-footer">
                    <button type="submit" class="btn btn-primary">Update Status</button>
                    <a href="/Admin/Orders/Details/@Model.Id" class="btn btn-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>