<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Admin — Jayamali Optical</title>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Source+Sans+Pro:300,400,400i,700&display=fallback">
    <link rel="stylesheet" href="~/plugins/fontawesome-free/css/all.min.css">
    <link rel="stylesheet" href="~/dist/css/adminlte.min.css">
    <style>
        /* ── Fixed layout: only content scrolls ── */
        body.sidebar-mini .main-sidebar,
        body.sidebar-mini .main-header {
            position: fixed !important;
        }

        body.sidebar-mini .content-wrapper,
        body.sidebar-mini .main-footer {
            margin-left: 250px;
        }

        body.sidebar-mini.sidebar-collapse .content-wrapper,
        body.sidebar-mini.sidebar-collapse .main-footer {
            margin-left: 4.6rem;
        }

        .main-sidebar {
            top: 0;
            left: 0;
            bottom: 0;
            height: 100vh !important;
            overflow-y: auto;
            z-index: 1038;
            display: flex;
            flex-direction: column;
        }
            /* Sidebar scrollbar styling */
            .main-sidebar::-webkit-scrollbar {
                width: 4px;
            }

            .main-sidebar::-webkit-scrollbar-track {
                background: transparent;
            }

            .main-sidebar::-webkit-scrollbar-thumb {
                background: rgba(255,255,255,0.2);
                border-radius: 2px;
            }

        .main-header {
            top: 0;
            left: 0;
            right: 0;
            z-index: 1037;
        }

        .content-wrapper {
            min-height: calc(100vh - 57px - 57px);
            overflow-y: auto;
        }

        /* ── Brand logo area ── */
        .brand-link {
            display: flex !important;
            align-items: center;
            gap: 10px;
            padding: 14px 16px !important;
            border-bottom: 1px solid rgba(255,255,255,0.1) !important;
            text-decoration: none !important;
        }

        .brand-logo-img {
            width: 36px;
            height: 36px;
            object-fit: contain;
            flex-shrink: 0;
        }

        .brand-text-custom {
            font-size: 1.15rem !important;
            font-weight: 800 !important;
            color: #26a4e0 !important;
            letter-spacing: 0.3px;
            white-space: nowrap;
        }

        /* ── Sidebar: logout at bottom ── */
        .sidebar-nav-wrapper {
            flex: 1;
            display: flex;
            flex-direction: column;
            overflow-y: auto;
            padding-bottom: 10px;
        }

            .sidebar-nav-wrapper .nav-sidebar {
                flex: 1;
            }

        .sidebar-logout {
            padding: 12px 16px;
            border-top: 1px solid rgba(255,255,255,0.1);
            margin-top: auto;
        }

        .sidebar-credit {
            padding: 8px 16px 12px;
            font-size: 0.68rem;
            color: rgba(255,255,255,0.35);
            text-align: center;
            line-height: 1.5;
        }

            .sidebar-credit a {
                color: rgba(255,255,255,0.55) !important;
                font-weight: 600;
                text-decoration: none;
            }

                .sidebar-credit a:hover {
                    color: #26a4e0 !important;
                }

        /* ── Navbar ── */
        .main-header .navbar-nav.ms-auto {
            margin-left: auto !important;
        }

        /* ── Info box: show full text on hover ── */
        .info-box {
            overflow: visible !important;
            position: relative;
            cursor: default;
        }

        .info-box-content {
            overflow: hidden;
            white-space: nowrap;
            text-overflow: ellipsis;
            transition: all 0.2s;
        }

        .info-box:hover {
            z-index: 100;
            box-shadow: 0 8px 24px rgba(0,0,0,0.15) !important;
            transform: translateY(-2px);
        }

            .info-box:hover .info-box-text {
                white-space: normal !important;
                word-break: break-word;
            }

            .info-box:hover .info-box-content {
                overflow: visible;
                white-space: normal;
            }
    </style>
</head>
<body class="hold-transition sidebar-mini layout-fixed">
    <div class="wrapper">

        @* ── Top Navbar ── *@
        <nav class="main-header navbar navbar-expand navbar-white navbar-light">
            @* Left: toggle *@
            <ul class="navbar-nav">
                <li class="nav-item">
                    <a class="nav-link" data-widget="pushmenu" href="#" role="button">
                        <i class="fas fa-bars"></i>
                    </a>
                </li>
                <li class="nav-item d-none d-sm-inline-block">
                    <span class="nav-link text-muted" style="font-size:1.1rem;">
                        <i class="fas fa-tachometer-alt mx-2 "></i>Admin Panel
                    </span>
                </li>
            </ul>

            @* Right: visit website *@
            <ul class="navbar-nav ms-auto me-3">
                <li class="nav-item">
                    <a href="/" target="_blank"
                       class="btn btn-outline-primary btn-sm rounded-pill px-3">
                        <i class="fas fa-globe mr-2"></i>Visit Website
                    </a>
                </li>
            </ul>
        </nav>

        @* ── Sidebar ── *@
        <aside class="main-sidebar sidebar-dark-primary elevation-4">

            @* Brand *@
            <a href="/Admin/Home" class="brand-link">
                <img src="~/images/LogoOnly.png"
                     alt="Logo" class="brand-logo-img"
                     onerror="this.style.display='none'" />
                <span class="brand-text-custom">Jayamali Optical</span>
            </a>

            @* Sidebar content *@
            <div class="sidebar">
                <div class="sidebar-nav-wrapper">
                    <nav class="mt-2">
                        <ul class="nav nav-pills nav-sidebar flex-column"
                            data-widget="treeview" role="menu">
                            <li class="nav-item">
                                <a href="/Admin/Home" class="nav-link">
                                    <i class="nav-icon fas fa-tachometer-alt"></i><p>Dashboard</p>
                                </a>
                            </li>
                            <li class="nav-header">CATALOGUE</li>
                            <li class="nav-item">
                                <a href="/Admin/Categories" class="nav-link">
                                    <i class="nav-icon fas fa-tags"></i><p>Categories</p>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a href="/Admin/Products" class="nav-link">
                                    <i class="nav-icon fas fa-box"></i><p>Products</p>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a href="/Admin/Services" class="nav-link">
                                    <i class="nav-icon fas fa-concierge-bell"></i><p>Services</p>
                                </a>
                            </li>
                            <li class="nav-header">TRANSACTIONS</li>
                            <li class="nav-item">
                                <a href="/Admin/Orders" class="nav-link">
                                    <i class="nav-icon fas fa-shopping-bag"></i><p>Orders</p>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a href="/Admin/Bookings" class="nav-link">
                                    <i class="nav-icon fas fa-calendar-check"></i><p>Appointments</p>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a href="/Admin/Customers" class="nav-link">
                                    <i class="nav-icon fas fa-users"></i><p>Customers</p>
                                </a>
                            </li>
                            <li class="nav-header">CONTENT</li>
                            <li class="nav-item">
                                <a href="/Admin/Offers" class="nav-link">
                                    <i class="nav-icon fas fa-percentage"></i><p>Offer Slides</p>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a href="/Admin/Gallery" class="nav-link">
                                    <i class="nav-icon fas fa-images"></i><p>Gallery</p>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a href="/Admin/Brands" class="nav-link">
                                    <i class="nav-icon fas fa-store"></i><p>Brands</p>
                                </a>
                            </li>
                            <li class="nav-header">COMMUNICATION</li>
                            <li class="nav-item">
                                <a href="/Admin/Messages" class="nav-link">
                                    <i class="nav-icon fas fa-envelope"></i><p>Messages</p>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a href="/Admin/Reviews" class="nav-link">
                                    <i class="nav-icon fas fa-comments"></i><p>Reviews</p>
                                </a>
                            </li>
                            <li class="nav-header">SETTINGS</li>
                            <li class="nav-item">
                                <a href="/Admin/SiteSettings" class="nav-link">
                                    <i class="nav-icon fas fa-cog"></i><p>Site Settings</p>
                                </a>
                            </li>
                        </ul>
                    </nav>

                    @* Logout at bottom *@
                    <div class="sidebar-logout">
                        <form action="/Admin/Account/Logout" method="post">
                            @Html.AntiForgeryToken()
                            <button type="submit"
                                    class="btn btn-outline-danger btn-block btn-sm w-100"
                                    style="border-radius:8px;">
                                <i class="fas fa-sign-out-alt me-2"></i>Logout
                            </button>
                        </form>
                    </div>

                    @* Credit *@
                    <div class="sidebar-credit">
                        Designed &amp; Developed by<br />
                        <a href="https://www.linkedin.com/in/disura-sandaruwan-649a422b8/"
                           target="_blank">Disura Sandaruwan</a>
                    </div>

                </div>
            </div>
        </aside>

        @* ── Content Wrapper ── *@
        <div class="content-wrapper">
            <div class="content-header">
                <div class="container-fluid mt-5 ">
                    <div class="row mb-2">
                        <div class="col-sm-6">
                            <h1 class="m-0">@ViewData["Title"]</h1>
                        </div>
                    </div>
                </div>
            </div>
            <section class="content">
                <div class="container-fluid">
                    @RenderBody()
                </div>
            </section>
        </div>

        @* ── Footer ── *@
        <footer class="main-footer">
            <strong>Copyright &copy; 2026 <a href="/">Jayamali Optical</a>.</strong>
            All rights reserved.
            <div class="float-right d-none d-sm-inline-block">
                Website Designed &amp; Developed by
                <a href="https://www.linkedin.com/in/disura-sandaruwan-649a422b8/"
                   target="_blank" class="fw-bolder text-decoration-none">Disura Sandaruwan</a>
            </div>
        </footer>

    </div>

    <script src="~/plugins/jquery/jquery.min.js"></script>
    <script src="~/plugins/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/dist/js/adminlte.min.js"></script>
    @RenderSection("Scripts", required: false)

    <script>
        // Mark active sidebar link based on current URL
        (function () {
            var path = window.location.pathname.toLowerCase();
            var links = document.querySelectorAll('.nav-sidebar .nav-link');
            links.forEach(function (link) {
                var href = link.getAttribute('href');
                if (!href) return;
                var linkPath = href.toLowerCase().split('?')[0];
                // Exact match OR current path starts with link path (for sub-pages)
                if (linkPath !== '/admin/home' && path.startsWith(linkPath)) {
                    link.classList.add('active');
                    var parentItem = link.closest('.nav-item');
                    if (parentItem) parentItem.classList.add('menu-open');
                } else if (linkPath === '/admin/home' && (path === '/admin/home' || path === '/admin/home/index' || path === '/admin')) {
                    link.classList.add('active');
                }
            });
        })();
    </script>
</body>
</html>