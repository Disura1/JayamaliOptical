@model IEnumerable<JayamaliOptical.Web.Models.Review>
@{
    ViewData["Title"] = "Reviews";
    var filter = ViewBag.Filter as string ?? "All";
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@* Stats *@
<div class="row mb-4">
    <div class="col-md-3">
        <div class="small-box bg-warning">
            <div class="inner"><h3>@ViewBag.PendingCount</h3><p>Pending Approval</p></div>
            <div class="icon"><i class="fas fa-clock"></i></div>
            <a href="/Admin/Reviews?filter=Pending" class="small-box-footer">View <i class="fas fa-arrow-circle-right"></i></a>
        </div>
    </div>
    <div class="col-md-3">
        <div class="small-box bg-success">
            <div class="inner"><h3>@ViewBag.ApprovedCount</h3><p>Approved</p></div>
            <div class="icon"><i class="fas fa-check"></i></div>
            <a href="/Admin/Reviews?filter=Approved" class="small-box-footer">View <i class="fas fa-arrow-circle-right"></i></a>
        </div>
    </div>
    <div class="col-md-3">
        <div class="small-box bg-primary">
            <div class="inner"><h3>@ViewBag.FeaturedCount</h3><p>Featured</p></div>
            <div class="icon"><i class="fas fa-star"></i></div>
            <a href="/Admin/Reviews?filter=Featured" class="small-box-footer">View <i class="fas fa-arrow-circle-right"></i></a>
        </div>
    </div>
    <div class="col-md-3">
        <div class="small-box bg-info">
            <div class="inner"><h3>@Model.Count()</h3><p>Showing</p></div>
            <div class="icon"><i class="fas fa-comments"></i></div>
            <a href="/Admin/Reviews" class="small-box-footer">View All <i class="fas fa-arrow-circle-right"></i></a>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <h3 class="card-title"><i class="fas fa-comments me-2"></i>Customer Reviews</h3>
        <div class="card-tools">
            <div class="btn-group">
                @foreach (var f in new[] { "All", "Pending", "Approved", "Featured" })
                {
                    <a href="/Admin/Reviews?filter=@f"
                       class="btn btn-sm @(filter == f ? "btn-primary" : "btn-outline-primary")">
                        @f
                    </a>
                }
            </div>
        </div>
    </div>
    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <div class="text-center py-5 text-muted">
                <i class="fas fa-comments fa-3x mb-3"></i>
                <p>No reviews found for this filter.</p>
            </div>
        }
        else
        {
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Patient</th>
                        <th>Rating</th>
                        <th>Review</th>
                        <th>Service</th>
                        <th>Date</th>
                        <th class="text-center">Status</th>
                        <th class="text-center">Featured</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model)
                    {
                        <tr class="@(!r.IsApproved ? "table-warning bg-opacity-25" : "")">
                            <td>
                                <div class="fw-bold">@r.Name</div>
                                @if (!string.IsNullOrEmpty(r.Location))
                                {
                                    <small class="text-muted">
                                        <i class="fas fa-map-marker-alt me-1"></i>@r.Location
                                    </small>
                                }
                            </td>
                            <td>
                                <span style="color:#f59e0b; font-size:1rem;">
                                    @string.Concat(Enumerable.Repeat("★", r.Rating))
                                    @string.Concat(Enumerable.Repeat("☆", 5 - r.Rating))
                                </span>
                                <div style="font-size:0.75rem; color:#888;">@r.Rating / 5</div>
                            </td>
                            <td style="max-width:260px;">
                                <small>@(r.Comment.Length > 120 ? r.Comment.Substring(0, 120) + "…" : r.Comment)</small>
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(r.ServiceType))
                                {
                                    <span class="badge bg-info text-dark">@r.ServiceType</span>
                                }
                                else
                                {

                                    <text>—</text>
                                }
                            </td>
                            <td><small>@r.SubmittedAt.ToString("dd MMM yyyy")</small></td>
                            <td class="text-center align-middle">
                                @if (r.IsApproved)
                                {
                                    <span class="badge bg-success">Approved</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">Pending</span>
                                }
                            </td>
                            <td class="text-center align-middle">
                                <form action="/Admin/Reviews/ToggleFeatured/@r.Id" method="post">
                                    @Html.AntiForgeryToken()
                                    <button type="submit"
                                            class="btn btn-sm @(r.IsFeatured ? "btn-warning" : "btn-outline-secondary")"
                                            title="@(r.IsFeatured ? "Remove from featured" : "Mark as featured")">
                                        <i class="fas fa-star"></i>
                                    </button>
                                </form>
                            </td>
                            <td class="text-center align-middle">
                                <div class="btn-group btn-group-sm">
                                    @if (!r.IsApproved)
                                    {
                                        <form action="/Admin/Reviews/Approve/@r.Id" method="post">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-success" title="Approve">
                                                <i class="fas fa-check"></i>
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form action="/Admin/Reviews/Reject/@r.Id" method="post">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-secondary" title="Unpublish">
                                                <i class="fas fa-eye-slash"></i>
                                            </button>
                                        </form>
                                    }
                                    <form action="/Admin/Reviews/Delete/@r.Id" method="post"
                                          onsubmit="return confirm('Delete this review?')">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-danger" title="Delete">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>