@model JayamaliOptical.Web.Models.ServiceBooking
@using JayamaliOptical.Web.Services
@{
    ViewData["Title"] = "Booking Details";
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h3 class="card-title mb-0">
                    <i class="fas fa-calendar-check mr-2"></i>@Model.BookingNumber
                </h3>
                <div class="d-flex gap-2">
                    <a href="/Admin/Bookings/AppointmentInvoice/@Model.Id"
                       target="_blank" class="btn btn-success btn-sm mr-2">
                        <i class="fas fa-file-invoice mr-1"></i>Invoice
                    </a>
                    <a href="/Admin/Bookings" class="btn btn-secondary btn-sm">
                        <i class="fas fa-arrow-left mr-1"></i>Back
                    </a>
                </div>
            </div>
            <div class="card-body">
                <div class="row g-4">
                    <div class="col-md-6">
                        <h6 class="fw-bold text-muted text-uppercase mb-3">
                            <i class="fas fa-user mr-2"></i>Customer
                        </h6>
                        <table class="table table-sm table-borderless">
                            <tr><th style="width:120px;">Name</th><td>@Model.FirstName @Model.LastName</td></tr>
                            <tr><th>Email</th><td><a href="mailto:@Model.Email">@Model.Email</a></td></tr>
                            <tr><th>Phone</th><td><a href="tel:@Model.PhoneNumber">@Model.PhoneNumber</a></td></tr>
                        </table>
                    </div>
                    <div class="col-md-6">
                        <h6 class="fw-bold text-muted text-uppercase mb-3">
                            <i class="fas fa-calendar mr-2"></i>Appointment
                        </h6>
                        <table class="table table-sm table-borderless">
                            <tr><th style="width:120px;">Service</th><td><strong>@Model.Service?.Name</strong></td></tr>
                            <tr><th>Date</th><td>@Model.AppointmentDate.ToString("dd MMMM yyyy")</td></tr>
                            <tr><th>Time</th><td>@TimeHelper.Today.Add(Model.AppointmentTime).ToString("hh:mm tt")</td></tr>
                            <tr><th>Booked On</th><td>@Model.BookingDate.ToString("dd MMM yyyy, hh:mm tt")</td></tr>
                        </table>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(Model.Notes))
                {
                    <div class="mt-3">
                        <h6 class="fw-bold text-muted text-uppercase">Customer Notes</h6>
                        <div class="bg-light rounded p-3">@Model.Notes</div>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-md-4">
        @* Status Card *@
        <div class="card mb-3">
            <div class="card-header"><h5 class="mb-0">Update Status</h5></div>
            <div class="card-body">
                <form action="/Admin/Bookings/UpdateStatus/@Model.Id" method="post">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Status</label>
                        <select name="status" class="form-select">
                            @foreach (var s in new[] { "Pending", "Confirmed", "Completed", "Cancelled", "NoShow" })
                            {
                                <option value="@s" @(Model.Status == s ? "selected" : "")>@s</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Admin Notes <small class="text-muted">(optional)</small></label>
                        <textarea name="adminNotes" class="form-control" rows="3"
                                  placeholder="Internal notes...">@Model.AdminNotes</textarea>
                    </div>
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="fas fa-save mr-2"></i>Update Status
                    </button>
                </form>
            </div>
        </div>

        @* Danger Zone *@
        <div class="card border-danger">
            <div class="card-body">
                <form action="/Admin/Bookings/Delete/@Model.Id" method="post"
                      onsubmit="return confirm('Permanently delete this booking?')">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-danger w-100 btn-sm">
                        <i class="fas fa-trash mr-2"></i>Delete Booking
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>