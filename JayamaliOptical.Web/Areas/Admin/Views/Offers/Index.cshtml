@model IEnumerable<JayamaliOptical.Web.Models.OfferSlide>
@{
    ViewData["Title"] = "Offer Slides";
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row">

    @* Upload Panel *@
    <div class="col-md-4">
        <div class="card">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0"><i class="fas fa-upload mr-2"></i>Upload New Slide</h5>
            </div>
            <div class="card-body">
                <form action="/Admin/Offers/Upload" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Image File <span class="text-danger">*</span></label>
                        <input type="file" name="imageFile" class="form-control"
                               accept=".jpg,.jpeg,.png,.webp" required
                               onchange="previewImage(this)" />
                        <small class="text-muted">JPG / PNG / WebP · Max 5MB · <strong>1200 × 450 px recommended</strong></small>
                    </div>

                    <div class="mb-2 text-center" id="previewBox" style="display:none;">
                        <img id="previewImg" src="" alt="Preview"
                             class="img-fluid rounded border" style="max-height:140px;" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Caption <small class="text-muted">(optional)</small></label>
                        <input type="text" name="caption" class="form-control"
                               maxlength="100" placeholder="e.g. 50% off on all spectacles" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Link URL <small class="text-muted">(optional)</small></label>
                        <input type="text" name="linkUrl" class="form-control"
                               placeholder="e.g. /Products/Index?categoryId=2" />
                        <small class="text-muted">Where to go when slide is clicked</small>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Display Order</label>
                        <input type="number" name="displayOrder" class="form-control"
                               value="@(Model.Any() ? Model.Max(s => s.DisplayOrder) + 1 : 1)"
                               min="1" />
                        <small class="text-muted">Lower number = shown first</small>
                    </div>

                    <button type="submit" class="btn btn-primary w-100">
                        <i class="fas fa-upload mr-2"></i>Upload Slide
                    </button>
                </form>
            </div>
        </div>

        <div class="card mt-3 border-info">
            <div class="card-body">
                <h6 class="fw-bold text-info"><i class="fas fa-info-circle mr-2"></i>Image Guidelines</h6>
                <ul class="small text-muted mb-0">
                    <li>Recommended size: <strong>1200 × 450 px</strong></li>
                    <li>Aspect ratio: <strong>8:3</strong> (wide banner)</li>
                    <li>Format: JPG or WebP preferred</li>
                    <li>Max file size: 5MB</li>
                    <li>Keep text minimal — use Caption field</li>
                </ul>
            </div>
        </div>
    </div>

    @* Slides List *@
    <div class="col-md-8">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">
                    <i class="fas fa-images mr-2"></i>Current Slides
                    <span class="badge bg-primary ml-2">@Model.Count()</span>
                    <span class="badge bg-success ml-1">@Model.Count(s => s.IsActive) active</span>
                </h5>
            </div>
            <div class="card-body p-0">
                @if (!Model.Any())
                {
                    <div class="text-center py-5 text-muted">
                        <i class="fas fa-images fa-3x mb-3"></i>
                        <p>No slides yet. Upload your first offer image!</p>
                    </div>
                }
                else
                {
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th style="width:130px;">Preview</th>
                                <th>Details</th>
                                <th class="text-center" style="width:70px;">Order</th>
                                <th class="text-center" style="width:80px;">Status</th>
                                <th class="text-center" style="width:80px;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var slide in Model.OrderBy(s => s.DisplayOrder))
                            {
                                <tr class="@(!slide.IsActive ? "table-secondary opacity-50" : "")">
                                    <td>
                                        <img src="@slide.ImagePath" alt="Slide"
                                             class="rounded border"
                                             style="width:120px; height:45px; object-fit:cover;" />
                                    </td>
                                    <td class="align-middle">
                                        <div class="fw-semibold small">
                                            @if (!string.IsNullOrEmpty(slide.Caption))
                                            {
                                                @slide.Caption
                                            }
                                            else
                                            {
                                                <span class="text-muted fst-italic">No caption</span>
                                            }
                                        </div>
                                        @if (!string.IsNullOrEmpty(slide.LinkUrl))
                                        {
                                            <div class="text-muted" style="font-size:0.75rem;">
                                                <i class="fas fa-link me-1"></i>@slide.LinkUrl
                                            </div>
                                        }
                                        <div class="text-muted" style="font-size:0.72rem;">
                                            Added @slide.CreatedDate.ToString("dd MMM yyyy")
                                        </div>
                                    </td>
                                    <td class="align-middle text-center">
                                        <form action="/Admin/Offers/UpdateOrder/@slide.Id" method="post"
                                              class="d-flex align-items-center gap-1">
                                            @Html.AntiForgeryToken()
                                            <input type="number" name="order"
                                                   value="@slide.DisplayOrder"
                                                   class="form-control form-control-sm text-center"
                                                   style="width:52px;" min="1"
                                                   onchange="this.form.submit()" />
                                        </form>
                                    </td>
                                    <td class="align-middle text-center">
                                        <form action="/Admin/Offers/ToggleActive/@slide.Id" method="post">
                                            @Html.AntiForgeryToken()
                                            <button type="submit"
                                                    class="btn btn-sm @(slide.IsActive ? "btn-success" : "btn-secondary")"
                                                    title="@(slide.IsActive ? "Click to hide" : "Click to show")">
                                                <i class="fas fa-@(slide.IsActive ? "eye" : "eye-slash")"></i>
                                            </button>
                                        </form>
                                    </td>
                                    <td class="align-middle text-center">
                                        <form action="/Admin/Offers/Delete/@slide.Id" method="post"
                                              onsubmit="return confirm('Delete this slide?')">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-danger btn-sm">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function previewImage(input) {
            var box = document.getElementById('previewBox');
            var img = document.getElementById('previewImg');
            if (input.files && input.files[0]) {
                var reader = new FileReader();
                reader.onload = function(e) {
                    img.src = e.target.result;
                    box.style.display = 'block';
                };
                reader.readAsDataURL(input.files[0]);
            }
        }
    </script>
}