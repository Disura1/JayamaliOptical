@model JayamaliOptical.Web.Models.Category
@{
    ViewData["Title"] = "Edit Category";
}

<div class="row">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Edit Category</h3>
            </div>
            <form action="/Admin/Categories/Edit/@Model.Id" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="Id" value="@Model.Id" />
                <div class="card-body">
                    <div class="form-group">
                        <label>Category Name</label>
                        <input type="text" name="Name" class="form-control" value="@Model.Name" required />
                    </div>

                    <div class="form-group">
                        <label>Description</label>
                        <textarea name="Description" class="form-control">@Model.Description</textarea>
                    </div>

                    <div class="form-group form-check">
                        <input type="checkbox" name="IsActive" value="true" class="form-check-input" @(Model.IsActive ? "checked" : "") />
                        <input type="hidden" name="IsActive" value="false" />
                        <label class="form-check-label">Active</label>
                    </div>
                </div>
                <div class="card-footer">
                    <button type="submit" class="btn btn-primary">Save</button>
                    <a href="/Admin/Categories" class="btn btn-default">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>