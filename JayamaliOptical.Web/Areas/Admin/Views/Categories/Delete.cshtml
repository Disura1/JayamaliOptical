@model JayamaliOptical.Web.Models.Category
@{
    ViewData["Title"] = "Delete Category";
}

<div class="row">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Delete Category</h3>
            </div>
            <div class="card-body">
                <h4>Are you sure you want to delete this category?</h4>
                <hr />
                <p><strong>Name:</strong> @Model.Name</p>
                <p><strong>Description:</strong> @Model.Description</p>

                <form action="/Admin/Categories/Delete/@Model.Id" method="post" id="deleteForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />
                    <button type="submit" class="btn btn-danger" id="deleteBtn">Yes, Delete</button>
                    <a href="/Admin/Categories" class="btn btn-default">Cancel</a>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    document.getElementById('deleteForm').addEventListener('submit', function(e) {
        console.log('Delete form submitting...');
        console.log('Action:', this.action);
    });
</script>