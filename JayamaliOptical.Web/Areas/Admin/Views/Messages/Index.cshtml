@model IEnumerable<JayamaliOptical.Web.Models.ContactMessage>
@{
    ViewData["Title"] = "Contact Messages";
}

@if (ViewBag.UnreadCount > 0)
{
    <div class="alert alert-info">
        <i class="fas fa-envelope me-2"></i>
        <strong>@ViewBag.UnreadCount new message(s)</strong> since your last visit.
    </div>
}

<div class="card">
    <div class="card-header">
        <h3 class="card-title"><i class="fas fa-envelope me-2"></i>Contact Messages (@Model.Count())</h3>
    </div>
    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <div class="text-center py-5 text-muted">
                <i class="fas fa-inbox fa-4x mb-3"></i>
                <h5>No messages yet</h5>
                <p>Messages from the Contact Us form will appear here.</p>
            </div>
        }
        else
        {
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>From</th>
                        <th>Subject</th>
                        <th>Message</th>
                        <th>Phone</th>
                        <th>Received</th>
                        <th class="text-center">Reply</th>
                        <th class="text-center">Delete</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var msg in Model)
                    {
                        <tr>
                            <td>
                                <div class="fw-bold">@msg.Name</div>
                                <small class="text-muted">@msg.Email</small>
                            </td>
                            <td><span class="badge bg-primary">@(msg.Subject ?? "General")</span></td>
                            <td style="max-width:300px;">
                                <small class="text-truncate d-block" style="max-width:280px;" title="@msg.Message">
                                    @msg.Message
                                </small>
                            </td>
                            <td><small>@(msg.Phone ?? "—")</small></td>
                            <td><small>@msg.SentAt.ToString("dd MMM yyyy, hh:mm tt")</small></td>
                            <td class="text-center">
                                <a href="mailto:@msg.Email?subject=Re: @msg.Subject&body=Dear @msg.Name,"
                                   class="btn btn-success btn-sm" title="Reply">
                                    <i class="fas fa-reply"></i>
                                </a>
                            </td>
                            <td class="text-center">
                                <form action="/Admin/Messages/Delete/@msg.Id" method="post"
                                      onsubmit="return confirm('Delete this message?')">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-danger btn-sm">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>