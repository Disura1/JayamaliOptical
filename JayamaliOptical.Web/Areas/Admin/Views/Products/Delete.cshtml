@model JayamaliOptical.Web.Models.Product
@{
    ViewData["Title"] = "Delete Product";
}

<div class="row">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Delete Product</h3>
            </div>
            <div class="card-body">
                <h4>Are you sure you want to delete this product?</h4>
                <hr />
                <dl class="row">
                    <dt class="col-sm-4">Name:</dt>
                    <dd class="col-sm-8">@Model.Name</dd>

                    <dt class="col-sm-4">Category:</dt>
                    <dd class="col-sm-8">@Model.Category?.Name</dd>

                    <dt class="col-sm-4">Price:</dt>
                    @if (Model.Price.HasValue)
                    {
                        <dd class="col-sm-8">Rs. @Model.Price.Value.ToString("0.00")</dd>
                    }
                    else
                    {
                        <dd class="col-sm-8">-</dd>
                    }

                    <dt class="col-sm-4">Stock:</dt>
                    <dd class="col-sm-8">@Model.StockQuantity</dd>
                </dl>

                <form action="/Admin/Products/Delete/@Model.Id" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />
                    <button type="submit" class="btn btn-danger">Yes, Delete</button>
                    <a href="/Admin/Products" class="btn btn-default">Cancel</a>
                </form>
            </div>
        </div>
    </div>
</div>