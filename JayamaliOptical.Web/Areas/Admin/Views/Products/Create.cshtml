@model JayamaliOptical.Web.Models.Product
@{
    ViewData["Title"] = "Create Product";
    var preSelected = ViewBag.PreSelectedCategory as bool? ?? false;
    var selectedCategoryId = ViewBag.SelectedCategoryId as int?;
    var categories = ViewBag.Categories as List<JayamaliOptical.Web.Models.Category>;
}

<div class="row">
    <div class="col-md-10">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Add New Product</h3>
            </div>
            <form action="/Admin/Products/Create" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div class="card-body">
                    <!-- Category Selection (only show if not pre-selected) -->
                    @if (!preSelected)
                    {
                        <div class="form-group">
                            <label>Category</label>
                            <select name="CategoryId" id="CategoryId" class="form-control" required onchange="updatePhotoRequirements()">
                                <option value="">-- Select Category --</option>
                                @foreach (var cat in (categories ?? new List<JayamaliOptical.Web.Models.Category>()))
                                {
                                    var selected = selectedCategoryId == cat.Id ? "selected" : "";
                                    <option value="@cat.Id" @selected>@cat.Name</option>
                                }
                            </select>
                        </div>
                    }
                    else
                    {
                        <input type="hidden" name="CategoryId" value="@selectedCategoryId" />
                    }

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Product Name</label>
                                <input type="text" name="Name" class="form-control" required />
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-group" id="categoryDisplay" style="display: @(preSelected ? "block" : "none");">
                                <label>Category</label>
                                @{
                                    var selectedCategory = categories?.FirstOrDefault(c => c.Id == (selectedCategoryId ?? 0));
                                    var categoryName = selectedCategory?.Name ?? "";
                                }
                                <input type="text" class="form-control" value="@categoryName" readonly />
                            </div>
                        </div>
                    </div>

                    <div class="form-group">
                        <label>Description</label>
                        <textarea name="Description" class="form-control" rows="3"></textarea>
                    </div>

                    <div class="row">
                        <div class="col-md-4">
                            <div class="form-group">
                                <label>Price (Rs.)</label>
                                <input type="number" name="Price" class="form-control" step="0.01" required />
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="form-group">
                                <label>Brand</label>
                                <input type="text" name="Brand" class="form-control" />
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="form-group">
                                <label>Stock Quantity</label>
                                <input type="number" name="StockQuantity" class="form-control" value="0" />
                            </div>
                        </div>
                    </div>

                    <div class="row" id="productTypeRow" style="display: none;">
                        <div class="col-md-4">
                            <div class="form-group">
                                <label>Product Type</label>
                                <select name="ProductType" id="ProductType" class="form-control">
                                    <option value="">-- Select Type --</option>
                                    <option value="Mens">Men's</option>
                                    <option value="Ladies">Ladies</option>
                                    <option value="Kids">Kids</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4">
                            <div class="form-group">
                                <label>Frame Type</label>
                                <select name="FrameType" class="form-control">
                                    <option value="">-- Select --</option>
                                    <option value="Full Rim">Full Rim</option>
                                    <option value="Half Rim">Half Rim</option>
                                    <option value="Rimless">Rimless</option>
                                </select>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="form-group">
                                <label>Lens Power</label>
                                <input type="text" name="LensPower" class="form-control" placeholder="e.g., -2.00" />
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="form-group">
                                <label>IOL Type</label>
                                <select name="IOLType" class="form-control">
                                    <option value="">-- Select --</option>
                                    <option value="Monofocal">Monofocal</option>
                                    <option value="Multifocal">Multifocal</option>
                                    <option value="Toric">Toric</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <!-- Photo Upload Section -->
                    <div class="row mt-3">
                        <div class="col-12">
                            <h5>Product Photos</h5>
                            <hr />
                        </div>

                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Photo 1 (Required)</label>
                                <input type="file" name="ImageFile1" class="form-control" accept="image/*" required />
                                <small class="text-muted">Main product photo</small>
                            </div>
                        </div>

                        <div class="col-md-6" id="photo2Group">
                            <div class="form-group">
                                <label>Photo 2 <span id="photo2Required"></span></label>
                                <input type="file" name="ImageFile2" id="ImageFile2" class="form-control" accept="image/*" />
                                <small class="text-muted">Additional product photo</small>
                            </div>
                        </div>
                    </div>

                    <div class="form-group form-check mt-3">
                        <input type="checkbox" name="RequiresPrescription" value="true" class="form-check-input" id="RequiresPrescription" />
                        <input type="hidden" name="RequiresPrescription" value="false" />
                        <label class="form-check-label" for="RequiresPrescription">
                            <i class="bi bi-file-earmark-medical me-2"></i>
                            <strong>Requires Prescription</strong>
                            <small class="text-muted d-block">Check if this product requires a valid prescription (e.g., Spectacles, Contact Lenses, IOL Lens)</small>
                        </label>
                    </div>

                    <div class="form-group form-check mt-3">
                        <input type="checkbox" name="IsActive" value="true" class="form-check-input" checked />
                        <input type="hidden" name="IsActive" value="false" />
                        <label class="form-check-label">Active</label>
                    </div>
                </div>
                <div class="card-footer">
                    <button type="submit" class="btn btn-primary">Save</button>
                    <a href="/Admin/Products" class="btn btn-default">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    function updatePhotoRequirements() {
        var categoryId = document.getElementById('CategoryId') ? document.getElementById('CategoryId').value : '@selectedCategoryId';
        var photo2Group = document.getElementById('photo2Group');
        var photo2Input = document.getElementById('ImageFile2');
        var photo2Required = document.getElementById('photo2Required');
        var productTypeRow = document.getElementById('productTypeRow');
        var productTypeSelect = document.getElementById('ProductType');

        // Categories: 5=Spectacle, 6=Sunglasses, 3=Contact Lens, 4=IOL Lens
        if (categoryId == '5' || categoryId == '6') {
            // Spectacle or Sunglasses - 2 photos required, show Product Type
            if (photo2Group) {
                photo2Group.style.display = 'block';
                photo2Input.required = true;
                photo2Required.textContent = '(Required)';
                photo2Required.className = 'text-danger';
            }

            // Show Product Type dropdown
            if (productTypeRow) {
                productTypeRow.style.display = 'block';
            }
            if (productTypeSelect) {
                productTypeSelect.required = true;
            }
        } else if (categoryId == '3' || categoryId == '4') {
            // Contact Lens or IOL Lens - 1 photo required, hide Product Type
            if (photo2Group) {
                photo2Group.style.display = 'block';
                photo2Input.required = false;
                photo2Required.textContent = '(Optional)';
                photo2Required.className = 'text-muted';
            }

            // Hide Product Type dropdown
            if (productTypeRow) {
                productTypeRow.style.display = 'none';
            }
            if (productTypeSelect) {
                productTypeSelect.required = false;
                productTypeSelect.value = '';
            }
        } else {
            // No category selected or other category
            if (photo2Group) {
                photo2Group.style.display = 'none';
                photo2Input.required = false;
            }
            if (productTypeRow) {
                productTypeRow.style.display = 'none';
            }
            if (productTypeSelect) {
                productTypeSelect.required = false;
            }
        }
    }

    // Run on page load if category is pre-selected
    document.addEventListener('DOMContentLoaded', function() {
        var categoryId = '@selectedCategoryId';
        if (categoryId && categoryId !== '') {
            updatePhotoRequirements();
        }
    });

    // Auto-check "Requires Prescription" for certain categories
    document.addEventListener('DOMContentLoaded', function() {
        var categorySelect = document.getElementById('CategoryId');
        var prescriptionCheckbox = document.getElementById('RequiresPrescription');

        if (categorySelect && prescriptionCheckbox) {
            function updatePrescriptionCheckbox() {
                var categoryId = categorySelect.value;
                // Auto-check for prescription-required categories
                if (categoryId == '5' || categoryId == '3' || categoryId == '4') {
                    prescriptionCheckbox.checked = true;
                } else {
                    prescriptionCheckbox.checked = false;
                }
            }

            categorySelect.addEventListener('change', updatePrescriptionCheckbox);

            // Run on page load if category is pre-selected
            if (categorySelect.value) {
                updatePrescriptionCheckbox();
            }
        }
    });
</script>