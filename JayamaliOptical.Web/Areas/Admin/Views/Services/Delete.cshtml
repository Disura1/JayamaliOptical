@model JayamaliOptical.Web.Models.Service
@{
    ViewData["Title"] = "Delete Service";
}

<div class="row">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Delete Service</h3>
            </div>
            <div class="card-body">
                <h4 class="text-danger">Are you sure you want to delete this service?</h4>
                <hr />

                <div class="row">
                    @if (!string.IsNullOrEmpty(Model.ImageUrl))
                    {
                        <div class="col-md-4">
                            <img src="@Model.ImageUrl" alt="@Model.Name" class="img-thumbnail" style="width: 100%;" />
                        </div>
                    }
                    <div class="col-md-@(string.IsNullOrEmpty(Model.ImageUrl) ? "12" : "8")">
                        <dl class="row">
                            <dt class="col-sm-3">Service Name:</dt>
                            <dd class="col-sm-9">@Model.Name</dd>

                            <dt class="col-sm-3">Description:</dt>
                            <dd class="col-sm-9">@Model.Description</dd>

                            <dt class="col-sm-3">Price:</dt>
                            <dd class="col-sm-9">
                                @if (Model.Price.HasValue)
                                {
                                    <span>Rs. @Model.Price.Value.ToString("0.00")</span>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </dd>

                            <dt class="col-sm-3">Duration:</dt>
                            <dd class="col-sm-9">
                                @if (Model.DurationMinutes.HasValue)
                                {
                                    <span>@Model.DurationMinutes.Value minutes</span>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </dd>

                            <dt class="col-sm-3">Appointment:</dt>
                            <dd class="col-sm-9">
                                @if (Model.RequiresAppointment)
                                {
                                    <span class="badge badge-success">Required</span>
                                }
                                else
                                {
                                    <span class="badge badge-secondary">Walk-in</span>
                                }
                            </dd>

                            <dt class="col-sm-3">Buttons:</dt>
                            <dd class="col-sm-9">
                                @if (!string.IsNullOrEmpty(Model.Button1Text))
                                {
                                    <span class="badge @Model.Button1Class">@Model.Button1Text</span>
                                }
                                @if (!string.IsNullOrEmpty(Model.Button2Text))
                                {
                                    <span class="badge @Model.Button2Class">@Model.Button2Text</span>
                                }
                                @if (!string.IsNullOrEmpty(Model.Button3Text))
                                {
                                    <span class="badge @Model.Button3Class">@Model.Button3Text</span>
                                }
                            </dd>

                            <dt class="col-sm-3">Status:</dt>
                            <dd class="col-sm-9">
                                @if (Model.IsActive)
                                {
                                    <span class="badge badge-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge badge-danger">Inactive</span>
                                }
                            </dd>
                        </dl>
                    </div>
                </div>

                <form action="/Admin/Services/Delete/@Model.Id" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />
                    <button type="submit" class="btn btn-danger">Yes, Delete</button>
                    <a href="/Admin/Services" class="btn btn-default">Cancel</a>
                </form>
            </div>
        </div>
    </div>
</div>